#!/bin/sh
# Package safeguards of the Base image: npm without install scripts, and npm, pnpm, Bun and uv
# take only package versions at least <days> old. Runs during the Build
# (vm/Containerfile) with package_min_age_days from the settings; after every
# Build agentbox checks on the Host that everything written here is in the Image as written.
#   package-safeguards <days> [<root>]
# <root> only for tests (default: the Image itself).
set -eu

days=${1:-}
root=${2:-}
case "$days" in
  '' | 0* | *[!0-9]*) echo "package-safeguards: give the days as a whole number from 1" >&2; exit 2 ;;
esac

npm="$root/usr/lib/node_modules/npm"
mkdir -p "$root/etc/uv" "$npm" "$root/usr/lib/agentbox" "$root/usr/lib/systemd/system.conf.d"

# npm: global configuration. By default npm (prefix /usr) reads /usr/etc/npmrc, which must not
# exist in a bootc image; npm 12 does not ship Fedora's builtin configuration that points to
# /etc/npmrc. The builtin configuration written here does that again.
cat > "$root/etc/npmrc" <<EOF
# Package safeguards of the Agent Box (package-safeguards, owned by root)
ignore-scripts=true
min-release-age=$days
EOF
cat > "$npm/npmrc" <<EOF
# npm's builtin configuration (package-safeguards): the global one is /etc/npmrc
globalconfig=/etc/npmrc
EOF

# uv: configuration file and (below) environment
cat > "$root/etc/uv/uv.toml" <<EOF
exclude-newer = "$days days"
EOF

# Bun reads its global configuration only from the home; guest-setup puts it there
cat > "$root/usr/lib/agentbox/bunfig.toml" <<EOF
[install]
# packages only once they are $days days old (in seconds)
minimumReleaseAge = $((days * 86400))
EOF

# Environment of all services of the VM (orca serve, agents, terminals): uv and pnpm (minutes)
cat > "$root/usr/lib/systemd/system.conf.d/agentbox-packages.conf" <<EOF
# Package safeguards of the Agent Box (package-safeguards)
[Manager]
DefaultEnvironment="UV_EXCLUDE_NEWER=$days days" "pnpm_config_minimum_release_age=$((days * 1440))"
EOF
