#!/usr/bin/python3 -I
"""opencode-forget <opencode data dir>: what opencode keeps of logins made in the VM, and
its saved permission approvals.

guest-setup runs it as the agent at every start, before orca serve. opencode's data
directory lies on the Data disk so that its sessions (opencode.db) outlive a Reset;
the logins in it should not, like any login made in the VM: the OpenCode key comes
from the Host (OPENCODE_API_KEY). Nor should approvals saved as "always" or the commands
opencode runs when it creates a worktree, or a session's own permission rules: like agent
settings, nothing planted there survives a Reset. So it removes

- auth.json (`opencode auth login`) and mcp-auth.json (MCP servers' OAuth tokens),
  also when something made either a directory or a link;
- the rows of opencode.db's login tables (`opencode console login` and the
  credentials of integrations) and of its permission table, the start commands of its
  projects and workspaces and the permission rules of its sessions, leaving sessions,
  messages and projects otherwise alone;
- first of all, every trigger and view in opencode.db: opencode makes none, so any there
  was planted to undo or stall the rest.

Only opencode.db: a database opencode is pointed at otherwise (OPENCODE_DB, another
release channel) is not looked at.

A table opencode does not have (yet) is skipped. Each step stands on its own, and
afterwards the database is checked afresh: when anything of the above is still there
(a planted constraint made a step fail, the file is no database), opencode.db is set
aside as opencode.db.unclean and opencode starts with a new one, without the sessions.
Whatever fails is reported on stderr; the exit status is 0 all the same, so a broken
file never stops the VM.
"""
import os
import shutil
import sqlite3
import sys

FILES = ("auth.json", "mcp-auth.json")
TABLES = ("account_state", "account", "control_account", "credential", "permission")
# columns opencode runs as shell commands when it creates a worktree, and a session's own
# permission rules, which opencode puts after (above) the agent's
COLUMNS = (("project", "commands"), ("workspace", "extra"), ("session", "permission"))


def remove(path):
    if os.path.isdir(path) and not os.path.islink(path):
        shutil.rmtree(path)
    elif os.path.lexists(path):
        os.remove(path)


def _quoted(name):
    return '"' + name.replace('"', '""') + '"'


def _clean(con):
    """Each step on its own, so one that fails (a planted constraint, say) undoes no other."""
    problems = []

    def step(sql):
        try:
            with con:
                con.execute(sql)
        except sqlite3.Error as e:
            problems.append(f"opencode.db: {e}")

    # opencode has no triggers or views: any there was planted, to put rows back, to stand
    # in for a table, or to keep this from ending
    for kind, name in con.execute("SELECT type, name FROM sqlite_master WHERE type IN ('trigger', 'view')").fetchall():
        step(f"DROP {kind.upper()} IF EXISTS {_quoted(name)}")
    have = {n for (n,) in con.execute("SELECT name FROM sqlite_master WHERE type = 'table'")}
    for table in TABLES:
        if table in have:
            step(f"DELETE FROM {_quoted(table)}")
    for table, column in COLUMNS:
        if table in have and column in {r[1] for r in con.execute(f"PRAGMA table_info({_quoted(table)})")}:
            step(f"UPDATE {_quoted(table)} SET {_quoted(column)} = NULL")
    return problems


def _left(con):
    """What of it is still there, checked afresh: none of it may be."""
    left = [f"{kind} {name}" for kind, name in
            con.execute("SELECT type, name FROM sqlite_master WHERE type IN ('trigger', 'view')")]
    have = {n for (n,) in con.execute("SELECT name FROM sqlite_master WHERE type = 'table'")}
    for table in TABLES:
        if table in have and con.execute(f"SELECT count(*) FROM {_quoted(table)}").fetchone()[0]:
            left.append(f"rows in {table}")
    for table, column in COLUMNS:
        if table not in have or column not in {r[1] for r in con.execute(f"PRAGMA table_info({_quoted(table)})")}:
            continue
        if con.execute(f"SELECT count(*) FROM {_quoted(table)} WHERE {_quoted(column)} IS NOT NULL").fetchone()[0]:
            left.append(f"{table}.{column}")
    return left


def _set_aside(db):
    """opencode starts with a new database; the old one stays as <name>.unclean (replacing an
    earlier one), its journal files with it, for the owner to look at or delete."""
    for suffix in ("", "-wal", "-shm", "-journal"):
        if os.path.lexists(db + suffix):
            os.replace(db + suffix, db + ".unclean" + suffix)


def forget(folder):
    problems = []
    for name in FILES:
        try:
            remove(os.path.join(folder, name))
        except OSError as e:
            problems.append(f"{name}: {e.strerror}")
    db = os.path.join(folder, "opencode.db")
    if not os.path.isfile(db):
        return problems
    try:
        con = sqlite3.connect(db, timeout=10)
        try:
            problems += _clean(con)
            left = _left(con)
        finally:
            con.close()
    except sqlite3.Error as e:
        problems.append(f"opencode.db: {e}")
        left = ["an unreadable database"]
    if left:
        # whatever kept it from being cleaned, opencode does not get it back
        try:
            _set_aside(db)
            problems.append(f"opencode.db set aside as opencode.db.unclean ({', '.join(left)})")
        except OSError as e:
            problems.append(f"opencode.db could not be set aside: {e.strerror}")
    return problems


def main(argv):
    if len(argv) != 2:
        print("usage: opencode-forget <opencode data dir>", file=sys.stderr)
        return 2
    for p in forget(argv[1]):
        print(f"opencode-forget: {p}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
