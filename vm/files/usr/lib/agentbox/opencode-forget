#!/usr/bin/python3 -I
"""opencode-forget <opencode data dir>: what opencode keeps of logins made in the VM, and
its saved permission approvals.

guest-setup runs it as the agent at every start, before orca serve. opencode's data
directory lies on the Data disk so that its sessions (opencode.db) outlive a Reset;
the logins in it should not, like any login made in the VM: the OpenCode key comes
from the Host (OPENCODE_API_KEY). Nor should approvals saved as "always" or the commands
opencode runs when it creates a worktree, or a session's own permission rules: like agent
settings, nothing planted there survives a Reset. So it removes

- auth.json (`opencode auth login`) and mcp-auth.json (MCP servers' OAuth tokens),
  also when something made either a directory or a link;
- the rows of opencode.db's login tables (`opencode console login` and the
  credentials of integrations) and of its permission table, the start commands of its
  projects and workspaces and the permission rules of its sessions, leaving sessions,
  messages and projects otherwise alone;
- first of all, every trigger and view in opencode.db: opencode makes none, so any there
  was planted to undo or stall the rest.

Only opencode.db: a database opencode is pointed at otherwise (OPENCODE_DB, another
release channel) is not looked at.

A table opencode does not have (yet) is skipped. Whatever fails is reported on
stderr; the exit status is 0 all the same, so a broken file never stops the VM.
"""
import os
import shutil
import sqlite3
import sys

FILES = ("auth.json", "mcp-auth.json")
TABLES = ("account_state", "account", "control_account", "credential", "permission")
# columns opencode runs as shell commands when it creates a worktree, and a session's own
# permission rules, which opencode puts after (above) the agent's
COLUMNS = (("project", "commands"), ("workspace", "extra"), ("session", "permission"))


def remove(path):
    if os.path.isdir(path) and not os.path.islink(path):
        shutil.rmtree(path)
    elif os.path.lexists(path):
        os.remove(path)


def forget(folder):
    problems = []
    for name in FILES:
        try:
            remove(os.path.join(folder, name))
        except OSError as e:
            problems.append(f"{name}: {e.strerror}")
    db = os.path.join(folder, "opencode.db")
    if os.path.isfile(db):
        try:
            con = sqlite3.connect(db, timeout=10)
            try:
                with con:
                    # opencode has no triggers or views: any there was planted, to put rows
                    # back, to stand in for a table, or to keep this from ending
                    planted = con.execute("SELECT type, name FROM sqlite_master WHERE type IN ('trigger', 'view')")
                    for kind, name in planted.fetchall():
                        con.execute(f'DROP {kind.upper()} IF EXISTS "{name.replace(chr(34), chr(34) * 2)}"')
                    have = {n for (n,) in con.execute("SELECT name FROM sqlite_master WHERE type = 'table'")}
                    for table in TABLES:
                        if table in have:
                            con.execute(f'DELETE FROM "{table}"')
                    for table, column in COLUMNS:
                        if table in have and column in {r[1] for r in con.execute(f'PRAGMA table_info("{table}")')}:
                            con.execute(f'UPDATE "{table}" SET "{column}" = NULL')
            finally:
                con.close()
        except sqlite3.Error as e:
            problems.append(f"opencode.db: {e}")
    return problems


def main(argv):
    if len(argv) != 2:
        print("usage: opencode-forget <opencode data dir>", file=sys.stderr)
        return 2
    for p in forget(argv[1]):
        print(f"opencode-forget: {p}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
