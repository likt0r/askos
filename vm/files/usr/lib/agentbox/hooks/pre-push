#!/usr/bin/env bash
# Agents do not push to main/master but to branches with a PR.
# A brake against slips, not a lock: --no-verify bypasses the hook.
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main | refs/heads/master)
      echo "agentbox: pushing to ${remote_ref#refs/heads/} is blocked. Push a branch and open a pull request." >&2
      exit 1 ;;
  esac
done
exit 0
