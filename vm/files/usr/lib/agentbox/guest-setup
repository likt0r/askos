#!/usr/bin/env bash
# Runs as root at every start of the VM, before orca serve.
#  - reads the context (work/priv) and the Orca port from fw_cfg (set by the Host)
#  - names the Host host.agentbox and makes it the resolver
#  - sets up the agent's home afresh and binds only the lasting parts from the
#    Data disk
set -euo pipefail

DATA=/var/lib/agentbox-data
HOME_DIR=/var/home/agent
AGENT_UID=1000

# titan liest das Journal per Gast-Agent (agentbox logs/pair) ueber
# /usr/libexec/qemu-ga/fsfreeze-hook.d/agentbox-journal; SELinux erlaubt das
# nur mit diesem Boolean. Zuerst, damit die Logs auch dann lesbar sind, wenn
# der Rest hier scheitert. Gilt bis zum naechsten Start.
setsebool virt_qemu_ga_run_unconfined 1 || true

fwcfg() {
  local f="/sys/firmware/qemu_fw_cfg/by_name/opt/agentbox/$1/raw"
  [ -r "$f" ] || { echo "guest-setup: fw_cfg entry $1 is missing" >&2; exit 1; }
  cat "$f"
}
modprobe qemu_fw_cfg
CONTEXT=$(fwcfg context)
ORCA_PORT=$(fwcfg orca_port)
# die Adresse, unter der Geraete den Host erreichen (sie steht im Host setup, nicht im Image)
PAIRING_ADDRESS=$(fwcfg pairing_address)
install -d -m 755 /run/agentbox
install -m 600 /dev/null /run/agentbox/env
# Fuer Shells (Orca-Terminals) zusaetzlich als Datei, die nur agent lesen darf
install -m 640 -g agent /dev/null /run/agentbox/agent-env
# VM variables (agentbox set-env, checked on the Host so that none switches a Safeguard
# off) come first, so the fixed values of Agent Box below win. A missing entry means none.
/usr/lib/agentbox/fwcfg-env /sys/firmware/qemu_fw_cfg/by_name/opt/agentbox/env/raw \
  /run/agentbox/env /run/agentbox/agent-env
printf 'AGENTBOX_CONTEXT=%s\nORCA_PORT=%s\nPAIRING_ADDRESS=%s\n' "$CONTEXT" "$ORCA_PORT" "$PAIRING_ADDRESS" >> /run/agentbox/env
# Claude-Token von titan (leer, solange keins hinterlegt ist). Orca gibt es
# an alle Terminals und Agenten weiter.
token=$(fwcfg claude_token 2>/dev/null | tr -d '[:space:]' || true)
if [[ "$token" == sk-ant-* ]]; then
  printf 'CLAUDE_CODE_OAUTH_TOKEN=%s\n' "$token" >> /run/agentbox/env
  printf 'export CLAUDE_CODE_OAUTH_TOKEN=%s\n' "$token" >> /run/agentbox/agent-env
fi
# The OpenCode key (opencode.ai, for OpenCode Go or Zen) the same way; "none" without one.
# Only the characters the Host accepted, so nothing can break the files' lines.
key=$(fwcfg opencode_key 2>/dev/null | tr -d '[:space:]' || true)
if [[ "$key" =~ ^sk-[A-Za-z0-9_-]+$ && "$key" != sk-ant-* ]]; then
  printf 'OPENCODE_API_KEY=%s\n' "$key" >> /run/agentbox/env
  printf 'export OPENCODE_API_KEY=%s\n' "$key" >> /run/agentbox/agent-env
fi
hostnamectl set-hostname "agentbox-$CONTEXT"

# The Host is the .1 of the VM's own isolated network
for _ in $(seq 30); do
  ip=$(ip -4 -o addr show scope global | awk '{print $4; exit}' | cut -d/ -f1)
  [ -n "$ip" ] && break
  sleep 1
done
[ -n "${ip:-}" ] || { echo "guest-setup: no IP address" >&2; exit 1; }
gw="${ip%.*}.1"
# Rootless Podman (pasta) needs a default route. The Host forwards nothing and answers only
# its resolver, proxy and token service, so the route leads nowhere else.
ip route replace default via "$gw"
sed -i '/ host\.agentbox$/d' /etc/hosts
echo "$gw host.agentbox" >> /etc/hosts

# The Host's resolver answers every name with the Host, whose proxy takes the destination
# from the TLS handshake. Containers resolve through it too: pasta forwards their queries to
# this nameserver, and aardvark (compose networks) forwards to it the names it does not know.
# NetworkManager leaves this file alone (dns=none).
rm -f /etc/resolv.conf
echo "nameserver $gw" > /etc/resolv.conf

# Ohne Datenplatte lieber nicht starten als still auf die Systemplatte schreiben
mountpoint -q "$DATA" || { echo "guest-setup: the Data disk is not mounted" >&2; exit 1; }

# Home ist fluechtig (Systemplatte); dauerhaft ist nur, was hier steht. Auch der
# Podman-Speicher des Agenten (Container images, Container, Volumes, Build-Cache)
# liegt auf der Datenplatte (ADR 0017); Podmans Benutzerkonfiguration
# (~/.config/containers) bleibt Systemplatte und geht mit jedem Reset verloren.
# opencode keeps its sessions in .local/share/opencode (opencode.db) and the chosen model
# and prompt history in .local/state/opencode.
PERSIST=(code orca .config/orca .claude/projects .codex/sessions .cargo/registry .cargo/git
         .gradle .android .local/share/android-sdk .local/share/containers
         .local/share/opencode .local/state/opencode)
install -d -o agent -g agent -m 700 "$HOME_DIR"
for p in "${PERSIST[@]}"; do
  install -d -o agent -g agent -m 700 "$DATA/home/$p" "$HOME_DIR/$p"
  mountpoint -q "$HOME_DIR/$p" || mount --bind "$DATA/home/$p" "$HOME_DIR/$p"
done
chown agent:agent "$HOME_DIR"/.config "$HOME_DIR"/.claude "$HOME_DIR"/.codex "$HOME_DIR"/.cargo \
  "$HOME_DIR"/.local "$HOME_DIR"/.local/share "$HOME_DIR"/.local/state
# Logins made in the VM land next to opencode's sessions (auth.json, mcp-auth.json, login
# tables in opencode.db), and so do approvals saved as "always": they do not outlive the
# start after it, like Codex's login, which stays on the System disk, and agent settings. The
# key comes from the Host (OPENCODE_API_KEY). As the agent, so opencode.db and its journal
# stay the agent's; a failure is reported, never fatal.
runuser -u agent -- /usr/lib/agentbox/opencode-forget "$DATA/home/.local/share/opencode" \
  || echo "guest-setup: opencode logins and approvals not removed" >&2

# Der Android-Emulator (SwiftShader) braucht ausfuehrbaren Heap. Die Grenze
# ist hier die VM, nicht SELinux in ihr; gilt nur bis zum naechsten Start.
setsebool selinuxuser_execheap 1 || true

# Node-Laufzeit fuer Orcas Server bereitlegen (sonst laedt Orca sie beim Start)
rt="$HOME_DIR/.config/orca/orcad-artifacts/linux-x64-glibc/runtimes"
for r in /usr/lib/agentbox/orca-runtimes/node-*; do
  [ -e "$r" ] || continue
  [ -e "$rt/$(basename "$r")" ] && continue
  runuser -u agent -- mkdir -p "$rt"
  runuser -u agent -- cp -a "$r" "$rt/"
done

# Claude Code zeigt sonst bei jedem frischen Home den Login-Dialog, obwohl
# ein Token gesetzt ist
[ -e "$HOME_DIR/.claude.json" ] || { echo '{"hasCompletedOnboarding": true}' > "$HOME_DIR/.claude.json"; chown agent:agent "$HOME_DIR/.claude.json"; }

# Bun liest seine globale Config nur aus dem Home (Mindestalter von Paketen,
# geschrieben von package-safeguards beim Bauen des Images)
install -m 644 -o agent -g agent /usr/lib/agentbox/bunfig.toml "$HOME_DIR/.bunfig.toml"

# Git-Hooks in den Repos zaehlen nicht (core.hooksPath), aber Reste entfernen,
# damit sie auch bei geaenderter Config nicht greifen.
find "$DATA/home/code" -path '*/.git/hooks/*' -type f ! -name '*.sample' -delete 2>/dev/null || true

echo "guest-setup: context $CONTEXT, Orca port $ORCA_PORT, the Host at $gw"
