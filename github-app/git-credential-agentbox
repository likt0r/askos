#!/usr/bin/python3 -I
"""Git-Credential-Helper: holt pro Zugriff ein frisches App-Token fuer genau
das Repo, das Git gerade anspricht. Braucht credential.useHttpPath=true.
"""
import subprocess
import sys

if sys.argv[1:2] != ["get"]:
    sys.exit(0)  # store/erase: nichts zu tun, Tokens laufen ohnehin ab

attrs = dict(l.split("=", 1) for l in sys.stdin.read().splitlines() if "=" in l)
if attrs.get("protocol") != "https" or attrs.get("host") != "github.com" or "path" not in attrs:
    sys.exit(0)

repo = attrs["path"].strip("/").removesuffix(".git")
result = subprocess.run(["agentbox-gh-token", repo], capture_output=True, text=True)
if result.returncode != 0:
    sys.stderr.write(result.stderr)
    sys.exit(0)  # Git meldet dann selbst "Authentication failed"
print(f"username=x-access-token\npassword={result.stdout.strip()}")
