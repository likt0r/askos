#!/usr/bin/python3 -I
"""Transparent TLS proxy with the Allowlist for one VM (ADR 0014).

Runs as its own system user on a socket systemd hands over (socket activation):
port 443 on the Host's address in the VM's isolated network, where the VM's resolver
sends every name, or a Unix socket for tests. Each connection starts with a TLS
ClientHello, whose server name (SNI) is the destination; the proxy resolves that name
itself and connects to it on port 443. What is not a TLS handshake, or names no
server, is refused. Destinations in the LAN or on localhost are refused even when an
allowed domain resolves there. Every connection is logged (English, agentbox reads
these lines):
  [<vm>] ALLOWED <host> (allowlist <domain> <scope>)   or (open web)
  [<vm>] ALLOWED <host> (allowlist regex <pattern> <scope>)   a Regex entry
  [<vm>] BLOCKED <host> (<reason>)
  [<vm>] BLOCKED <client address> (not a TLS handshake)   or (no server name)
  [<vm>] ALERT <host> [<signal>,...]
  [<vm>] CLOSED <host> (<reason>)       tunnel closed by the proxy (ADR 0005)
  [<vm>] ERROR <host> (<error>)         destination unreachable
A refused connection gets a fatal TLS alert (access_denied for a blocked destination,
unrecognized_name without a server name, internal_error for an unreachable
destination), so the client reports why; bytes that are no TLS get nothing.

Allowlist: /etc/agentbox/allowlist.json (agentbox allow/disallow/...), Eintraege
mit Domain (gilt auch fuer alle Subdomains), Geltungsbereich (scope: "all" oder
der Name einer VM) und optional Ablaufzeit (expires, Epoch). Abgelaufene
Eintraege erlauben keine neuen Verbindungen. Aenderungen greifen ohne Neustart;
eine kaputte Datei aendert nichts (der letzte gute Stand bleibt). Solange es die
Datei nicht gibt (vor agentbox migrate-allowlist), gelten die alten Listen
/etc/agentbox/allowlist und allowlist-<vm>, eine Domain pro Zeile.

A Regex entry (ADR 0013) has a pattern (regex) instead of the domain, compiled once
whenever the file is read again; one that breaks the rules of agentbox-suspicious is
left out. It never allows a destination with strong Signals, checked on every connection
as in Open web ("suspicious: <signals>"), and nothing while the Watchlist cannot be read:
  [<vm>] BLOCKED <host> (Watchlist unreadable, regex entries closed)
Without agentbox-suspicious Regex entries allow nothing.

Steht in /etc/agentbox/open-<vm> eine Zeit in der Zukunft, ist jede
oeffentliche Domain erlaubt (offenes Web auf Zeit), ausser stark verdaechtigen.
Solange die Verdachtsliste von Hand nicht lesbar ist (watchlist.json kaputt, oder
sie fehlt und die Textdatei davor auch), laesst das offene Web nichts durch:
  [<vm>] BLOCKED <host> (Watchlist unreadable, Open web closed)

Tunnel (ADR 0005): offene Tunnel laufen ohne Zeitlimit weiter, auch wenn der
Eintrag ablaeuft, der sie erlaubt hat. Geschlossen werden nur Tunnel, deren
Zugang bewusst endet und die nichts anderes mehr erlaubt: ein Eintrag wird
entfernt, bevor er abgelaufen ist (agentbox disallow), oder das offene Web endet.
"""
import asyncio
import collections
import importlib.machinery
import importlib.util
import ipaddress
import json
import os
import re
import socket
import sys
import time

CONF_DIR = os.environ.get("AGENTBOX_CONF_DIR", "/etc/agentbox")
ALLOWLIST = "allowlist.json"
LEGACY = ("allowlist", "allowlist-{}")     # vor allowlist.json: alle VMs, eine VM


def _load_suspicious():
    """Einstufung verdaechtiger Ziele (agentbox-suspicious, liegt neben dem Proxy: im Checkout und
    installiert, agentbox/paths.py)."""
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "agentbox-suspicious")
    if not os.path.exists(path):
        return None
    loader = importlib.machinery.SourceFileLoader("agentbox_suspicious", path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def _seconds(value, default):
    try:
        return max(0.05, float(value)) if value else default
    except ValueError:
        return default


def _test_upstream():
    """Nur in Tests (AGENTBOX_CONF_DIR gesetzt): jedes erlaubte Ziel ist dieses
    host:port statt der aufgeloesten Adresse, ohne Pruefung auf oeffentlich."""
    if "AGENTBOX_CONF_DIR" not in os.environ:
        return None
    host, _, port = os.environ.get("AGENTBOX_PROXY_TEST_UPSTREAM", "").rpartition(":")
    return (host, int(port)) if host and port.isdigit() else None


suspicious = _load_suspicious()
PORT = 443
RECORD_LIMIT = 2 ** 14          # the longest record TLS allows
# a ClientHello in more bytes than one record of the longest length (header included) is not
# taken as TLS: 16,389 bytes
HELLO_LIMIT = 5 + RECORD_LIMIT
# how long a client has to send its ClientHello
HELLO_SECONDS = _seconds(os.environ.get("AGENTBOX_PROXY_HELLO_SECONDS"), 10.0)
LINGER_SECONDS = 2              # how long a refused client's further bytes are read after the alert
# so oft prueft der Proxy, ob Tunnel geschlossen werden muessen
CHECK_SECONDS = _seconds(os.environ.get("AGENTBOX_PROXY_CHECK_SECONDS"), 1.0)
TEST_UPSTREAM = _test_upstream()
OPEN = "open"            # Tunnel, den nur das offene Web erlaubt
# TLS alerts (RFC 8446, 6.2) the proxy answers a refused connection with
ACCESS_DENIED, UNRECOGNIZED_NAME, INTERNAL_ERROR = 49, 112, 80


def log(ctx, msg):
    print(f"[{ctx}] {msg}", file=sys.stderr, flush=True)


# --- ClientHello -----------------------------------------------------------------

# TLS record types, the handshake type and the extension of the server name (RFC 8446, 6066)
HANDSHAKE, ALERT_RECORD, FATAL, CLIENT_HELLO, SERVER_NAME, HOST_NAME = 22, 21, 2, 1, 0, 0
HOST = re.compile(r"[a-z0-9.-]{1,253}")
# a label as domain entries have them: letters, digits and inner hyphens, at most 63
LABEL = re.compile(r"[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?")
NOT_TLS = "not a TLS handshake"


class Refused(Exception):
    """A connection the proxy takes no destination from: the reason for the log and the
    TLS alert to answer with, none for bytes that are no TLS."""

    def __init__(self, reason, alert=None):
        super().__init__(reason)
        self.reason, self.alert = reason, alert


class Reader:
    """Reads a TLS structure front to back; running past its end is Refused."""

    def __init__(self, data):
        self.data, self.pos = data, 0

    def take(self, n):
        if self.pos + n > len(self.data):
            raise Refused(NOT_TLS)
        self.pos += n
        return self.data[self.pos - n:self.pos]

    def number(self, n):
        return int.from_bytes(self.take(n), "big")

    def vector(self, n):
        """A length-prefixed field, its length in n bytes."""
        return self.take(self.number(n))

    def done(self):
        return self.pos == len(self.data)


def _host_name(name):
    name = name.decode("ascii", "replace").lower().rstrip(".")
    if not HOST.fullmatch(name) or not all(LABEL.fullmatch(label) for label in name.split(".")):
        raise Refused("no server name", UNRECOGNIZED_NAME)
    return name


def _server_name(body):
    """The host name of the server_name extension in a ClientHello body (what follows the
    handshake header): lowercased, without its trailing dot. With an Encrypted Client Hello
    extension this is the outer name, as for any ClientHello (ADR 0014)."""
    r = Reader(body)
    r.take(2 + 32)                  # version, random
    r.vector(1)                     # session id
    r.vector(2)                     # cipher suites
    r.vector(1)                     # compression methods
    if r.done():
        raise Refused("no server name", UNRECOGNIZED_NAME)
    extensions = Reader(r.vector(2))
    if not r.done():
        raise Refused(NOT_TLS)
    found = {}
    while not extensions.done():
        kind, data = extensions.number(2), extensions.vector(2)
        if kind in found:           # RFC 8446, 4.2: never twice; which one would the server read?
            raise Refused(NOT_TLS)
        found[kind] = data
    if SERVER_NAME in found:
        extension = Reader(found[SERVER_NAME])
        names = Reader(extension.vector(2))
        if not extension.done():        # bytes after the list of names
            raise Refused(NOT_TLS)
        hosts = []
        while not names.done():
            name_type, name = names.number(1), names.vector(2)
            if name_type == HOST_NAME:
                hosts.append(name)
        # RFC 6066, 3: one name of a type; with several the destination might pick another one
        if len(hosts) == 1:
            return _host_name(hosts[0])
    raise Refused("no server name", UNRECOGNIZED_NAME)


class Hello:
    """A ClientHello as its bytes arrive (it may span several records and TCP segments): each
    record is taken apart once, when it is whole, so a client sending it in many small
    pieces costs no more than one sending it at once."""

    def __init__(self):
        self.buf = bytearray()      # every byte read, to be passed on as it came
        self.hello = bytearray()    # the handshake bytes of the records taken apart so far
        self.pos = 0                # where the next record starts in buf
        self.records = 0            # records taken apart

    def feed(self, data):
        """The server name once the ClientHello is whole, else None. Refused when the bytes
        are no TLS handshake, or when the ClientHello names no server."""
        self.buf += data
        buf = self.buf
        while len(buf) >= self.pos + 5:
            pos = self.pos
            kind, major, length = buf[pos], buf[pos + 1], int.from_bytes(buf[pos + 3:pos + 5], "big")
            if kind != HANDSHAKE or major != 3 or not 0 < length <= RECORD_LIMIT:
                raise Refused(NOT_TLS)
            if len(buf) < pos + 5 + length:
                return None
            self.hello += buf[pos + 5:pos + 5 + length]
            self.pos = pos + 5 + length
            self.records += 1
            hello = self.hello
            if len(hello) < 4:
                continue
            if hello[0] != CLIENT_HELLO:
                raise Refused(NOT_TLS)
            size = int.from_bytes(hello[1:4], "big")
            if len(hello) >= 4 + size:
                return _server_name(bytes(hello[4:4 + size]))
        return None


def client_hello(buf):
    """The server name of the TLS ClientHello that buf starts with; None while buf does not
    hold the whole ClientHello yet. Refused as Hello.feed."""
    return Hello().feed(buf)


# --- Allowlist -----------------------------------------------------------------

# An entry as the proxy tells them apart: a domain (regex False) or a Regex entry's pattern
Key = collections.namedtuple("Key", "value scope regex")


def _entries(data, ctx):
    """({Key: ablauf oder None} der Eintraege, die fuer ctx gelten, {pattern: compiled}, the
    patterns left out with why); Eintraege mit falschen Typen gelten nicht."""
    if not isinstance(data, dict) or not isinstance(data.get("entries"), list):
        raise ValueError("entries missing")
    out, compiled, refused = {}, {}, {}
    for e in data["entries"]:
        if not isinstance(e, dict):
            continue
        domain, pattern, scope, expires = e.get("domain"), e.get("regex"), e.get("scope"), e.get("expires")
        if scope not in ("all", ctx):
            continue
        if expires is not None and (isinstance(expires, bool) or not isinstance(expires, (int, float))):
            continue
        if isinstance(pattern, str) and domain is None:
            why = suspicious.pattern_problem(pattern) if suspicious else ("", "no agentbox-suspicious", None)
            if why:
                refused[pattern] = why[1]
                continue
            compiled.setdefault(pattern, suspicious.compile_pattern(pattern))
            out[Key(pattern, scope, True)] = expires
            continue
        if not isinstance(domain, str) or pattern is not None:
            continue
        domain = domain.strip().lower().rstrip(".")
        if domain:
            out[Key(domain, scope, False)] = expires
    return out, compiled, refused


def _legacy(ctx):
    """Die alten Listen, bis agentbox sie in allowlist.json uebernommen hat."""
    out = {}
    for name, scope in zip(LEGACY, ("all", ctx)):
        try:
            with open(os.path.join(CONF_DIR, name.format(ctx)), encoding="utf-8", errors="replace") as f:
                for line in f:
                    line = line.split("#", 1)[0].strip().lower().rstrip(".")
                    if line:
                        out[Key(line, scope, False)] = None
        except OSError:
            pass
    return out


class Allowlist:
    """Die Eintraege fuer eine VM, neu gelesen, wenn sich allowlist.json aendert; the
    patterns of its Regex entries compiled then, not per connection."""

    def __init__(self, ctx):
        self.ctx = ctx
        self.key = None
        self.entries = {}
        self.compiled = {}

    def current(self):
        path = os.path.join(CONF_DIR, ALLOWLIST)
        try:
            st = os.stat(path)
        except FileNotFoundError:
            self.key = None
            self.entries, self.compiled = _legacy(self.ctx), {}
            return self.entries
        except OSError:
            return self.entries
        key = (st.st_ino, st.st_mtime_ns, st.st_ctime_ns, st.st_size)
        if key != self.key:
            self.key = key
            try:
                with open(path, encoding="utf-8") as f:
                    self.entries, self.compiled, refused = _entries(json.load(f), self.ctx)
            except (OSError, ValueError) as e:
                log(self.ctx, f"ERROR {path} unreadable, the previous entries stay ({type(e).__name__})")
            else:
                for pattern, why in sorted(refused.items()):
                    log(self.ctx, f"ERROR {path}: regex entry {pattern!r} left out ({why})")
        return self.entries

    def matches(self, pattern, host):
        compiled = self.compiled.get(pattern)
        return bool(compiled and suspicious.pattern_matches(compiled, host))


def regex_refusal(tags):
    """Why Regex entries cannot allow a host, as the reason for the log, else None: it has
    strong Signals, or the Watchlist cannot be read (which Signals are strong is unknown
    then), checked on every connection the way Open web does it."""
    if not suspicious or suspicious.watchlist_unreadable():
        return "Watchlist unreadable, regex entries closed"
    if strong(tags):
        return f"suspicious: {','.join(tags)}"
    return None


def granting(host, tags, lists, now):
    """(die Eintraege, die host jetzt erlauben, why the Regex entries that match it do not, or
    None)."""
    keys, patterns = [], []
    for k, expires in lists.current().items():
        if expires is not None and expires <= now:
            continue
        if not k.regex:
            if host == k.value or host.endswith("." + k.value):
                keys.append(k)
        elif lists.matches(k.value, host):
            patterns.append(k)
    refused = regex_refusal(tags) if patterns else None
    return frozenset(keys if refused else keys + patterns), refused


def open_until(ctx):
    """Offenes Web auf Zeit: /etc/agentbox/open-<ctx> enthaelt das Ende (Epoch)."""
    try:
        with open(f"{CONF_DIR}/open-{ctx}") as f:
            until = float(f.read().strip())
    except (OSError, ValueError):
        return 0
    return until if until > time.time() else 0


def strong(tags):
    return bool(suspicious and suspicious.is_strong(tags))


def decide(ctx, lists, host, tags, now):
    """(grant, reason for the log). Grant: the entries that allow host, OPEN (only Open web)
    or None (blocked, with the reason)."""
    keys, refused = granting(host, tags, lists, now)
    if keys:
        return keys, None
    if open_until(ctx):
        # without a readable Watchlist it is unknown what would have to stay blocked: nothing passes
        if suspicious and suspicious.watchlist_unreadable():
            return None, "Watchlist unreadable, Open web closed"
        # in Open web destinations with strong Signals stay blocked (unless allowed)
        if strong(tags):
            return None, f"suspicious: {','.join(tags)}"
        return OPEN, None
    # a Regex entry matches, but does not allow it (strong Signals, or no Watchlist)
    if refused:
        return None, refused
    return None, "not on the Allowlist"


def logged(ctx, grant):
    """The entry the log names for a tunnel the Allowlist allows: the most specific domain
    (on a tie the VM's own), else a Regex entry (the VM's own first)."""
    domains = [k for k in grant if not k.regex]
    if domains:
        k = max(domains, key=lambda k: (len(k.value), k.scope == ctx))
        return f"allowlist {k.value} {k.scope}"
    k = min(grant, key=lambda k: (k.scope != ctx, k.value))
    return f"allowlist regex {k.value} {k.scope}"


# --- Tunnel ----------------------------------------------------------------------

class Tunnel:
    """Ein offener Tunnel und was ihn erlaubt (Eintraege oder OPEN)."""

    def __init__(self, host, tags, grant, writers):
        self.host, self.tags, self.grant, self.writers = host, tags, grant, writers

    def close(self):
        for w in self.writers:
            w.transport.abort()


tunnels = set()


def withdraw(ctx, lists, now, revoked, web_ended, is_open):
    """Zugang endet bewusst (Eintraege entfernt oder offenes Web zu): betroffene
    Tunnel bleiben, wenn ihr Ziel jetzt noch erlaubt ist, sonst gehen sie zu."""
    for t in list(tunnels):
        if not (web_ended if t.grant == OPEN else t.grant & revoked):
            continue
        keys, _ = granting(t.host, t.tags, lists, now)
        if keys:
            t.grant = frozenset(keys)
        elif is_open and not strong(t.tags):
            t.grant = OPEN
        else:
            log(ctx, f"CLOSED {t.host} ({'Open web ended' if t.grant == OPEN else 'removed from the Allowlist'})")
            tunnels.discard(t)
            t.close()


async def watch(ctx, lists):
    """Vergleicht laufend die Eintraege und das offene Web mit dem vorigen Stand.
    Ein Eintrag, der fehlt, obwohl er noch nicht abgelaufen war, wurde bewusst
    entfernt; abgelaufene (und die, die agentbox expire-allowlist dann loescht)
    schliessen nichts."""
    known = dict(lists.current())
    was_open = bool(open_until(ctx))
    while True:
        await asyncio.sleep(CHECK_SECONDS)
        try:
            now = time.time()
            entries = lists.current()
            revoked = {k for k, expires in known.items() if k not in entries and (expires is None or expires > now)}
            is_open = bool(open_until(ctx))
            ended = was_open and not is_open
            known, was_open = dict(entries), is_open
            if revoked or ended:
                withdraw(ctx, lists, now, revoked, ended, is_open)
        except Exception as e:      # der Waechter darf nie stehen bleiben
            log(ctx, f"ERROR check of open tunnels failed ({type(e).__name__}: {e})")


# --- Verbindungen ---------------------------------------------------------------

def _address(a):
    """The address getaddrinfo gave, or None for one ipaddress cannot read (which counts as
    not public)."""
    try:
        return ipaddress.ip_address(a)
    except ValueError:
        return None


async def resolve_public(host):
    """The addresses of host, IPv4 first, or None unless every one of them is public."""
    if TEST_UPSTREAM:
        return [TEST_UPSTREAM[0]]
    infos = await asyncio.get_running_loop().getaddrinfo(host, PORT, type=socket.SOCK_STREAM)
    addrs = {a: _address(a) for a in dict.fromkeys(info[4][0] for info in infos)}
    if not addrs or not all(ip is not None and ip.is_global for ip in addrs.values()):
        return None
    # IPv4 first: a Host does not always have a working IPv6 route
    return sorted(addrs, key=lambda a: addrs[a].version)


async def connect_any(addrs):
    error = None
    port = TEST_UPSTREAM[1] if TEST_UPSTREAM else PORT
    for addr in addrs:
        try:
            return await asyncio.wait_for(asyncio.open_connection(addr, port), 10)
        except (OSError, asyncio.TimeoutError) as e:
            error = e
    raise error


async def pipe(reader, writer):
    try:
        while data := await reader.read(65536):
            writer.write(data)
            await writer.drain()
    except (ConnectionError, asyncio.CancelledError):
        pass
    finally:
        writer.close()


async def refuse(reader, writer, alert=None):
    """Closes the connection, after a fatal TLS alert when there is one the client can use.
    After the alert the proxy stops sending and reads what the client still sends for a
    moment, since closing with bytes unread resets the connection and loses the alert."""
    if alert is not None:
        writer.write(bytes((ALERT_RECORD, 3, 3, 0, 2, FATAL, alert)))
        try:
            writer.write_eof()
            await writer.drain()
            async with asyncio.timeout(LINGER_SECONDS):
                while await reader.read(65536):
                    pass
        except (ConnectionError, TimeoutError):
            pass
    writer.close()


async def read_hello(reader, hello):
    """(the bytes read, the server name of the ClientHello they start with), read into hello
    (a Hello). Refused when they are no ClientHello within HELLO_LIMIT bytes, or name no
    server; EOFError when the client leaves before sending anything."""
    while True:
        if len(hello.buf) >= HELLO_LIMIT:
            raise Refused(NOT_TLS)
        chunk = await reader.read(HELLO_LIMIT - len(hello.buf))
        if not chunk:
            if hello.buf:
                raise Refused(NOT_TLS)
            raise EOFError
        host = hello.feed(chunk)
        if host is not None:
            return bytes(hello.buf), host


async def handle(ctx, lists, reader, writer):
    peer = writer.get_extra_info("peername")
    client = peer[0] if isinstance(peer, tuple) else "unix"
    hello = Hello()
    try:
        head, host = await asyncio.wait_for(read_hello(reader, hello), HELLO_SECONDS)
    except Refused as e:
        log(ctx, f"BLOCKED {client} ({e.reason})")
        await refuse(reader, writer, e.alert)
        return
    except asyncio.TimeoutError:
        # a ClientHello begun and not finished in time; a client that sent nothing leaves no line
        if hello.buf:
            log(ctx, f"BLOCKED {client} ({NOT_TLS})")
        writer.close()
        return
    except (EOFError, ConnectionError):
        writer.close()
        return

    tags = suspicious.classify(host) if suspicious else []
    alert = suspicious.alerting(host, tags) if tags else []     # without the harmless ones
    if alert:
        # a line of its own, so agentbox and the Control Room can collect Alerts
        log(ctx, f"ALERT {host} [{','.join(alert)}]")
    now = time.time()
    grant, why = decide(ctx, lists, host, tags, now)
    if grant is None:
        log(ctx, f"BLOCKED {host} ({why})")
        await refuse(reader, writer, ACCESS_DENIED)
        return
    try:
        addrs = await resolve_public(host)
    except (OSError, UnicodeError):     # UnicodeError: a name the IDNA codec refuses
        addrs = None
    if not addrs:
        log(ctx, f"BLOCKED {host} (does not resolve to a public address)")
        await refuse(reader, writer, ACCESS_DENIED)
        return

    try:
        up_reader, up_writer = await connect_any(addrs)
    except (OSError, asyncio.TimeoutError) as e:
        log(ctx, f"ERROR {host} ({e})")
        await refuse(reader, writer, INTERNAL_ERROR)
        return
    # access may have ended while the name was resolved and the connection made: decide
    # again and register the tunnel without an await in between, so watch sees it from now on
    grant, why = decide(ctx, lists, host, tags, now)
    if grant is None:
        up_writer.close()
        log(ctx, f"BLOCKED {host} ({why})")
        await refuse(reader, writer, ACCESS_DENIED)
        return
    if grant == OPEN:
        log(ctx, f"ALLOWED {host} (open web)")
    else:
        log(ctx, f"ALLOWED {host} ({logged(ctx, grant)})")
    tunnel = Tunnel(host, tags, grant, (writer, up_writer))
    tunnels.add(tunnel)
    try:
        up_writer.write(head)       # the ClientHello goes to the destination first
        await up_writer.drain()
        await asyncio.gather(pipe(reader, up_writer), pipe(up_reader, writer))
    except ConnectionError:
        up_writer.close()
        writer.close()
    finally:
        tunnels.discard(tunnel)


async def main():
    ctx = sys.argv[1]
    lists = Allowlist(ctx)
    if os.environ.get("LISTEN_FDS") == "1":
        sock = socket.socket(fileno=3)
    else:  # zum Testen ohne systemd: agentbox-proxy <vm> <socket-pfad>
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.bind(sys.argv[2])
        sock.listen(64)
    start = asyncio.start_unix_server if sock.family == socket.AF_UNIX else asyncio.start_server
    server = await start(lambda r, w: handle(ctx, lists, r, w), sock=sock)
    watcher = asyncio.create_task(watch(ctx, lists))   # Referenz halten, sonst raeumt Python ihn ab
    log(ctx, "ready")
    async with server:
        await server.serve_forever()
    watcher.cancel()


if __name__ == "__main__":
    asyncio.run(main())
