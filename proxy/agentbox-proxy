def _package_dir():
    """Where the package agentbox is: next to proxy/ in a checkout, installed in lib/agentbox
    under the prefix whose libexec/ holds this program. The proxy imports only its leaf modules
    list_records and proxy_log (tests/test_list_records.py)."""
    here = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    checkout = os.path.isfile(os.path.join(here, "agentbox", "__init__.py"))
    return here if checkout else os.path.join(here, "lib", "agentbox")


if _package_dir() not in sys.path:
    sys.path.insert(0, _package_dir())
from agentbox import list_records as records  # noqa: E402
from agentbox import proxy_log as lines  # noqa: E402

CONF_DIR = os.environ.get("AGENTBOX_CONF_DIR", "/etc/agentbox")


def _load_suspicious():
    """The classification of suspicious destinations (agentbox-suspicious, lies next to the proxy: in a checkout and
    installed, agentbox/paths.py)."""
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "agentbox-suspicious")
    if not os.path.exists(path):
        return None
    loader = importlib.machinery.SourceFileLoader("agentbox_suspicious", path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def _seconds(value, default):
    try:
        return max(0.05, float(value)) if value else default
    except ValueError:
        return default


def _test_upstream():
    """Only in tests (AGENTBOX_CONF_DIR set): every allowed destination is this
    host:port instead of the resolved address, without the check for public."""
    if "AGENTBOX_CONF_DIR" not in os.environ:
        return None
    host, _, port = os.environ.get("AGENTBOX_PROXY_TEST_UPSTREAM", "").rpartition(":")
    return (host, int(port)) if host and port.isdigit() else None


def _test_resolve():
    """Only in tests (AGENTBOX_CONF_DIR set): this resolver answers instead of getaddrinfo
    (AGENTBOX_PROXY_TEST_RESOLVE, JSON {name: [address, ...]}), checked like every resolution
    for public addresses; a name that is not in it resolves to nothing. A name
    that matches connects to the test upstream as usual."""
    if "AGENTBOX_CONF_DIR" not in os.environ:
        return None
    try:
        table = json.loads(os.environ.get("AGENTBOX_PROXY_TEST_RESOLVE") or "null")
    except ValueError:
        return None
    if not isinstance(table, dict):
        return None
    return {name: addrs for name, addrs in table.items()
            if isinstance(name, str) and isinstance(addrs, list) and all(isinstance(a, str) for a in addrs)}


suspicious = _load_suspicious()
PORT = 443
RECORD_LIMIT = 2 ** 14          # the longest record TLS allows
# a ClientHello in more bytes than one record of the longest length (header included) is not
# taken as TLS: 16,389 bytes
HELLO_LIMIT = 5 + RECORD_LIMIT
# how long a client has to send its ClientHello
HELLO_SECONDS = _seconds(os.environ.get("AGENTBOX_PROXY_HELLO_SECONDS"), 10.0)
LINGER_SECONDS = 2              # how long a refused client's further bytes are read after the alert
# how often the proxy checks whether tunnels have to close
CHECK_SECONDS = _seconds(os.environ.get("AGENTBOX_PROXY_CHECK_SECONDS"), 1.0)
# how many connections are held at once at most (Hold); more are refused at once
MAX_HELD = 32
# how many new HELD lines the proxy of a VM writes in HELD_WINDOW seconds at most: the VM can open
# connections to endless distinct names, and each line is a notification and a reload of the
# blocked list in the Control Room; a hold beyond it still holds, it only does not announce itself
# (the BLOCKED or ALLOWED line it ends with is written as always)
MAX_ANNOUNCED = 10
HELD_WINDOW = 60
# how many bytes a client may send during a hold at most: a TLS client says nothing after its
# ClientHello until the server answers (a ChangeCipherSpec of 6 bytes apart), so more ends the hold
HOLD_EXTRA_LIMIT = 4096
TEST_UPSTREAM = _test_upstream()
TEST_RESOLVE = _test_resolve()
OPEN = "open"            # a tunnel only Open web allows
# TLS alerts (RFC 8446, 6.2) the proxy answers a refused connection with
ACCESS_DENIED, UNRECOGNIZED_NAME, INTERNAL_ERROR = 49, 112, 80


def log(line):
    """One line of the proxy log (proxy_log)."""
    print(line, file=sys.stderr, flush=True)


# --- ClientHello -----------------------------------------------------------------

# TLS record types, the handshake type and the extension of the server name (RFC 8446, 6066)
HANDSHAKE, ALERT_RECORD, FATAL, CLIENT_HELLO, SERVER_NAME, HOST_NAME = 22, 21, 2, 1, 0, 0
HOST = re.compile(r"[a-z0-9.-]{1,253}")
# a label as domain entries have them: letters, digits and inner hyphens, at most 63
LABEL = re.compile(r"[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?")


class Refused(Exception):
    """A connection the proxy takes no destination from: the reason for the log and the
    TLS alert to answer with, none for bytes that are no TLS."""

    def __init__(self, reason, alert=None):
        super().__init__(reason)
        self.reason, self.alert = reason, alert


class Reader:
    """Reads a TLS structure front to back; running past its end is Refused."""

    def __init__(self, data):
        self.data, self.pos = data, 0

    def take(self, n):
        if self.pos + n > len(self.data):
            raise Refused(lines.NOT_TLS)
        self.pos += n
        return self.data[self.pos - n:self.pos]

    def number(self, n):
        return int.from_bytes(self.take(n), "big")

    def vector(self, n):
        """A length-prefixed field, its length in n bytes."""
        return self.take(self.number(n))

    def done(self):
        return self.pos == len(self.data)


def _host_name(name):
    name = name.decode("ascii", "replace").lower().rstrip(".")
    if not HOST.fullmatch(name) or not all(LABEL.fullmatch(label) for label in name.split(".")):
        raise Refused(lines.NO_SERVER_NAME, UNRECOGNIZED_NAME)
    return name


def _server_name(body):
    """The host name of the server_name extension in a ClientHello body (what follows the
    handshake header): lowercased, without its trailing dot. With an Encrypted Client Hello
    extension this is the outer name, as for any ClientHello (ADR 0014)."""
    r = Reader(body)
    r.take(2 + 32)                  # version, random
    r.vector(1)                     # session id
    r.vector(2)                     # cipher suites
    r.vector(1)                     # compression methods
    if r.done():
        raise Refused(lines.NO_SERVER_NAME, UNRECOGNIZED_NAME)
    extensions = Reader(r.vector(2))
    if not r.done():
        raise Refused(lines.NOT_TLS)
    found = {}
    while not extensions.done():
        kind, data = extensions.number(2), extensions.vector(2)
        if kind in found:           # RFC 8446, 4.2: never twice; which one would the server read?
            raise Refused(lines.NOT_TLS)
        found[kind] = data
    if SERVER_NAME in found:
        extension = Reader(found[SERVER_NAME])
        names = Reader(extension.vector(2))
        if not extension.done():        # bytes after the list of names
            raise Refused(lines.NOT_TLS)
        hosts = []
        while not names.done():
            name_type, name = names.number(1), names.vector(2)
            if name_type == HOST_NAME:
                hosts.append(name)
        # RFC 6066, 3: one name of a type; with several the destination might pick another one
        if len(hosts) == 1:
            return _host_name(hosts[0])
    raise Refused(lines.NO_SERVER_NAME, UNRECOGNIZED_NAME)


class Hello:
    """A ClientHello as its bytes arrive (it may span several records and TCP segments): each
    record is taken apart once, when it is whole, so a client sending it in many small
    pieces costs no more than one sending it at once."""

    def __init__(self):
        self.buf = bytearray()      # every byte read, to be passed on as it came
        self.hello = bytearray()    # the handshake bytes of the records taken apart so far
        self.pos = 0                # where the next record starts in buf
        self.records = 0            # records taken apart

    def feed(self, data):
        """The server name once the ClientHello is whole, else None. Refused when the bytes
        are no TLS handshake, or when the ClientHello names no server."""
        self.buf += data
        buf = self.buf
        while len(buf) >= self.pos + 5:
            pos = self.pos
            kind, major, length = buf[pos], buf[pos + 1], int.from_bytes(buf[pos + 3:pos + 5], "big")
            if kind != HANDSHAKE or major != 3 or not 0 < length <= RECORD_LIMIT:
                raise Refused(lines.NOT_TLS)
            if len(buf) < pos + 5 + length:
                return None
            self.hello += buf[pos + 5:pos + 5 + length]
            self.pos = pos + 5 + length
            self.records += 1
            hello = self.hello
            if len(hello) < 4:
                continue
            if hello[0] != CLIENT_HELLO:
                raise Refused(lines.NOT_TLS)
            size = int.from_bytes(hello[1:4], "big")
            if len(hello) >= 4 + size:
                return _server_name(bytes(hello[4:4 + size]))
        return None


def client_hello(buf):
    """The server name of the TLS ClientHello that buf starts with; None while buf does not
    hold the whole ClientHello yet. Refused as Hello.feed."""
    return Hello().feed(buf)


# --- Allowlist -----------------------------------------------------------------

# An entry as the proxy tells them apart: a domain (regex False) or a Regex entry's pattern
Key = collections.namedtuple("Key", "value scope regex")


def _entries(text, ctx):
    """({Key: expiry or None} of the entries that apply to ctx, {pattern: compiled}, the
    patterns left out with why). A broken or second entry makes the whole record broken
    (ValueError, list_records.allowlist_entries), with agentbox's checks and texts."""
    out, compiled, refused = {}, {}, {}
    for e in records.allowlist_entries(text):
        if e["scope"] not in (records.ALL, ctx):
            continue
        if "regex" in e:
            why = records.pattern_problem(e["regex"])
            if why:
                refused[e["regex"]] = why[1]
                continue
            compiled.setdefault(e["regex"], records.compile_pattern(e["regex"]))
            out[Key(e["regex"], e["scope"], True)] = e["expires"]
        else:
            out[Key(e["domain"], e["scope"], False)] = e["expires"]
    return out, compiled, refused


def _legacy(ctx):
    """The old lists, until agentbox has taken them over into allowlist.json."""
    out = {}
    for name, scope in zip(records.LEGACY_ALLOWLIST, ("all", ctx)):
        try:
            with open(os.path.join(CONF_DIR, name.format(ctx)), encoding="utf-8", errors="replace") as f:
                out.update((Key(d, scope, False), None) for d in records.legacy_allowlist(f.read())
                           if records.DOMAIN.fullmatch(d))     # as agentbox takes them over
        except OSError:
            pass
    return out


class Allowlist:
    """The entries for a VM, read again when allowlist.json changes; the
    patterns of its Regex entries compiled then, not per connection."""

    def __init__(self, ctx):
        self.ctx = ctx
        self.key = None
        self.entries = {}
        self.compiled = {}
        self.good = False       # whether allowlist.json was read once since the proxy started

    def current(self):
        path = os.path.join(CONF_DIR, records.ALLOWLIST)
        try:
            st = os.stat(path)
        except FileNotFoundError:
            self.key = None
            self.entries, self.compiled = _legacy(self.ctx), {}
            return self.entries
        except OSError:
            return self.entries
        key = (st.st_ino, st.st_mtime_ns, st.st_ctime_ns, st.st_size)
        if key != self.key:
            self.key = key
            try:
                with open(path, encoding="utf-8") as f:
                    self.entries, self.compiled, refused = _entries(f.read(), self.ctx)
            except (OSError, ValueError) as e:
                why = records.printable(str(e), 200) if isinstance(e, ValueError) and str(e) else type(e).__name__
                kept = ("the previous entries stay" if self.good or self.entries
                        else "nothing is allowed until it is fixed")
                log(lines.message(self.ctx, f"ERROR {path} unreadable ({why}), {kept}"))
            else:
                self.good = True
                for pattern, why in sorted(refused.items()):
                    log(lines.message(self.ctx, f"ERROR {path}: regex entry {pattern!r} left out ({why})"))
        return self.entries

    def matches(self, pattern, host):
        compiled = self.compiled.get(pattern)
        return bool(compiled and records.pattern_matches(compiled, host))


class Forbids:
    """The VM's Forbids, {domain: expiry or None}, read again when forbids.json changes. A broken
    file changes nothing: the last good state stays; a proxy that starts with one (or whose file
    was missing until then) takes every destination as forbidden until it is fixed."""

    def __init__(self, ctx):
        self.ctx = ctx
        self.key = None
        self.entries = {}
        self.good = False       # whether forbids.json was read once since the proxy started
        self.unreadable = False

    def current(self):
        path = os.path.join(CONF_DIR, records.FORBIDS)
        try:
            st = os.stat(path)
        except FileNotFoundError:
            self.key, self.entries, self.unreadable = None, {}, False
            return self.entries
        except OSError:
            return self.entries
        key = (st.st_ino, st.st_mtime_ns, st.st_ctime_ns, st.st_size)
        if key != self.key:
            self.key = key
            try:
                with open(path, encoding="utf-8") as f:
                    entries = records.forbid_entries(f.read())
            except (OSError, ValueError) as e:
                why = records.printable(str(e), 200) if isinstance(e, ValueError) and str(e) else type(e).__name__
                self.unreadable = not self.good
                kept = ("the previous forbids stay" if self.good
                        else "every destination no entry allows is refused until it is fixed")
                log(lines.message(self.ctx, f"ERROR {path} unreadable ({why}), {kept}"))
            else:
                self.entries = {e["domain"]: e["expires"] for e in entries if e["scope"] == self.ctx}
                self.good, self.unreadable = True, False
        return self.entries

    def covers(self, host, now):
        """Whether a Forbid in force covers host, as last read (current)."""
        return self.unreadable or any((expires is None or expires > now) and records.covers(domain, host)
                                      for domain, expires in self.entries.items())


class HoldTime:
    """The hold time in seconds (records.hold_seconds), read again when settings.json changes. A
    broken file changes nothing: the last good value stays, the default when there was none."""

    def __init__(self, ctx):
        self.ctx = ctx
        self.key = None
        self.seconds = records.HOLD_SECONDS

    def current(self):
        path = os.path.join(CONF_DIR, records.SETTINGS)
        try:
            st = os.stat(path)
        except FileNotFoundError:
            self.key, self.seconds = None, records.HOLD_SECONDS
            return self.seconds
        except OSError:
            return self.seconds
        key = (st.st_ino, st.st_mtime_ns, st.st_ctime_ns, st.st_size)
        if key != self.key:
            self.key = key
            try:
                with open(path, encoding="utf-8") as f:
                    self.seconds = records.hold_seconds(f.read())
            except (OSError, ValueError) as e:
                why = records.printable(str(e), 200) if isinstance(e, ValueError) and str(e) else type(e).__name__
                log(lines.message(self.ctx, f"ERROR {path} unreadable ({why}), the hold time stays "
                                            f"{self.seconds} s"))
        return self.seconds


def refusal(tags):
    """Why nothing may let a host with these Signals through, as the reason for the log, else
    None (ADR 0021): it has strong Signals; or the Watchlist cannot be read, so which Signals
    are strong is unknown; or there is no classifier to tell."""
    if not suspicious or suspicious.watchlist_unreadable():
        return lines.WATCHLIST_UNREADABLE
    if strong(tags):
        return lines.suspicious(tags)
    return None


def granting(host, lists, now):
    """The entries that allow host now, domains and Regex entries alike (the Signals are
    checked before them, refusal)."""
    keys = []
    for k, expires in lists.current().items():
        if expires is not None and expires <= now:
            continue
        if k.regex:
            if lists.matches(k.value, host):
                keys.append(k)
        elif host == k.value or host.endswith("." + k.value):
            keys.append(k)
    return frozenset(keys)


def open_until(ctx):
    """End of the VM's Open web (epoch seconds), or 0 when the web is not open
    (list_records.open_until, as agentbox reads it)."""
    return records.open_until(os.path.join(CONF_DIR, records.OPEN_WEB.format(ctx)))


def strong(tags):
    return bool(suspicious and suspicious.is_strong(tags))


def decide(ctx, lists, forbids, host, tags, now):
    """(grant, reason for the log). Grant: the entries that allow host, OPEN (only Open web)
    or None (blocked, with the reason). The Signals come first (ADR 0021): strong ones block
    whatever would allow host, and while the Watchlist cannot be read nothing passes. Then the
    Allowlist, which wins over a Forbid (ADR 0024); a Forbid refuses what no entry allows, also
    in Open web."""
    why = refusal(tags)
    if why:
        return None, why
    keys = granting(host, lists, now)
    if keys:
        return keys, None
    forbids.current()
    if forbids.covers(host, now):
        return None, lines.FORBIDDEN
    if open_until(ctx):
        return OPEN, None
    return None, lines.NOT_ALLOWED


def logged(ctx, grant):
    """The entry the log names for a tunnel the Allowlist allows: the most specific domain
    (on a tie the VM's own), else a Regex entry (the VM's own first)."""
    domains = [k for k in grant if not k.regex]
    if domains:
        k = max(domains, key=lambda k: (len(k.value), k.scope == ctx))
        return "domain", k.value, k.scope
    k = min(grant, key=lambda k: (k.scope != ctx, k.value))
    return "regex", k.value, k.scope


# --- Tunnel ----------------------------------------------------------------------

class Tunnel:
    """An open tunnel and what allows it (entries or OPEN); its Signals, and the state of the
    files they came from when they were classified (signals_key)."""

    def __init__(self, host, tags, key, grant, writers):
        self.host, self.tags, self.key, self.grant, self.writers = host, tags, key, grant, writers

    def close(self):
        for w in self.writers:
            w.transport.abort()


tunnels = set()


def withdraw(ctx, lists, forbids, now, revoked, web_ended, is_open):
    """Access ends on purpose (entries removed, or Open web closed): the tunnels it allowed stay
    when their destination is still allowed now (by Open web only without a Forbid), else they
    close."""
    for t in list(tunnels):
        if not (web_ended if t.grant == OPEN else t.grant & revoked):
            continue
        keys = granting(t.host, lists, now)
        if keys:
            t.grant = keys
        elif is_open and not forbids.covers(t.host, now):   # its Signals were checked just before (recheck)
            t.grant = OPEN
        else:
            log(lines.closed(ctx, t.host, lines.OPEN_WEB_ENDED if t.grant == OPEN else lines.REMOVED))
            tunnels.discard(t)
            t.close()


def signals_key():
    """The state of the files the Signals come from, to tell when they changed; None without
    a classifier."""
    return suspicious.signals_key() if suspicious else None


def classified(host):
    """(the Signals of host, those that raise an Alert): a Harmless mark silences the ones that
    depend on the name."""
    tags = suspicious.classify(host) if suspicious else []
    return tags, suspicious.alerting(host, tags) if tags else []


def recheck(ctx):
    """The Signals of the open tunnels (ADR 0021): while the Watchlist cannot be read every one
    closes; else one whose destination has gained a strong Signal closes, after an Alert. A
    tunnel is classified again only when a file its Signals come from has changed since, each
    host once."""
    unreadable = refusal([])
    key = None if unreadable else signals_key()
    fresh, alerted = {}, set()
    for t in list(tunnels):
        if not unreadable and t.key != key:
            if t.host not in fresh:
                fresh[t.host] = classified(t.host)
            t.tags, t.key = fresh[t.host][0], key
        why = unreadable or (lines.suspicious(t.tags) if strong(t.tags) else None)
        if not why:
            continue
        alert = fresh.get(t.host, ((), ()))[1]
        if alert and t.host not in alerted:         # one Alert per host, however many tunnels close
            alerted.add(t.host)
            log(lines.alert(ctx, t.host, alert))
        log(lines.closed(ctx, t.host, why))
        tunnels.discard(t)
        t.close()


def forbid_open(ctx, forbids, now):
    """A tunnel only Open web allows closes once a Forbid covers its destination: access to it
    ended on purpose (ADR 0005)."""
    for t in list(tunnels):
        if t.grant == OPEN and forbids.covers(t.host, now):
            log(lines.closed(ctx, t.host, lines.FORBIDDEN))
            tunnels.discard(t)
            t.close()


async def watch(ctx, lists, forbids):
    """Checks the open tunnels' Signals (recheck), then compares the entries and Open web with
    their state before. An entry that is gone although it had not expired was removed on
    purpose; expired ones (and those agentbox expire-allowlist then deletes) close nothing.
    Then the tunnels only Open web allows that a Forbid covers by now close (forbid_open)."""
    known = dict(lists.current())
    was_open = bool(open_until(ctx))
    while True:
        await asyncio.sleep(CHECK_SECONDS)
        if tunnels:
            try:
                recheck(ctx)
            except Exception as e:  # the comparison below still runs, so revocations close tunnels
                log(lines.message(ctx, f"ERROR check of the open tunnels' Signals failed ({type(e).__name__}: {e})"))
        try:
            now = time.time()
            entries = lists.current()
            revoked = {k for k, expires in known.items() if k not in entries and (expires is None or expires > now)}
            is_open = bool(open_until(ctx))
            ended = was_open and not is_open
            known, was_open = dict(entries), is_open
            forbids.current()
            if revoked or ended:
                withdraw(ctx, lists, forbids, now, revoked, ended, is_open)
            forbid_open(ctx, forbids, now)
        except Exception as e:      # the watcher must never stop
            log(lines.message(ctx, f"ERROR check of open tunnels failed ({type(e).__name__}: {e})"))


# --- Hold ----------------------------------------------------------------------

# the Signals of a Watchlist hit: its categories, weak ones (payload) too
WATCHLIST_SIGNALS = frozenset(records.CATEGORIES)
held = collections.Counter()        # host: the connections to it held now
announced = collections.deque()     # when the latest HELD lines were written (monotonic)


def may_announce():
    """Whether another HELD line fits into the budget (MAX_ANNOUNCED in HELD_WINDOW seconds); uses it."""
    now = time.monotonic()
    while announced and now - announced[0] >= HELD_WINDOW:
        announced.popleft()
    if len(announced) >= MAX_ANNOUNCED:
        return False
    announced.append(now)
    return True


def holdable(tags):
    """Whether a destination with these Signals may be held: none of them strong, none from the
    Watchlist (they are refused at once, so a phishing domain never invites a click)."""
    return not strong(tags) and not WATCHLIST_SIGNALS & set(tags)


async def hold(ctx, lists, forbids, host, tags, key, reader, head, seconds):
    """Holds a connection that nothing allows yet (Hold) for up to seconds: (grant, reason for
    the log, tags, key) as decide gives them once something allows it, its Signals or an
    unreadable Watchlist or a Forbid refuse it, or the time runs out, the client leaves or sends more than
    HOLD_EXTRA_LIMIT bytes (None, NOT_ALLOWED). What the client sends meanwhile is read here (that
    is also how its leaving is noticed, whatever the size of the reader's buffer) and appended to
    head, the bytes that go to the destination first. The Signals are classified again when a
    file they come from changes (signals_key), as for tunnels."""
    if held.total() >= MAX_HELD:
        return None, lines.NOT_ALLOWED, tags, key
    if not held[host] and may_announce():
        log(lines.held(ctx, host, seconds))
    held[host] += 1
    try:
        loop = asyncio.get_running_loop()
        deadline = loop.time() + seconds
        extra = 0
        while (left := deadline - loop.time()) > 0:
            try:
                data = await asyncio.wait_for(reader.read(HOLD_EXTRA_LIMIT + 1), min(CHECK_SECONDS, left))
            except asyncio.TimeoutError:
                data = None
            except OSError:         # the client reset the connection
                break
            if data is not None:
                extra += len(data)
                if not data or extra > HOLD_EXTRA_LIMIT:
                    break           # the client left, or says more than a client waiting does
                head += data
            now_key = signals_key()
            fresh = now_key != key
            if fresh:
                key = now_key
                before, (tags, alert) = tags, classified(host)
                if alert and tags != before:
                    log(lines.alert(ctx, host, alert))  # Signals gained during the hold, as for a tunnel
            grant, why = decide(ctx, lists, forbids, host, tags, time.time())
            stop = grant is None and (why != lines.NOT_ALLOWED or not holdable(tags))
            if grant is not None or stop:
                return grant, why, tags, key
        return None, lines.NOT_ALLOWED, tags, key
    finally:
        held[host] -= 1
        if not held[host]:
            del held[host]


# --- Connections ---------------------------------------------------------------

def _address(a):
    """The address getaddrinfo gave, or None for one ipaddress cannot read (which counts as
    not public)."""
    try:
        return ipaddress.ip_address(a)
    except ValueError:
        return None


def _public(addrs):
    """The addresses, IPv4 first, or None unless every one of them is public."""
    ips = {a: _address(a) for a in addrs}
    if not ips or not all(ip is not None and ip.is_global for ip in ips.values()):
        return None
    # IPv4 first: a Host does not always have a working IPv6 route
    return sorted(ips, key=lambda a: ips[a].version)


async def resolve_public(host):
    """The addresses of host, IPv4 first, or None unless every one of them is public."""
    if TEST_RESOLVE is not None:
        # only in tests: the name's addresses are in AGENTBOX_PROXY_TEST_RESOLVE,
        # checked like every resolution; if allowed, the connection goes to the test upstream
        addrs = _public(TEST_RESOLVE.get(host, ()))
        return [TEST_UPSTREAM[0]] if addrs and TEST_UPSTREAM else addrs
    if TEST_UPSTREAM:
        return [TEST_UPSTREAM[0]]
    infos = await asyncio.get_running_loop().getaddrinfo(host, PORT, type=socket.SOCK_STREAM)
    return _public(dict.fromkeys(info[4][0] for info in infos))


async def connect_any(addrs):
    error = None
    port = TEST_UPSTREAM[1] if TEST_UPSTREAM else PORT
    for addr in addrs:
        try:
            return await asyncio.wait_for(asyncio.open_connection(addr, port), 10)
        except (OSError, asyncio.TimeoutError) as e:
            error = e
    raise error


async def pipe(reader, writer):
    try:
        while data := await reader.read(65536):
            writer.write(data)
            await writer.drain()
    except (ConnectionError, asyncio.CancelledError):
        pass
    finally:
        writer.close()


async def refuse(reader, writer, alert=None):
    """Closes the connection, after a fatal TLS alert when there is one the client can use.
    After the alert the proxy stops sending and reads what the client still sends for a
    moment, since closing with bytes unread resets the connection and loses the alert."""
    if alert is not None:
        writer.write(bytes((ALERT_RECORD, 3, 3, 0, 2, FATAL, alert)))
        try:
            writer.write_eof()
            await writer.drain()
            async with asyncio.timeout(LINGER_SECONDS):
                while await reader.read(65536):
                    pass
        except (ConnectionError, TimeoutError):
            pass
    writer.close()


async def read_hello(reader, hello):
    """(the bytes read, the server name of the ClientHello they start with), read into hello
    (a Hello). Refused when they are no ClientHello within HELLO_LIMIT bytes, or name no
    server; EOFError when the client leaves before sending anything."""
    while True:
        if len(hello.buf) >= HELLO_LIMIT:
            raise Refused(lines.NOT_TLS)
        chunk = await reader.read(HELLO_LIMIT - len(hello.buf))
        if not chunk:
            if hello.buf:
                raise Refused(lines.NOT_TLS)
            raise EOFError
        host = hello.feed(chunk)
        if host is not None:
            return bytes(hello.buf), host


async def handle(ctx, lists, forbids, hold_time, reader, writer):
    peer = writer.get_extra_info("peername")
    client = peer[0] if isinstance(peer, tuple) else "unix"
    hello = Hello()
    try:
        head, host = await asyncio.wait_for(read_hello(reader, hello), HELLO_SECONDS)
        head = bytearray(head)
    except Refused as e:
        log(lines.blocked(ctx, client, e.reason))
        await refuse(reader, writer, e.alert)
        return
    except asyncio.TimeoutError:
        # a ClientHello begun and not finished in time; a client that sent nothing leaves no line
        if hello.buf:
            log(lines.blocked(ctx, client, lines.NOT_TLS))
        writer.close()
        return
    except (EOFError, ConnectionError):
        writer.close()
        return

    # the state of the Signals' files before they are read: a change in between classifies the
    # tunnel again (recheck)
    key = signals_key()
    tags, alert = classified(host)
    if alert:
        # a line of its own, so agentbox and the Control Room can collect Alerts
        log(lines.alert(ctx, host, alert))
    now = time.time()
    grant, why = decide(ctx, lists, forbids, host, tags, now)
    if grant is None and why == lines.NOT_ALLOWED and holdable(tags):
        seconds = hold_time.current()
        if seconds:
            grant, why, tags, key = await hold(ctx, lists, forbids, host, tags, key, reader, head, seconds)
            now = time.time()
    if grant is None:
        log(lines.blocked(ctx, host, why))
        await refuse(reader, writer, ACCESS_DENIED)
        return
    try:
        addrs = await resolve_public(host)
    except (OSError, UnicodeError):     # UnicodeError: a name the IDNA codec refuses
        addrs = None
    if not addrs:
        log(lines.blocked(ctx, host, lines.NOT_PUBLIC))
        await refuse(reader, writer, ACCESS_DENIED)
        return

    try:
        up_reader, up_writer = await connect_any(addrs)
    except (OSError, asyncio.TimeoutError) as e:
        log(lines.error(ctx, host, e))
        await refuse(reader, writer, INTERNAL_ERROR)
        return
    # access may have ended while the name was resolved and the connection made: decide
    # again and register the tunnel without an await in between, so watch sees it from now on
    grant, why = decide(ctx, lists, forbids, host, tags, now)
    if grant is None:
        up_writer.close()
        log(lines.blocked(ctx, host, why))
        await refuse(reader, writer, ACCESS_DENIED)
        return
    if grant == OPEN:
        log(lines.allowed(ctx, host))
    else:
        log(lines.allowed(ctx, host, logged(ctx, grant)))
    tunnel = Tunnel(host, tags, key, grant, (writer, up_writer))
    tunnels.add(tunnel)
    try:
        up_writer.write(bytes(head))       # the ClientHello goes to the destination first
        await up_writer.drain()
        await asyncio.gather(pipe(reader, up_writer), pipe(up_reader, writer))
    except ConnectionError:
        up_writer.close()
        writer.close()
    finally:
        tunnels.discard(tunnel)


async def main():
    ctx = sys.argv[1]
    lists = Allowlist(ctx)
    forbids = Forbids(ctx)
    forbids.current()       # a broken forbids.json is logged at the start already
    hold_time = HoldTime(ctx)
    hold_time.current()     # a broken settings.json is logged at the start already
    if os.environ.get("LISTEN_FDS") == "1":
        sock = socket.socket(fileno=3)
    else:  # for testing without systemd: agentbox-proxy <vm> <socket-path>
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.bind(sys.argv[2])
        sock.listen(64)
    start = asyncio.start_unix_server if sock.family == socket.AF_UNIX else asyncio.start_server
    server = await start(lambda r, w: handle(ctx, lists, forbids, hold_time, r, w), sock=sock)
    watcher = asyncio.create_task(watch(ctx, lists, forbids))   # keep a reference, or Python collects it
    log(lines.message(ctx, "ready"))
    async with server:
        await server.serve_forever()
    watcher.cancel()


if __name__ == "__main__":
    asyncio.run(main())
