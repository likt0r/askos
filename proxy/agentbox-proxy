#!/usr/bin/python3 -I
"""HTTPS-Proxy (CONNECT) mit Allowlist fuer eine VM.

Laeuft als eigener System-User an einem Socket, den systemd uebergibt
(Socket-Aktivierung): TCP im isolierten Netz der VM oder ein Unix-Socket. Nur CONNECT auf Port 443 zu Domains der Allowlist;
Ziele im LAN oder auf localhost werden auch dann abgelehnt, wenn eine
erlaubte Domain dorthin aufloest. Jede Verbindung wird protokolliert (englisch,
agentbox liest diese Zeilen):
  [<vm>] ALLOWED <host> (allowlist <domain> <scope>)   oder (open web)
  [<vm>] BLOCKED <host> (<grund>)
  [<vm>] ALERT <host> [<merkmal>,...]
  [<vm>] CLOSED <host> (<grund>)        Tunnel vom Proxy geschlossen (ADR 0005)
  [<vm>] ERROR <host> (<fehler>)        Ziel nicht erreichbar

Allowlist: /etc/agentbox/allowlist.json (agentbox allow/disallow/...), Eintraege
mit Domain (gilt auch fuer alle Subdomains), Geltungsbereich (scope: "all" oder
der Name einer VM) und optional Ablaufzeit (expires, Epoch). Abgelaufene
Eintraege erlauben keine neuen Verbindungen. Aenderungen greifen ohne Neustart;
eine kaputte Datei aendert nichts (der letzte gute Stand bleibt). Solange es die
Datei nicht gibt (vor agentbox migrate-allowlist), gelten die alten Listen
/etc/agentbox/allowlist und allowlist-<vm>, eine Domain pro Zeile.
Steht in /etc/agentbox/open-<vm> eine Zeit in der Zukunft, ist jede
oeffentliche Domain erlaubt (offenes Web auf Zeit), ausser stark verdaechtigen.
Solange die Verdachtsliste von Hand nicht lesbar ist (watchlist.json kaputt, oder
sie fehlt und die Textdatei davor auch), laesst das offene Web nichts durch:
  [<vm>] BLOCKED <host> (Watchlist unreadable, Open web closed)

Tunnel (ADR 0005): offene Tunnel laufen ohne Zeitlimit weiter, auch wenn der
Eintrag ablaeuft, der sie erlaubt hat. Geschlossen werden nur Tunnel, deren
Zugang bewusst endet und die nichts anderes mehr erlaubt: ein Eintrag wird
entfernt, bevor er abgelaufen ist (agentbox disallow), oder das offene Web endet.
"""
import asyncio
import importlib.machinery
import importlib.util
import ipaddress
import json
import os
import socket
import sys
import time

CONF_DIR = os.environ.get("AGENTBOX_CONF_DIR", "/etc/agentbox")
ALLOWLIST = "allowlist.json"
LEGACY = ("allowlist", "allowlist-{}")     # vor allowlist.json: alle VMs, eine VM


def _load_suspicious():
    """Einstufung verdaechtiger Ziele (agentbox-suspicious, liegt neben dem Proxy: im Checkout und
    installiert, agentbox/paths.py)."""
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "agentbox-suspicious")
    if not os.path.exists(path):
        return None
    loader = importlib.machinery.SourceFileLoader("agentbox_suspicious", path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def _seconds(value, default):
    try:
        return max(0.05, float(value)) if value else default
    except ValueError:
        return default


def _test_upstream():
    """Nur in Tests (AGENTBOX_CONF_DIR gesetzt): jedes erlaubte Ziel ist dieses
    host:port statt der aufgeloesten Adresse, ohne Pruefung auf oeffentlich."""
    if "AGENTBOX_CONF_DIR" not in os.environ:
        return None
    host, _, port = os.environ.get("AGENTBOX_PROXY_TEST_UPSTREAM", "").rpartition(":")
    return (host, int(port)) if host and port.isdigit() else None


suspicious = _load_suspicious()
PORT = 443
HEADER_LIMIT = 16 * 1024
# so oft prueft der Proxy, ob Tunnel geschlossen werden muessen
CHECK_SECONDS = _seconds(os.environ.get("AGENTBOX_PROXY_CHECK_SECONDS"), 1.0)
TEST_UPSTREAM = _test_upstream()
OPEN = "open"            # Tunnel, den nur das offene Web erlaubt


def log(ctx, msg):
    print(f"[{ctx}] {msg}", file=sys.stderr, flush=True)


# --- Allowlist -----------------------------------------------------------------

def _entries(data, ctx):
    """{(domain, scope): ablauf oder None} der Eintraege, die fuer ctx gelten;
    Eintraege mit falschen Typen gelten nicht."""
    if not isinstance(data, dict) or not isinstance(data.get("entries"), list):
        raise ValueError("entries missing")
    out = {}
    for e in data["entries"]:
        if not isinstance(e, dict):
            continue
        domain, scope, expires = e.get("domain"), e.get("scope"), e.get("expires")
        if not isinstance(domain, str) or scope not in ("all", ctx):
            continue
        if expires is not None and (isinstance(expires, bool) or not isinstance(expires, (int, float))):
            continue
        domain = domain.strip().lower().rstrip(".")
        if domain:
            out[(domain, scope)] = expires
    return out


def _legacy(ctx):
    """Die alten Listen, bis agentbox sie in allowlist.json uebernommen hat."""
    out = {}
    for name, scope in zip(LEGACY, ("all", ctx)):
        try:
            with open(os.path.join(CONF_DIR, name.format(ctx)), encoding="utf-8", errors="replace") as f:
                for line in f:
                    line = line.split("#", 1)[0].strip().lower().rstrip(".")
                    if line:
                        out[(line, scope)] = None
        except OSError:
            pass
    return out


class Allowlist:
    """Die Eintraege fuer eine VM, neu gelesen, wenn sich allowlist.json aendert."""

    def __init__(self, ctx):
        self.ctx = ctx
        self.key = None
        self.entries = {}

    def current(self):
        path = os.path.join(CONF_DIR, ALLOWLIST)
        try:
            st = os.stat(path)
        except FileNotFoundError:
            self.key = None
            self.entries = _legacy(self.ctx)
            return self.entries
        except OSError:
            return self.entries
        key = (st.st_ino, st.st_mtime_ns, st.st_ctime_ns, st.st_size)
        if key != self.key:
            self.key = key
            try:
                with open(path, encoding="utf-8") as f:
                    self.entries = _entries(json.load(f), self.ctx)
            except (OSError, ValueError) as e:
                log(self.ctx, f"ERROR {path} unreadable, the previous entries stay ({type(e).__name__})")
        return self.entries


def granting(host, entries, now):
    """Die Eintraege (domain, scope), die host jetzt erlauben."""
    return [(d, s) for (d, s), expires in entries.items()
            if (expires is None or expires > now) and (host == d or host.endswith("." + d))]


def open_until(ctx):
    """Offenes Web auf Zeit: /etc/agentbox/open-<ctx> enthaelt das Ende (Epoch)."""
    try:
        with open(f"{CONF_DIR}/open-{ctx}") as f:
            until = float(f.read().strip())
    except (OSError, ValueError):
        return 0
    return until if until > time.time() else 0


def strong(tags):
    return bool(suspicious and suspicious.is_strong(tags))


def decide(ctx, lists, host, tags, now):
    """(Freigabe, Grund fuer das Log, Antwort an die VM). Freigabe: die Eintraege,
    die host erlauben, OPEN (nur das offene Web) oder None (gesperrt)."""
    keys = granting(host, lists.current(), now)
    if keys:
        return frozenset(keys), None, None
    if open_until(ctx):
        # ohne lesbare Verdachtsliste ist unbekannt, was gesperrt bleiben muesste: nichts
        if suspicious and suspicious.watchlist_unreadable():
            return (None, "Watchlist unreadable, Open web closed",
                    "Open web closed: the Watchlist cannot be read")
        # im offenen Web bleiben stark verdaechtige Ziele gesperrt (ausser freigegeben)
        if strong(tags):
            return None, f"suspicious: {','.join(tags)}", f"{host} is suspicious ({','.join(tags)})"
        return OPEN, None, None
    return None, "not on the Allowlist", f"{host} is not on the Allowlist"


# --- Tunnel ----------------------------------------------------------------------

class Tunnel:
    """Ein offener Tunnel und was ihn erlaubt (Eintraege oder OPEN)."""

    def __init__(self, host, tags, grant, writers):
        self.host, self.tags, self.grant, self.writers = host, tags, grant, writers

    def close(self):
        for w in self.writers:
            w.transport.abort()


tunnels = set()


def withdraw(ctx, entries, now, revoked, web_ended, is_open):
    """Zugang endet bewusst (Eintraege entfernt oder offenes Web zu): betroffene
    Tunnel bleiben, wenn ihr Ziel jetzt noch erlaubt ist, sonst gehen sie zu."""
    for t in list(tunnels):
        if not (web_ended if t.grant == OPEN else t.grant & revoked):
            continue
        keys = granting(t.host, entries, now)
        if keys:
            t.grant = frozenset(keys)
        elif is_open and not strong(t.tags):
            t.grant = OPEN
        else:
            log(ctx, f"CLOSED {t.host} ({'Open web ended' if t.grant == OPEN else 'removed from the Allowlist'})")
            tunnels.discard(t)
            t.close()


async def watch(ctx, lists):
    """Vergleicht laufend die Eintraege und das offene Web mit dem vorigen Stand.
    Ein Eintrag, der fehlt, obwohl er noch nicht abgelaufen war, wurde bewusst
    entfernt; abgelaufene (und die, die agentbox expire-allowlist dann loescht)
    schliessen nichts."""
    known = dict(lists.current())
    was_open = bool(open_until(ctx))
    while True:
        await asyncio.sleep(CHECK_SECONDS)
        try:
            now = time.time()
            entries = lists.current()
            revoked = {k for k, expires in known.items() if k not in entries and (expires is None or expires > now)}
            is_open = bool(open_until(ctx))
            ended = was_open and not is_open
            known, was_open = dict(entries), is_open
            if revoked or ended:
                withdraw(ctx, entries, now, revoked, ended, is_open)
        except Exception as e:      # der Waechter darf nie stehen bleiben
            log(ctx, f"ERROR check of open tunnels failed ({type(e).__name__}: {e})")


# --- Verbindungen ---------------------------------------------------------------

async def resolve_public(host):
    if TEST_UPSTREAM:
        return [TEST_UPSTREAM[0]]
    infos = await asyncio.get_running_loop().getaddrinfo(host, PORT, type=socket.SOCK_STREAM)
    addrs = list(dict.fromkeys(info[4][0] for info in infos))
    if not addrs or not all(ipaddress.ip_address(a).is_global for a in addrs):
        return None
    # IPv4 zuerst: titan hat nicht immer eine funktionierende IPv6-Route
    return sorted(addrs, key=lambda a: ipaddress.ip_address(a).version)


async def connect_any(addrs):
    error = None
    port = TEST_UPSTREAM[1] if TEST_UPSTREAM else PORT
    for addr in addrs:
        try:
            return await asyncio.wait_for(asyncio.open_connection(addr, port), 10)
        except (OSError, asyncio.TimeoutError) as e:
            error = e
    raise error


async def pipe(reader, writer):
    try:
        while data := await reader.read(65536):
            writer.write(data)
            await writer.drain()
    except (ConnectionError, asyncio.CancelledError):
        pass
    finally:
        writer.close()


async def refuse(writer, status, reason):
    writer.write(f"HTTP/1.1 {status}\r\nContent-Type: text/plain\r\nConnection: close\r\n\r\nagentbox: {reason}\n".encode())
    await writer.drain()
    writer.close()


async def handle(ctx, lists, reader, writer):
    try:
        head = await reader.readuntil(b"\r\n\r\n")
    except (asyncio.IncompleteReadError, asyncio.LimitOverrunError, ConnectionError):
        writer.close()
        return
    request = head.split(b"\r\n", 1)[0].decode("latin-1")
    parts = request.split()
    if len(parts) != 3 or parts[0] != "CONNECT":
        log(ctx, f"BLOCKED {request!r} (only HTTPS/CONNECT)")
        await refuse(writer, "405 Method Not Allowed", "only HTTPS (CONNECT) is let through")
        return

    host, _, port = parts[1].rpartition(":")
    host = host.strip("[]").lower().rstrip(".")
    tags = suspicious.classify(host, int(port) if port.isdigit() else 0) if suspicious else []
    alert = suspicious.alerting(host, tags) if tags else []     # ohne harmlos markierte
    if alert:
        # eigene Zeile, damit agentbox und der Leitstand Alerts sammeln koennen
        log(ctx, f"ALERT {host} [{','.join(alert)}]")
    if port != str(PORT):
        log(ctx, f"BLOCKED {parts[1]} (port)")
        await refuse(writer, "403 Forbidden", f"only port {PORT}")
        return
    now = time.time()
    grant, why, answer = decide(ctx, lists, host, tags, now)
    if grant is None:
        log(ctx, f"BLOCKED {host} ({why})")
        await refuse(writer, "403 Forbidden", answer)
        return
    try:
        addrs = await resolve_public(host)
    except OSError:
        addrs = None
    if not addrs:
        log(ctx, f"BLOCKED {host} (does not resolve to a public address)")
        await refuse(writer, "403 Forbidden", f"{host} has no public address")
        return

    try:
        up_reader, up_writer = await connect_any(addrs)
    except (OSError, asyncio.TimeoutError) as e:
        log(ctx, f"ERROR {host} ({e})")
        await refuse(writer, "502 Bad Gateway", f"{host} cannot be reached")
        return
    # Waehrend Aufloesung und Verbindungsaufbau kann der Zugang geendet haben:
    # noch einmal entscheiden und den Tunnel ohne await dazwischen eintragen,
    # damit watch ihn ab jetzt sieht
    grant, why, answer = decide(ctx, lists, host, tags, now)
    if grant is None:
        up_writer.close()
        log(ctx, f"BLOCKED {host} ({why})")
        await refuse(writer, "403 Forbidden", answer)
        return
    if grant == OPEN:
        log(ctx, f"ALLOWED {host} (open web)")
    else:
        # der genaueste Eintrag, bei Gleichstand der der VM selbst
        domain, scope = max(grant, key=lambda k: (len(k[0]), k[1] == ctx))
        log(ctx, f"ALLOWED {host} (allowlist {domain} {scope})")
    tunnel = Tunnel(host, tags, grant, (writer, up_writer))
    tunnels.add(tunnel)
    try:
        writer.write(b"HTTP/1.1 200 Connection established\r\n\r\n")
        await writer.drain()
        await asyncio.gather(pipe(reader, up_writer), pipe(up_reader, writer))
    except ConnectionError:
        up_writer.close()
        writer.close()
    finally:
        tunnels.discard(tunnel)


async def main():
    ctx = sys.argv[1]
    lists = Allowlist(ctx)
    if os.environ.get("LISTEN_FDS") == "1":
        sock = socket.socket(fileno=3)
    else:  # zum Testen ohne systemd: agentbox-proxy <vm> <socket-pfad>
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.bind(sys.argv[2])
        sock.listen(64)
    start = asyncio.start_unix_server if sock.family == socket.AF_UNIX else asyncio.start_server
    server = await start(lambda r, w: handle(ctx, lists, r, w), sock=sock, limit=HEADER_LIMIT)
    watcher = asyncio.create_task(watch(ctx, lists))   # Referenz halten, sonst raeumt Python ihn ab
    log(ctx, "ready")
    async with server:
        await server.serve_forever()
    watcher.cancel()


if __name__ == "__main__":
    asyncio.run(main())
