def _client_hello(host):
    """The least a TLS ClientHello naming host needs (RFC 8446, 4.1.2; RFC 6066, 3): one
    cipher suite, no compression, the server_name extension."""
    name = host.encode()
    names = b"\x00" + len(name).to_bytes(2, "big") + name
    sni = len(names).to_bytes(2, "big") + names
    extensions = b"\x00\x00" + len(sni).to_bytes(2, "big") + sni
    body = (b"\x03\x03" + bytes(32) + b"\x00" + b"\x00\x02\x13\x01" + b"\x01\x00"
            + len(extensions).to_bytes(2, "big") + extensions)
    handshake = b"\x01" + len(body).to_bytes(3, "big") + body
    return b"\x16\x03\x01" + len(handshake).to_bytes(2, "big") + handshake


def _connect(path, host):
    """The proxy's answer to a ClientHello for host: "alert <code>" for a TLS alert, else
    "closed" (nothing came back) or "data"."""
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(10)
        s.connect(path)
        s.sendall(_client_hello(host))
        data = b""
        while chunk := s.recv(4096):
            data += chunk
    if len(data) == 7 and data[:6] == b"\x15\x03\x03\x00\x02\x02":
        return f"alert {data[6]}"
    return "data" if data else "closed"


# the proxy's answer to a destination it refuses: the TLS alert access_denied
REFUSED = "alert 49"


def _selftest_list(conf, record, legacy, add, parse):
    """Eine Liste des Hosts (der Datensatz, bis es ihn gibt die Textdatei davor) mit
    einem Testeintrag nach conf kopiert. add(daten, ist_datensatz) haengt ihn an; einen
    Datensatz, den parse (wie der Proxy) kaputt nennt, gibt es als ValueError zurueck."""
    for path, is_record in ((record, True), (legacy, False)):
        try:
            with open(path, encoding="utf-8") as f:
                data = f.read()
        except FileNotFoundError:
            continue
        if is_record:
            try:
                parse(data)
            except ValueError as e:
                raise ValueError(f"{path}: {e}") from None
            data = json.dumps({"entries": add(records.entries(data), True)})
        else:
            data = add(data, False)
        with open(os.path.join(conf, os.path.basename(path)), "w", encoding="utf-8") as f:
            f.write(data)
        return
    raise OSError(f"{os.path.basename(record)} and {os.path.basename(legacy)} missing in {CONF_DIR}")


def _put(path, text):
    """A file of the self-test replaced whole, so the proxy reads it again."""
    with open(path + ".tmp", "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(path + ".tmp", path)


def _selftest_regex_lists(conf):
    """The lists for the Regex entries' cases: only test entries, one pattern per list
    (SELFTEST_REGEX) besides the test domains the cases in Open web need."""
    added = {"note": "", "added": 0, "added_by": "selftest"}
    domain, category, source = SELFTEST_WATCHLIST
    _put(os.path.join(conf, "watchlist.json"), json.dumps({"entries": [
        {"domain": domain, "category": category, "source": source, **added},
        {"regex": SELFTEST_REGEX["watchlist"], "category": "c2", "source": source, **added}]}))
    _put(os.path.join(conf, "legitimate.json"), json.dumps({"entries": [
        {"regex": SELFTEST_REGEX["legitimate"], **added}]}))
    _put(os.path.join(conf, "harmless"), "".join(d + "\n" for d in SELFTEST_HARMLESS)
         + f"regex {SELFTEST_REGEX['harmless']}\n")
    _put(os.path.join(conf, "allowlist.json"), json.dumps({"entries": [
        {"regex": p, "scope": "all", "expires": None, **added} for p in SELFTEST_REGEX["allowlist"]]}))


def self_test():
    """Starts the proxy next to this file with the Host's Watchlist and Legitimate domains
    (from CONF_DIR) plus test entries and test lists, sends it TLS ClientHellos and checks
    its log. Exit 0 when everything holds."""
    here = os.path.dirname(os.path.realpath(__file__))
    proxy = os.path.join(here, "agentbox-proxy")
    tmp = tempfile.mkdtemp(prefix="agentbox-selftest-")
    results = []
    server = None
    try:
        conf, feeds = os.path.join(tmp, "conf"), os.path.join(tmp, "feeds")
        os.mkdir(conf)
        os.mkdir(feeds)
        domain, category, source = SELFTEST_WATCHLIST
        try:
            _selftest_list(conf, WATCHLIST, LEGACY_WATCHLIST, lambda d, rec: d + [
                {"domain": domain, "category": category, "source": source, "note": "", "added": 0,
                 "added_by": "selftest"}] if rec else f"{d}\n{domain} {category} # {source}\n", _watchlist_record)
            _selftest_list(conf, LEGITIMATE, LEGACY_LEGITIMATE, lambda d, rec: d + [
                {"domain": legit, "note": "", "added": 0, "added_by": "selftest"} for legit in SELFTEST_LEGITIMATE] if rec
                else d + "".join(f"\n{legit}" for legit in SELFTEST_LEGITIMATE) + "\n", _legitimate_record)
        except (OSError, ValueError) as e:
            print(f"FAILED  lists of the Host: {getattr(e, 'strerror', None) or e}")
            return 1
        # was die Verdachtsliste des Hosts dazu sagt (its patterns too), und ein echter Eintrag
        # von ihr: seine Liste ist mit allen Eintraegen geladen
        listed = hand_watchlist()
        cases = [(host, want | {value[0] for _, value, _ in listed.hits(host)}, exact)
                 for host, want, exact in SELFTEST_CASES]
        own = sorted(d for d in listed.domains if d != domain)
        if own:
            cases.insert(1, (f"selftest.{own[0]}", {listed.domains[own[0]][0]}, False))
        # nichts freigegeben, also wird nichts aufgeloest
        with open(os.path.join(conf, "allowlist.json"), "w") as f:
            f.write('{"entries": []}\n')
        with open(os.path.join(conf, "harmless"), "w") as f:
            f.write("".join(d + "\n" for d in SELFTEST_HARMLESS))
        for name, entries in SELFTEST_FEEDS.items():
            with open(os.path.join(feeds, name), "wb") as f:
                f.write(b"".join(e.encode() + b"\n" for e in sorted(entries)))
        sock = os.path.join(tmp, "proxy.sock")
        log = os.path.join(tmp, "proxy.log")
        env = {"PATH": os.defpath, "LANG": "C.UTF-8", "AGENTBOX_CONF_DIR": conf, "AGENTBOX_FEEDS_DIR": feeds}
        with open(log, "wb") as err:
            # -B: als root aus dem Repo gestartet, keine __pycache__-Dateien dort hinterlassen
            server = subprocess.Popen([sys.executable, "-I", "-B", proxy, "selftest", sock], env=env,
                                      stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=err)
        deadline = time.monotonic() + 15
        answers = {}
        while True:
            try:
                answers[cases[0][0]] = _connect(sock, cases[0][0])
                break
            except OSError:
                if server.poll() is not None or time.monotonic() > deadline:
                    with open(log, encoding="utf-8", errors="replace") as f:
                        print("FAILED  the proxy does not start: " + f.read().strip()[-300:])
                    return 1
                time.sleep(0.05)
        for host, _, _ in cases[1:]:
            answers[host] = _connect(sock, host)
        _selftest_regex_lists(conf)
        cases += SELFTEST_REGEX_CASES
        for host, _, _ in SELFTEST_REGEX_CASES:
            answers[host] = _connect(sock, host)
        with open(os.path.join(conf, "open-selftest"), "w") as f:
            f.write(f"{int(time.time()) + 600}\n")
        for host, _ in SELFTEST_OPEN:
            answers[host] = _connect(sock, host)
        with open(os.path.join(conf, "watchlist.json"), "w") as f:
            f.write("{broken")
        answers[SELFTEST_UNREADABLE[0]] = _connect(sock, SELFTEST_UNREADABLE[0])
        os.remove(os.path.join(conf, "open-selftest"))
        answers[SELFTEST_REGEX_UNREADABLE[0]] = _connect(sock, SELFTEST_REGEX_UNREADABLE[0])
        server.terminate()
        server.wait(10)
        alerts, blocks = {}, {}
        with open(log, encoding="utf-8", errors="replace") as f:
            for line in f:
                m = LOG_ALERT.search(line.rstrip("\n"))
                if m:
                    alerts[m.group(1)] = set(m.group(2).split(","))
                m = LOG_BLOCKED.search(line.rstrip("\n"))
                if m:
                    blocks[m.group(1)] = m.group(2)
        for host, want, exact in cases:
            got = alerts.get(host, set())
            ok = (got == want if exact else want <= got) and answers[host] == REFUSED
            results.append((ok, host, f"expected {','.join(sorted(want)) or '-'}, got "
                                      f"{','.join(sorted(got)) or '-'} ({answers[host]})"))
        for host, signal in SELFTEST_OPEN + [SELFTEST_UNREADABLE]:
            why = blocks.get(host, "")
            ok = signal in why and answers[host] == REFUSED
            results.append((ok, host, f"Open web: expected blocked for {signal}, got "
                                      f"{why or '-'} ({answers[host]})"))
        for host, reason in SELFTEST_REGEX_BLOCKED + [SELFTEST_REGEX_UNREADABLE]:
            why = blocks.get(host, "")
            ok = why == reason and answers[host] == REFUSED
            results.append((ok, host, f"Allowlist pattern: expected blocked ({reason}), got "
                                      f"{why or '-'} ({answers[host]})"))
    except (OSError, subprocess.SubprocessError, IndexError) as e:
        print(f"FAILED  self-test aborted: {e}")
        return 1
    finally:
        if server is not None and server.poll() is None:
            server.kill()
            server.wait()
        shutil.rmtree(tmp, ignore_errors=True)
    for ok, host, detail in results:
        print(f"{'ok' if ok else 'FAILED':6}  {host}: {detail}")
    failed = sum(not ok for ok, _, _ in results)
    if failed:
        print(f"Self-test of the detection FAILED: {failed} of {len(results)} cases")
        return 1
    print(f"Self-test of the detection passed ({len(results)} cases)")
    return 0


def main(args):
    if args == ["--self-test"]:
        return self_test()
    if args == ["--watchlist"]:
        print(json.dumps(watchlist()))
        return 0
    if args == ["--constants"]:
        print(json.dumps(constants()))
        return 0
    if len(args) == 2 and args[0] == "--lifts":
        print(json.dumps(lifts(args[1])))
        return 0
    if args[:1] == ["--signals"]:
        print(json.dumps(signals(args[1:])))
        return 0
    as_json = args[:1] == ["--json"]
    args = args[1:] if as_json else args
    if len(args) != 1:
        print(USAGE, file=sys.stderr)
        return 1
    if as_json:
        print(json.dumps(report(args[0])))
        return 0
    found = classify(args[0])
    print(",".join(found))
    why = watchlist_unreadable()
    if why:
        print(why, file=sys.stderr)
        return 3
    return 2 if is_strong(found) else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
