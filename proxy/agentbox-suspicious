def pattern_problem(pattern, broad=True):
    """Why pattern cannot be a Regex entry, as (reason, English text, the sample host it
    matches or None), else None. broad: also the breadth check (BREADTH_SAMPLE), which the
    Watchlist does without. The rules: at most MAX_PATTERN printable ASCII characters
    without spaces; a regular expression of the re module without uppercase letters (it is
    matched against lowercased host names), backreferences or lookarounds; no quantifier or
    alternative inside a repeated group; at most MAX_WAYS ways to match a host, so that no
    host makes it backtrack for long."""
    if not isinstance(pattern, str) or not pattern:
        return "characters", PATTERN_REASONS["characters"], None
    if len(pattern) > MAX_PATTERN:
        return "too-long", PATTERN_REASONS["too-long"], None
    if not PATTERN_TEXT.fullmatch(pattern):
        return "characters", PATTERN_REASONS["characters"], None
    try:
        # a warning (such as a possible nested set, [[) refuses it too, and never reaches a log
        with warnings.catch_warnings():
            warnings.simplefilter("error")
            tree = _sre_parse.parse(pattern)
            compiled = re.compile(pattern)
    except (re.error, OverflowError, RecursionError, ValueError, Warning) as e:
        why = getattr(e, "msg", None) or str(e) or type(e).__name__
        return "syntax", f"{PATTERN_REASONS['syntax']} ({why[:100]})", None
    reason = _rule(list(tree), False, tree.state.flags)
    if reason is None and _ways(list(tree), {_END}) > MAX_WAYS:
        reason = "too-complex"
    if reason:
        return reason, PATTERN_REASONS[reason], None
    if broad:
        host = next((h for h in BREADTH_SAMPLE if compiled.fullmatch(h)), None)
        if host:
            return "too-broad", f"too broad: it matches {host}, one of the unrelated hosts it must not match", host
    return None


def compile_pattern(pattern, broad=True):
    """The compiled pattern of a Regex entry, or None when it breaks a rule (pattern_problem)."""
    if pattern_problem(pattern, broad):
        return None
    return re.compile(pattern)


def pattern_matches(compiled, host):
    """Whether a Regex entry's compiled pattern matches host (already lowercased, without its
    trailing dot); hosts longer than a host name or with other characters never match."""
    return bool(PATTERN_HOST.fullmatch(host) and compiled.fullmatch(host))


def _rule(items, repeated, flags):
    """The first rule the parsed items break, as a reason of PATTERN_REASONS, else None.
    repeated: inside a group that repeats (a quantifier with a maximum above 1)."""
    for op, av in items:
        if op in (_sre.GROUPREF, _sre.GROUPREF_EXISTS):
            return "backreference"
        if op in (_sre.ASSERT, _sre.ASSERT_NOT):
            return "lookaround"
        if not flags & _sre.SRE_FLAG_IGNORECASE and _uppercase(op, av):
            return "uppercase"
        if op is _sre.SUBPATTERN:
            _, add, remove, body = av
            reason = _rule(list(body), repeated, (flags | add) & ~remove)
        elif op is _sre.ATOMIC_GROUP:
            reason = _rule(list(av), repeated, flags)
        elif op is _sre.BRANCH:
            reason = "nested-quantifier" if repeated else next(
                (r for r in (_rule(list(alt), repeated, flags) for alt in av[1]) if r), None)
        elif op in _REPEATS:
            low, high, body = av
            reason = "nested-quantifier" if repeated and low != high else _rule(list(body), repeated or high > 1, flags)
        else:
            reason = None
        if reason:
            return reason
    return None


def _uppercase(op, av):
    if op is _sre.LITERAL:
        return 0x41 <= av <= 0x5a
    if op is _sre.IN:
        return any(o is _sre.LITERAL and 0x41 <= a <= 0x5a or o is _sre.RANGE and 0x41 <= a[0] <= a[1] <= 0x5a
                   for o, a in av)
    return False


def _chars(op, av):
    """The host characters a one-character item can match (rather more than fewer), or None
    when it is no such item."""
    if op is _sre.LITERAL:
        return frozenset({chr(av).lower()}) & _HOST_CHARS
    if op is _sre.NOT_LITERAL:
        return _HOST_CHARS - {chr(av)}
    if op is _sre.ANY:
        return _HOST_CHARS
    if op is not _sre.IN:
        return None
    out, negate = set(), False
    for o, a in av:
        if o is _sre.NEGATE:
            negate = True
        elif o is _sre.LITERAL:
            out.add(chr(a))
        elif o is _sre.RANGE:
            out |= {chr(c) for c in range(a[0], min(a[1], 0x7e) + 1)}
        elif o is _sre.CATEGORY:
            out |= _CATEGORIES.get(a, _HOST_CHARS)
        else:
            out |= _HOST_CHARS
    # negated: exactly what is left out; else with the lowercase letters, as ignorecase may match them
    return _HOST_CHARS - out if negate else frozenset({c.lower() for c in out}) & _HOST_CHARS


def _taken(items):
    """Every host character the items can consume."""
    out = set()
    for op, av in items:
        chars = _chars(op, av)
        if chars is not None:
            out |= chars
        elif op is _sre.SUBPATTERN:
            out |= _taken(av[3])
        elif op is _sre.ATOMIC_GROUP:
            out |= _taken(av)
        elif op is _sre.BRANCH:
            for alt in av[1]:
                out |= _taken(alt)
        elif op in _REPEATS:
            out |= _taken(av[2])
        elif op is not _sre.AT:
            out |= _HOST_CHARS
    return out


def _first(items, follow):
    """What the first character of the items, followed by follow, can be (with _END: the end
    of the host): their FIRST set."""
    for op, av in reversed(list(items)):
        follow = _first_item(op, av, follow)
    return follow


def _first_item(op, av, follow):
    chars = _chars(op, av)
    if chars is not None:
        return set(chars)
    if op is _sre.AT:
        return {_END} if av in (_sre.AT_END, _sre.AT_END_STRING) else follow
    if op is _sre.SUBPATTERN:
        return _first(av[3], follow)
    if op is _sre.ATOMIC_GROUP:
        return _first(av, follow)
    if op is _sre.BRANCH:
        return set().union(*(_first(alt, follow) for alt in av[1]))
    if op in _REPEATS:
        low, high, body = av
        if high == 0:
            return follow
        first = _first(body, follow)
        return first | follow if low == 0 else first
    return set(_HOST_CHARS) | {_END}


def _ways(items, follow):
    """At most how many ways the items, followed by follow (a FIRST set), can match one
    stretch of a host: what a backtracking matcher may have to try. A quantifier counts
    with the number of lengths it can take, unless what follows it cannot start with a
    character it takes (then only one length can go on); an alternative counts with the
    sum of its branches unless they start differently. Capped above MAX_WAYS."""
    total = 1
    for op, av in reversed(list(items)):
        total = min(total * _ways_item(op, av, follow), MAX_WAYS + 1)
        follow = _first_item(op, av, follow)
    return total


def _ways_item(op, av, follow):
    if op is _sre.SUBPATTERN:
        return _ways(av[3], follow)
    if op is _sre.ATOMIC_GROUP:
        return _ways(av, follow)
    if op is _sre.BRANCH:
        alts = av[1]
        firsts = [_first(alt, follow) for alt in alts]
        ways = [_ways(alt, follow) for alt in alts]
        apart = all(a.isdisjoint(b) for i, a in enumerate(firsts) for b in firsts[i + 1:])
        return max(ways) if apart else sum(ways)
    if op in _REPEATS:
        low, high, body = av
        inner = _ways(body, follow)
        if high <= 1:
            return inner + 1 if low == 0 else inner
        lengths = min(high, MAX_HOST) - min(low, MAX_HOST) + 1
        if lengths <= 1 or _taken(body).isdisjoint(follow):
            return inner
        return lengths * inner
    return 1


# --- Listen -------------------------------------------------------------------

# Pfad -> (Kennung der Datei, Inhalt, warum sie nicht lesbar ist oder None); bei einer
# kaputten Datei ist der Inhalt ihr letzter guter Stand. Das Urteil haengt an der Kennung:
# eine kaputte Datei, weg- und zurueckbenannt, bleibt kaputt
_cache = {}


class Refused(ValueError):
    """A record that reads, but holds a Regex entry the rules refuse: value is what it gives
    without such entries, the message why it counts as unreadable all the same."""

    def __init__(self, why, value):
        super().__init__(why)
        self.value = value


def _read(path, parse, empty):
    """(Inhalt, None) einer Liste, neu gelesen, wenn sich die Datei geaendert hat; (None,
    None), wenn es sie nicht gibt. Ist sie nicht lesbar oder kaputt (parse wirft
    ValueError): (der letzte gute Stand, ohne einen empty, warum); parse raising Refused:
    (what it read without the refused entries, why)."""
    hit = _cache.get(path)
    last = hit[1] if hit else empty
    try:
        st = os.stat(path)
    except FileNotFoundError:
        return None, None
    except OSError as e:
        return last, e.strerror or type(e).__name__
    key = (st.st_dev, st.st_ino, st.st_mtime_ns, st.st_size)
    if hit is not None and hit[0] == key:
        return hit[1], hit[2]
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            value, why = parse(f.read()), None
    except OSError as e:
        return last, e.strerror or type(e).__name__
    except Refused as e:
        value, why = e.value, str(e)
    except ValueError as e:
        value, why = last, str(e) or type(e).__name__
    _cache[path] = (key, value, why)
    return value, why


def _entries(text):
    """Die Liste entries eines Datensatzes ({"entries": [{...}]}); ohne sie ist die Datei
    kaputt (ValueError, wie fuer agentbox, lists.py)."""
    try:
        data = json.loads(text)
    except ValueError:
        raise ValueError("not valid JSON") from None
    if not isinstance(data, dict) or not isinstance(data.get("entries"), list):
        raise ValueError("no list entries")
    return data["entries"]


def _printable(text, limit):
    return "".join(c if c.isprintable() else "?" for c in text)[:limit]


def _problem(e, fields):
    """What is wrong with an entry of a record, else None; the same checks and texts as
    in agentbox (lists.py), byte for byte. An entry names a domain, or as a Regex entry a
    pattern (regex); whether the rules take that pattern is refused_entry's question."""
    if not isinstance(e, dict):
        return "not a JSON object"
    name = "regex" if "regex" in e else "domain"
    for key, typ in ((name, str), *fields):
        if key not in e or isinstance(e[key], bool) or not isinstance(e[key], typ):
            return f"field {key} missing or of the wrong type"
    if name == "regex":
        if "domain" in e:
            return "both domain and regex"
    elif not DOMAIN.fullmatch(e["domain"]):
        return f"invalid domain {_printable(e['domain'], 60)}"
    if fields is WATCH_FIELDS and e["category"] not in CATEGORIES:
        return f"unknown category {_printable(e['category'], 20)}"
    if len(e["note"]) > MAX_TEXT or len(e.get("source", "")) > MAX_TEXT:
        return "text too long"
    return None


def refused_entry(e, broad=True):
    """Why the rules refuse a stored Regex entry's pattern (a hand edit, or a later Release
    with stricter rules or a larger BREADTH_SAMPLE), as English text, else None. Such an
    entry counts as nothing, in the proxy as in agentbox (patterns.py), which lists it with
    this text and removes it by its pattern: on the Allowlist it allows nothing, as a
    Harmless mark it silences nothing, as a Legitimate domain it lifts nothing, and on the
    Watchlist, where it would raise a Signal, Open web stays closed until it is gone."""
    if not isinstance(e, dict) or not isinstance(e.get("regex"), str):
        return None
    why = pattern_problem(e["regex"], broad)
    return f"regex entry {_printable(e['regex'], 60)} refused: {why[1]}" if why else None


def _checked(text, fields):
    """Die Eintraege eines Datensatzes; ein kaputter oder doppelter macht die ganze Datei
    kaputt (ValueError), wie fuer agentbox. A domain and a Regex entry of the same text are
    two entries."""
    entries, seen = [], set()
    for e in _entries(text):
        why = _problem(e, fields)
        if why:
            raise ValueError(f"broken entry ({why})")
        key = ("regex", e["regex"]) if "regex" in e else ("domain", e["domain"])
        if key in seen:
            raise ValueError(f"{key[1]} listed twice")
        seen.add(key)
        entries.append(e)
    return entries


class Listed:
    """The entries of a list: domains ({domain: value}, each with its subdomains) and Regex
    entries ([(pattern, compiled, value)]), compiled once when the file is read."""

    def __init__(self, domains=None, patterns=()):
        self.domains = domains if domains is not None else {}
        self.patterns = list(patterns)

    def hits(self, host):
        """(entry, value, whether it is a Regex entry) of every entry that covers host: the
        domains that are host or above it, from host up, then the patterns that match it."""
        out = [(d, self.domains[d], False) for d in _within(host, self.domains)]
        if self.patterns and PATTERN_HOST.fullmatch(host):
            out += [(p, value, True) for p, compiled, value in self.patterns if compiled.fullmatch(host)]
        return out


EMPTY = Listed()


def _listed(entries, value, broad=True):
    """(Listed of a record's checked entries without the Regex entries the rules refuse,
    why the first of these is refused or None); value(entry) is what an entry stands for."""
    refused = [why for why in (refused_entry(e, broad) for e in entries) if why]
    kept = [e for e in entries if not refused_entry(e, broad)]
    return (Listed({e["domain"]: value(e) for e in kept if "domain" in e},
                   [(e["regex"], re.compile(e["regex"]), value(e)) for e in kept if "regex" in e]),
            refused[0] if refused else None)


def _watchlist_record(text):
    """watchlist.json  ->  Listed of (kategorie, quelle); ein Tippfehler in der Kategorie
    machte einen starken Eintrag sonst schwach. Its patterns need no breadth check: a
    broad one only raises false Alerts. A pattern the rules refuse raises no Signal, so what
    Open web would have to keep blocked is unknown: the record reads without it, but counts
    as unreadable (Refused) until it is removed."""
    listed, refused = _listed(_checked(text, WATCH_FIELDS), lambda e: (e["category"], e["source"]), broad=False)
    if refused:
        raise Refused(f"{refused}; Open web stays closed until it is removed (agentbox watch-remove --regex)",
                      listed)
    return listed


def _watchlist_text(text):
    """<domain> <kategorie> # Quelle  ->  Listed of (kategorie, quelle)"""
    entries = {}
    for line in text.splitlines():
        body, _, source = line.partition("#")
        parts = body.split()
        if len(parts) >= 2:
            entries[parts[0].lower().rstrip(".")] = (parts[1], source.strip())
    return Listed(entries)


def _domains(text):
    """Eine Domain pro Zeile (das erste Wort), Kommentare mit #."""
    out = set()
    for line in text.splitlines():
        parts = line.split("#", 1)[0].split()
        if parts:
            out.add(parts[0].lower().rstrip("."))
    return frozenset(out)


def _legitimate_text(text):
    return Listed(dict.fromkeys(_domains(text)))


def _marks(text):
    """The Harmless marks: one domain per line (the first word, comments with #), or
    "regex <pattern>" for a Regex entry. A pattern that breaks a rule counts as nothing,
    which only means more Alerts."""
    domains, patterns = {}, []
    for line in text.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[0] == "regex":
            compiled = compile_pattern(parts[1])
            if compiled:
                patterns.append((parts[1], compiled, None))
            continue
        parts = line.split("#", 1)[0].split()
        if parts:
            domains[parts[0].lower().rstrip(".")] = None
    return Listed(domains, patterns)


def _legitimate_record(text):
    """legitimate.json  ->  Listed; kaputt zaehlen nur die eingebauten (oder im Proxy
    der letzte gute Stand), das fuegt nur Merkmale hinzu. A pattern the rules refuse lifts
    nothing, which only adds Signals; the other entries count."""
    return _listed(_checked(text, LEGITIMATE_FIELDS), lambda e: None)[0]


def _hand_watchlist():
    """(Verdachtsliste von Hand, warum sie gerade nicht lesbar ist oder None). Fehlt
    watchlist.json und die Textdatei davor auch, bleibt ihr letzter guter Stand, wie fuer
    eine kaputte."""
    found, why = _read(WATCHLIST, _watchlist_record, EMPTY)
    if found is not None:
        return found, why and f"{WATCHLIST}: {why}"
    found, why = _read(LEGACY_WATCHLIST, _watchlist_text, EMPTY)
    if found is None:
        hit = _cache.get(WATCHLIST)
        return (hit[1] if hit else EMPTY), f"{WATCHLIST} missing"
    return found, why and f"{LEGACY_WATCHLIST}: {why}"


def hand_watchlist():
    """Die Verdachtsliste von Hand, Listed of (kategorie, quelle): watchlist.json, bis
    es sie gibt die Textdatei davor; ist sie kaputt, ihr letzter guter Stand."""
    return _hand_watchlist()[0]


def watchlist_unreadable():
    """Warum die Verdachtsliste von Hand gerade nicht lesbar ist, sonst None: watchlist.json
    ist kaputt oder nicht lesbar, oder sie fehlt und die Textdatei davor auch. Der Proxy
    sperrt dann das offene Web, auch mit einem letzten guten Stand im Speicher: was es
    gesperrt halten muesste, ist unbekannt. agentbox (lists.py) urteilt genauso."""
    return _hand_watchlist()[1]


def _within(host, domains):
    """Die Eintraege aus domains, die host selbst oder eine uebergeordnete Domain sind."""
    labels = host.split(".")
    return [d for d in (".".join(labels[i:]) for i in range(len(labels))) if d in domains]


# (die legitimen Domains des Hosts, mit den eingebauten vereinigt, and the Host's patterns):
# neu gebildet nur, wenn sich die des Hosts aendern, nicht fuer jedes Ziel, das der Proxy einstuft
_legitimate = (None, GENUINE, ())


def _legitimate_lists():
    """(the Legitimate domains with the built-in ones, the Host's Regex entries)"""
    global _legitimate
    found = _read(LEGITIMATE, _legitimate_record, EMPTY)[0]
    if found is None:
        found = _read(LEGACY_LEGITIMATE, _legitimate_text, EMPTY)[0] or EMPTY
    if _legitimate[0] is not found:
        _legitimate = (found, frozenset(found.domains) | GENUINE, tuple(found.patterns))
    return _legitimate[1:]


def legitimate_domains():
    """Bekannte legitime Domains: die eingebauten und die des Hosts (legitimate.json, bis
    es sie gibt die Textdatei davor). Treffer der HaGeZi-Listen fuer sie und ihre
    Subdomains zaehlen nicht (explain); die Listen liegen ungefiltert."""
    return _legitimate_lists()[0]


def legitimate(host):
    """Der Eintrag der legitimen Domains, unter den host faellt, sonst None."""
    hits = _within(host, legitimate_domains())
    return hits[-1] if hits else None


def legitimate_pattern(host):
    """The first Regex entry of the Legitimate domains that matches host, else None. It lifts
    only weak Signals (explain): which strong ones a pattern would lift cannot be checked when
    it is added, as it is for a domain (ADR 0009, ADR 0013)."""
    if not PATTERN_HOST.fullmatch(host):
        return None
    return next((p for p, compiled, _ in _legitimate_lists()[1] if compiled.fullmatch(host)), None)


def harmless_hit(host):
    """(the Harmless mark that covers host, whether it is a Regex entry), else None; a domain
    before a pattern."""
    hits = (_read(HARMLESS, _marks, EMPTY)[0] or EMPTY).hits(host)
    domains = [h for h in hits if not h[2]]
    if domains:
        return domains[-1][0], False
    return (hits[0][0], True) if hits else None


def harmless(host):
    """Der Eintrag der Harmlos-Liste, unter den host faellt (a domain or a pattern), sonst None."""
    hit = harmless_hit(host)
    return hit[0] if hit else None


class SortedList:
    """Eine sortierte Liste (eine Domain pro Zeile, nach Bytes sortiert), per mmap
    gelesen. Eine Suche liest ~20 Seiten; ersetzt agentbox-feeds die Datei
    (Umbenennen), wird beim naechsten Aufruf die neue geoeffnet."""

    def __init__(self, path):
        self.path = path
        self.key = None
        self.map = None

    def current(self):
        try:
            st = os.stat(self.path)
        except OSError:
            self.drop()
            return None
        key = (st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns)
        if key != self.key:
            self.drop()
            self.key = key
            if st.st_size:
                try:
                    with open(self.path, "rb") as f:
                        self.map = mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ)
                except (OSError, ValueError):
                    return None
                try:
                    # kein Vorauslesen: von jeder Suche bleiben nur ihre Seiten im Cache
                    self.map.madvise(mmap.MADV_RANDOM)
                except (OSError, ValueError, AttributeError):
                    pass
        return self.map

    def drop(self):
        if self.map is not None:
            self.map.close()
        self.map = self.key = None

    @staticmethod
    def contains(m, key):
        lo, hi = 0, len(m)
        while lo < hi:
            mid = (lo + hi) // 2
            start = m.rfind(b"\n", lo, mid) + 1 or lo
            end = m.find(b"\n", start, hi)
            if end < 0:
                end = hi
            line = m[start:end]
            if line == key:
                return True
            if line < key:
                lo = end + 1
            else:
                hi = start
        return False

    def below(self, domain, limit):
        """Bis zu limit Eintraege, die domain selbst oder eine Subdomain davon sind (liest
        die ganze Liste, nur fuer seltene Aufrufe)."""
        m = self.current()
        if m is None:
            return []
        key = domain.encode("ascii", "ignore")
        out = [domain] if self.contains(m, key) else []
        suffix, pos = b"." + key + b"\n", 0
        while len(out) < limit:
            i = m.find(suffix, pos)
            if i < 0:
                break
            start = m.rfind(b"\n", 0, i) + 1
            out.append(m[start:i + len(suffix) - 1].decode("ascii", "replace"))
            pos = i + len(suffix)
        return out

    def match(self, host):
        """Der Eintrag, der host oder eine uebergeordnete Domain (ab zwei Labels) ist."""
        m = self.current()
        if m is None:
            return None
        labels = host.split(".")
        for i in range(len(labels) - 1):
            name = ".".join(labels[i:])
            try:
                key = name.encode("ascii")
            except UnicodeEncodeError:
                continue
            if self.contains(m, key):
                return name
        return None


_feeds = {name: SortedList(os.path.join(FEEDS_DIR, name)) for name in FEEDS}


def feed_status():
    """Stand der HaGeZi-Listen, wie agentbox-feeds ihn zuletzt geschrieben hat."""
    try:
        with open(FEED_STATUS, encoding="utf-8") as f:
            status = json.load(f)
    except (OSError, ValueError):
        status = {}
    out = {}
    for name in FEEDS:
        s = status.get(name) if isinstance(status, dict) else None
        s = s if isinstance(s, dict) else {}
        out[name] = {"present": os.path.isfile(os.path.join(FEEDS_DIR, name)),
                     **{k: s.get(k) for k in ("entries", "updated", "attempted", "error", "days")}}
    return out


# --- Einstufung ----------------------------------------------------------------

def registrable(host):
    """Grobe Naeherung der registrierbaren Domain (letzte zwei Labels)."""
    labels = host.split(".")
    return ".".join(labels[-2:]) if len(labels) >= 2 else host


def entropy(s):
    if not s:
        return 0.0
    counts = {c: s.count(c) for c in set(s)}
    return -sum(n / len(s) * math.log2(n / len(s)) for n in counts.values())


def levenshtein(a, b, limit=None):
    """Editierabstand; mit limit hoechstens limit + 1 (bricht frueh ab)."""
    prev = list(range(len(b) + 1))
    for i, ca in enumerate(a, 1):
        cur = [i]
        for j, cb in enumerate(b, 1):
            cur.append(min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (ca != cb)))
        if limit is not None and min(cur) > limit:
            return limit + 1
        prev = cur
    return prev[-1]


def normalise(host):
    return host.lower().strip("[]").rstrip(".")


def _reason(signal, code, text, **params):
    """One Signal with why it applies: the Signal, a stable code for the kind of reason,
    its parameters (all text) and the English text built from them. The Control Room
    words the reason from code and parameters (docs/control-room-api.md); the text is the
    fallback and what the CLI shows."""
    return {"signal": signal, "code": code, "params": {k: str(v) for k, v in params.items()}, "reason": text}


def explain(host):
    """Every Signal with why it applies, as a list of _reason(), regardless of the
    Harmless marks."""
    host = normalise(host)
    found = []
    if host in METADATA:
        found.append(_reason("metadata", "metadata", "address of a cloud metadata service"))
    try:
        ipaddress.ip_address(host)
        found.append(_reason("raw-ip", "raw-ip", "IP address instead of a domain"))
        return found
    except ValueError:
        pass

    for entry, (category, source), regex in hand_watchlist().hits(host):
        more = {"source": source} if source else {}
        if regex:
            found.append(_reason(category, "watchlist-regex", f"Watchlist: pattern {entry}"
                                 + (f" ({source})" if source else ""), pattern=entry, **more))
        else:
            found.append(_reason(category, "watchlist", f"Watchlist: {entry}" + (f" ({source})" if source else ""),
                                 domain=entry, **more))
    # Bekannt legitim: keine Muster, Treffer der HaGeZi-Listen zaehlen nicht (fuer die Domain
    # und darunter; ein Eintrag ueber ihr zaehlt weiter fuer ihre Nachbarn). A regex
    # Legitimate domain lifts only the weak ones.
    if legitimate(host):
        pass
    elif legitimate_pattern(host):
        found += [r for r in _name_signals(host) if r["signal"] in STRONG]
    else:
        found += _name_signals(host)
    # ausser dem Blockchain-Muster: das hebt keine legitime Domain auf (nur agentbox allow --force)
    if BLOCKCHAIN.search(host):
        found.append(_reason("blockchain", "blockchain-pattern", "pattern of a blockchain RPC service"))
    return found


def _name_signals(host):
    """Signals from the HaGeZi lists and from patterns in the name, which Legitimate
    domains do not get, as a list of _reason(); the blockchain pattern is not one of them."""
    found = []
    hit = _feeds["threat-intelligence"].match(host)
    if hit:
        found.append(_reason("threat", "threat-feed", f"HaGeZi Threat Intelligence Feeds: {hit}", domain=hit))
    hit = _feeds["newly-registered"].match(host)
    if hit:
        found.append(_reason("young", "young-feed", f"newly registered (HaGeZi NRD): {hit}", domain=hit))

    reg = registrable(host)
    name = reg.split(".")[0]
    tld = reg.rsplit(".", 1)[-1]
    # Registry-/Anbieter-Name in fremder Domain (npm-cache.com, pypi-get.com, npmjs.help)
    brand = next((b for b in BRANDS if b in re.split(r"[-_]", name) or name.startswith(b) or name.endswith(b)), None)
    if brand:
        found.append(_reason("lookalike", "brand", f"brand name {brand} in the foreign domain {reg}",
                             brand=brand, domain=reg))
    # Tippfehler-Domains (npnjs.com), nur fuer Namen ab MIN_TYPO Zeichen
    elif len(name) >= MIN_TYPO:
        for target in TYPO_TARGETS:
            if abs(len(target) - len(name)) <= 2:
                d = levenshtein(name, target, 2)
                if d <= 2:
                    found.append(_reason("lookalike", "typo", f"typo of {target} (distance {d})",
                                         target=target, distance=d))
                    break
    if tld in ODD_TLDS:
        found.append(_reason("tld", "tld", f"unusual TLD .{tld}", tld=tld))
    # Zufaellig wirkende oder sehr lange Labels (DNS-Exfil, generierte Domains)
    for label in host.split(".")[:-1]:
        if len(label) > 40 or (len(label) >= 20 and entropy(label) > 3.5) or re.fullmatch(r"[0-9a-f]{16,}", label):
            found.append(_reason("random-label", "random-label", f"random-looking or very long label {label[:63]}",
                                 label=label[:63]))
            break
    if len(host.split(".")) > 6:
        found.append(_reason("many-labels", "many-labels", "more than six labels"))
    return found


def classify(host):
    """Liefert eine sortierte Liste von Merkmalen; leer = unauffaellig."""
    return sorted({r["signal"] for r in explain(host)})


def alerting(host, tags):
    """Die Merkmale, die einen Alert ausloesen: bei harmlosen Domains nur die, die
    nicht am Namen haengen. Sperren (offenes Web, Freigabe) richten sich weiter
    nach allen Merkmalen."""
    return sorted(set(tags) & STRUCTURAL) if harmless(normalise(host)) else list(tags)


def is_strong(tags):
    return bool(STRONG & set(tags))


def report(host):
    """For agentbox check-domain: every Signal with why it applies (its English text, and
    the code and parameters the Control Room words it from)."""
    host = normalise(host)
    quiet = harmless_hit(host)
    signals = [{"signal": r["signal"], "strong": r["signal"] in STRONG, "reason": r["reason"], "code": r["code"],
                "params": r["params"], "suppressed": bool(quiet) and r["signal"] not in STRUCTURAL}
               for r in explain(host)]
    legit = legitimate(host)
    legit_pattern = None if legit else legitimate_pattern(host)
    # harmless and legitimate: the entry that covers it, a domain or (*_regex) a pattern
    return {"domain": host, "signals": signals,
            "alert": any(not s["suppressed"] for s in signals),
            "strong": is_strong(s["signal"] for s in signals),
            "harmless": quiet[0] if quiet else None, "harmless_regex": bool(quiet and quiet[1]),
            "legitimate": legit or legit_pattern, "legitimate_regex": bool(legit_pattern), "feeds": feed_status()}


def lifts(domain):
    """Fuer agentbox legitimate-add: was es aufhoebe, domain (mit ihren Subdomains) legitim zu
    machen. Die starken Merkmale aus Mustern und HaGeZi-Listen, die domain selbst hat (auch
    ein Eintrag ueber ihr; das Blockchain-Muster nicht, das bleibt), und Eintraege der
    Threat-Intelligence-Liste, die domain oder eine Subdomain sind, auch unter einer
    legitimen Domain des Hosts (die kann wieder gehen, diese bliebe): die Liste liegt
    ungefiltert. Nichts unter einer eingebauten, die bleibt. feed_present: ob es die
    Threat-Intelligence-Liste gibt (sonst ist nicht pruefbar, was darunter steht)."""
    domain = normalise(domain)
    feed = _feeds["threat-intelligence"]
    if _within(domain, GENUINE):
        return {"domain": domain, "signals": [], "feed_entries": [], "feed_present": True}
    return {"domain": domain,
            "signals": sorted({r["signal"] for r in _name_signals(domain) if r["signal"] in STRONG}),
            "feed_entries": feed.below(domain, LIFTS_SHOWN),
            "feed_present": feed.current() is not None}


def constants():
    """Fuer agentbox: die Kategorien der Verdachtsliste ({kategorie: stark}) und die
    eingebauten legitimen Domains."""
    return {"categories": {c: c in STRONG for c in CATEGORIES}, "genuine": sorted(GENUINE)}


def watchlist():
    """Fuer agentbox watchlist: die Verdachtsliste von Hand (jeder Eintrag mit Kategorie,
    ob sie stark ist, und Quelle) und der Stand der HaGeZi-Listen."""
    entries = hand_watchlist()
    return {"entries": [{"domain": d, "regex": None, "category": c, "strong": c in STRONG, "source": src}
                        for d, (c, src) in sorted(entries.domains.items())]
                       + [{"domain": None, "regex": p, "category": c, "strong": c in STRONG, "source": src}
                          for p, _, (c, src) in sorted(entries.patterns, key=lambda x: x[0])],
            "feeds": feed_status()}


def signals(hosts):
    """For agentbox (the preview of a regex Allowlist entry): each host's Signals and whether
    one is strong, and why the Watchlist cannot be read (then nothing a pattern matches gets
    through)."""
    out = {}
    for host in hosts:
        tags = classify(host)
        out[normalise(host)] = {"signals": tags, "strong": is_strong(tags)}
    return {"hosts": out, "watchlist_unreadable": watchlist_unreadable()}


