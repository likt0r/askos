# Host records (only agentbox writes them) and the text files from before
WATCHLIST = os.path.join(CONF_DIR, records.WATCHLIST)
LEGITIMATE = os.path.join(CONF_DIR, records.LEGITIMATE)
LEGACY_WATCHLIST = os.path.join(CONF_DIR, records.LEGACY_WATCHLIST)
LEGACY_LEGITIMATE = os.path.join(CONF_DIR, records.LEGACY_LEGITIMATE)
HARMLESS = os.path.join(CONF_DIR, records.HARMLESS)
FEEDS_DIR = os.environ.get("AGENTBOX_FEEDS_DIR", "/var/lib/agentbox/feeds")
# File names of the HaGeZi lists in FEEDS_DIR (agentbox-feeds writes them)
