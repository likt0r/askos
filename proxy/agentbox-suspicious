            "cyou", "buzz", "monster", "quest", "loan", "gq", "tk", "ml", "cf", "ga"}
BLOCKCHAIN = re.compile(r"(^|\.)(solana\.|mainnet|rpc\.)|llamarpc|nodereal|getblock|infura|alchemy|quicknode|quiknode|ankr\.com|tronscan|trongrid")
METADATA = {"169.254.169.254", "metadata.google.internal", "fd00:ec2::254", "100.100.100.200"}
# An entry of the HaGeZi lists: labels of letters, digits and hyphens,
# TLD of letters or Punycode (no IP addresses)
FEED_ENTRY = re.compile(rb"(?=.{4,253}\Z)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+([a-z]{2,63}|xn--[a-z0-9-]{1,59})")

USAGE = ("agentbox-suspicious <host> | --json <host> | --watchlist | --constants | "
         "--lifts <domain> | --signals <host>... | --self-test")


# --- Lists --------------------------------------------------------------------

# Path -> (identity of the file, content, why it cannot be read or None); for a
# broken file the content is its last good state. The verdict hangs on the identity:
# a broken file, renamed away and back, stays broken. The key holds the ctime, which a
# chmod changes: a file that can no longer be read counts as unreadable at once
_cache = {}


class Refused(ValueError):
    """A record that reads, but holds a Regex entry the rules refuse: value is what it gives
    without such entries, the message why it counts as unreadable all the same."""

    def __init__(self, why, value):
        super().__init__(why)
        self.value = value


def _read(path, parse, empty):
    """(content, None) of a list, read again when the file has changed; (None,
    None) when it does not exist. When it cannot be read or is broken (parse raises
    ValueError): (the last good state, or empty if there is none, why); parse raising Refused:
    (what it read without the refused entries, why)."""
    hit = _cache.get(path)
    last = hit[1] if hit else empty
    try:
        st = os.stat(path)
    except FileNotFoundError:
        return None, None
    except OSError as e:
        return last, e.strerror or type(e).__name__
    key = (st.st_dev, st.st_ino, st.st_mtime_ns, st.st_ctime_ns, st.st_size)
    if hit is not None and hit[0] == key:
        return hit[1], hit[2]
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            value, why = parse(f.read()), None
    except OSError as e:
        return last, e.strerror or type(e).__name__
    except Refused as e:
        value, why = e.value, str(e)
    except ValueError as e:
        value, why = last, str(e) or type(e).__name__
    _cache[path] = (key, value, why)
    return value, why


def _checked(text, check):
    """The entries of a record; a broken or duplicate one makes the whole file broken
    (ValueError), with agentbox's texts (list_records)."""
    return records.checked(records.entries(text), check)


class Listed:
    """The entries of a list: domains ({domain: value}, each with its subdomains) and Regex
    entries ([(pattern, compiled, value)]), compiled once when the file is read."""

    def __init__(self, domains=None, patterns=()):
        self.domains = domains if domains is not None else {}
        self.patterns = list(patterns)

    def hits(self, host):
        """(entry, value, whether it is a Regex entry) of every entry that covers host: the
        domains that are host or above it, from host up, then the patterns that match it."""
        out = [(d, self.domains[d], False) for d in _within(host, self.domains)]
        if self.patterns and PATTERN_HOST.fullmatch(host):
            out += [(p, value, True) for p, compiled, value in self.patterns if compiled.fullmatch(host)]
        return out


EMPTY = Listed()


def _listed(entries, value, broad=True):
    """(Listed of a record's checked entries without the Regex entries the rules refuse,
    why the first of these is refused or None); value(entry) is what an entry stands for."""
    refused = [why for why in (refused_entry(e, broad) for e in entries) if why]
    kept = [e for e in entries if not refused_entry(e, broad)]
    return (Listed({e["domain"]: value(e) for e in kept if "domain" in e},
                   [(e["regex"], re.compile(e["regex"]), value(e)) for e in kept if "regex" in e]),
            refused[0] if refused else None)


def _watchlist_record(text):
    """watchlist.json  ->  Listed of (category, source); a typo in the category
    would otherwise make a strong entry weak. Its patterns need no breadth check: a
    broad one only raises false Alerts. A pattern the rules refuse raises no Signal, so what
    the proxy would have to keep blocked is unknown: the record reads without it, but counts
    as unreadable (Refused) until it is removed."""
    listed, refused = _listed(_checked(text, records.watch_problem), lambda e: (e["category"], e["source"]), broad=False)
    if refused:
        raise Refused(f"{refused}; the proxy lets nothing through until it is removed (agentbox watch-remove --regex)",
                      listed)
    return listed


def _watchlist_text(text):
    """<domain> <category> # source  ->  Listed of (category, source)"""
    return Listed({records.legacy_domain(parts[0]): (parts[1], source.strip())
                   for parts, source in ((body.split(), source) for body, source in records.legacy_lines(text))
                   if len(parts) >= 2})


def _legitimate_text(text):
    return Listed(dict.fromkeys(records.legacy_domains(text)))


def _marks(text):
    """The Harmless marks (list_records.harmless_marks). A pattern that breaks a rule counts as
    nothing, which only means more Alerts."""
    marks = records.harmless_marks(text)
    return Listed({m["domain"]: None for m in marks if "domain" in m},
                  [(m["regex"], compiled, None) for m in marks if "regex" in m
                   for compiled in [compile_pattern(m["regex"])] if compiled])


def _legitimate_record(text):
    """legitimate.json  ->  Listed; when broken only the built-in ones count (or in the proxy
    the last good state), which only adds Signals. A pattern the rules refuse lifts
    nothing, which only adds Signals; the other entries count."""
    return _listed(_checked(text, records.legitimate_problem), lambda e: None)[0]


def _hand_watchlist():
    """(the Watchlist, why it cannot be read right now or None). If
    watchlist.json and the text file from before are both missing, its last good state stays, as for
    a broken one."""
    found, why = _read(WATCHLIST, _watchlist_record, EMPTY)
    if found is not None:
        return found, why and f"{WATCHLIST}: {why}"
    found, why = _read(LEGACY_WATCHLIST, _watchlist_text, EMPTY)
    if found is None:
        hit = _cache.get(WATCHLIST)
        return (hit[1] if hit else EMPTY), f"{WATCHLIST} missing"
    return found, why and f"{LEGACY_WATCHLIST}: {why}"


def hand_watchlist():
    """The Watchlist, Listed of (category, source): watchlist.json, until it
    exists the text file from before; when it is broken, its last good state."""
    return _hand_watchlist()[0]


def watchlist_unreadable():
    """Why the Watchlist cannot be read right now, else None: watchlist.json
    is broken or unreadable, or it is missing and the text file from before too. The proxy then
    lets nothing through, Allowlist entries included, and closes every tunnel, also with a last
    good state in memory: which Signals are strong is unknown (ADR 0021). agentbox (lists.py)
    judges alike."""
    return _hand_watchlist()[1]


def signals_key():
    """The state of every file the Signals come from (the Watchlist and the Legitimate domains,
    each also as the text file from before, and the Feeds; not the Harmless marks, which only
    silence Alerts), as a value that changes whenever one of them changes: the proxy classifies
    its open tunnels again only then (ADR 0021). Costs one stat per file."""
    out = []
    for path in (WATCHLIST, LEGACY_WATCHLIST, LEGITIMATE, LEGACY_LEGITIMATE,
                 *(os.path.join(FEEDS_DIR, name) for name in FEEDS)):
        try:
            st = os.stat(path)
        except OSError as e:
            out.append(e.errno)
        else:
            out.append((st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns, st.st_ctime_ns))
    return tuple(out)


def _within(host, domains):
    """The entries of domains that are host itself or a parent domain."""
    labels = host.split(".")
    return [d for d in (".".join(labels[i:]) for i in range(len(labels))) if d in domains]


# (the Host's Legitimate domains, merged with the built-in ones, and the Host's patterns):
# rebuilt only when the Host's change, not for every destination the proxy classifies
_legitimate = (None, GENUINE, ())


def _legitimate_lists():
    """(the Legitimate domains with the built-in ones, the Host's Regex entries)"""
    global _legitimate
    found = _read(LEGITIMATE, _legitimate_record, EMPTY)[0]
    if found is None:
        found = _read(LEGACY_LEGITIMATE, _legitimate_text, EMPTY)[0] or EMPTY
    if _legitimate[0] is not found:
        _legitimate = (found, frozenset(found.domains) | GENUINE, tuple(found.patterns))
    return _legitimate[1:]


def legitimate_domains():
    """Known Legitimate domains: the built-in ones and the Host's (legitimate.json, until
    it exists the text file from before). HaGeZi list hits for them and their
    subdomains do not count (explain), except on subdomains of the user-content domains
    (USER_CONTENT); the lists are unfiltered."""
    return _legitimate_lists()[0]


def legitimate(host):
    """The entry of the Legitimate domains that host falls under, else None."""
    hits = _within(host, legitimate_domains())
    return hits[-1] if hits else None


def _user_content(domain):
    """The user-content domain (USER_CONTENT) that domain is a subdomain of (not the domain
    itself), else None."""
    labels = domain.split(".")
    return next((d for d in (".".join(labels[i:]) for i in range(1, len(labels))) if d in USER_CONTENT),
                None)


def legitimate_pattern(host):
    """The first Regex entry of the Legitimate domains that matches host, else None. It lifts
    only weak Signals (explain): which strong ones a pattern would lift cannot be checked when
    it is added, as it is for a domain (ADR 0009, ADR 0013)."""
    if not PATTERN_HOST.fullmatch(host):
        return None
    return next((p for p, compiled, _ in _legitimate_lists()[1] if compiled.fullmatch(host)), None)


def harmless_hit(host):
    """(the Harmless mark that covers host, whether it is a Regex entry), else None; a domain
    before a pattern."""
    hits = (_read(HARMLESS, _marks, EMPTY)[0] or EMPTY).hits(host)
    domains = [h for h in hits if not h[2]]
    if domains:
        return domains[-1][0], False
    return (hits[0][0], True) if hits else None


def harmless(host):
    """The entry of the Harmless list that host falls under (a domain or a pattern), else None."""
    hit = harmless_hit(host)
    return hit[0] if hit else None


class SortedList:
    """A sorted list (one domain per line, sorted by bytes), read through
    mmap. A lookup reads ~20 pages; if agentbox-feeds replaces the file
    (rename), the new one is opened on the next call."""

    def __init__(self, path):
        self.path = path
        self.key = None
        self.map = None

    def current(self):
        try:
            st = os.stat(self.path)
        except OSError:
            self.drop()
            return None
        key = (st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns)
        if key != self.key:
            self.drop()
            self.key = key
            if st.st_size:
                try:
                    with open(self.path, "rb") as f:
                        self.map = mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ)
                except (OSError, ValueError):
                    return None
                try:
                    # no read-ahead: of each lookup only its pages stay in the cache
                    self.map.madvise(mmap.MADV_RANDOM)
                except (OSError, ValueError, AttributeError):
                    pass
        return self.map

    def drop(self):
        if self.map is not None:
            self.map.close()
        self.map = self.key = None

    @staticmethod
    def contains(m, key):
        lo, hi = 0, len(m)
        while lo < hi:
            mid = (lo + hi) // 2
            start = m.rfind(b"\n", lo, mid) + 1 or lo
            end = m.find(b"\n", start, hi)
            if end < 0:
                end = hi
            line = m[start:end]
            if line == key:
                return True
            if line < key:
                lo = end + 1
            else:
                hi = start
        return False

    def below(self, domain, limit):
        """Up to limit entries that are domain itself or a subdomain of it (reads
        the whole list, only for rare calls)."""
        m = self.current()
        if m is None:
            return []
        key = domain.encode("ascii", "ignore")
        out = [domain] if self.contains(m, key) else []
        suffix, pos = b"." + key + b"\n", 0
        while len(out) < limit:
            i = m.find(suffix, pos)
            if i < 0:
                break
            start = m.rfind(b"\n", 0, i) + 1
            out.append(m[start:i + len(suffix) - 1].decode("ascii", "replace"))
            pos = i + len(suffix)
        return out

    def match(self, host):
        """The entry that is host or a parent domain (from two labels)."""
        m = self.current()
        if m is None:
            return None
        labels = host.split(".")
        for i in range(len(labels) - 1):
            name = ".".join(labels[i:])
            try:
                key = name.encode("ascii")
            except UnicodeEncodeError:
                continue
            if self.contains(m, key):
                return name
        return None


_feeds = {name: SortedList(os.path.join(FEEDS_DIR, name)) for name in FEEDS}


def feed_status():
    """State of the HaGeZi lists, as agentbox-feeds last wrote it."""
    try:
        with open(FEED_STATUS, encoding="utf-8") as f:
            status = json.load(f)
    except (OSError, ValueError):
        status = {}
    out = {}
    for name in FEEDS:
        s = status.get(name) if isinstance(status, dict) else None
        s = s if isinstance(s, dict) else {}
        out[name] = {"present": os.path.isfile(os.path.join(FEEDS_DIR, name)),
                     **{k: s.get(k) for k in ("entries", "updated", "attempted", "error", "days")}}
    return out


# --- Classification -----------------------------------------------------------

def registrable(host):
    """Rough approximation of the registrable domain (last two labels)."""
    labels = host.split(".")
    return ".".join(labels[-2:]) if len(labels) >= 2 else host


def entropy(s):
    if not s:
        return 0.0
    counts = {c: s.count(c) for c in set(s)}
    return -sum(n / len(s) * math.log2(n / len(s)) for n in counts.values())


def levenshtein(a, b, limit=None):
    """Edit distance; with limit at most limit + 1 (stops early)."""
    prev = list(range(len(b) + 1))
    for i, ca in enumerate(a, 1):
        cur = [i]
        for j, cb in enumerate(b, 1):
            cur.append(min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (ca != cb)))
        if limit is not None and min(cur) > limit:
            return limit + 1
        prev = cur
    return prev[-1]


def normalise(host):
    return host.lower().strip("[]").rstrip(".")


def _reason(signal, code, text, **params):
    """One Signal with why it applies: the Signal, a stable code for the kind of reason,
    its parameters (all text) and the English text built from them. The Control Room
    words the reason from code and parameters (docs/control-room-api.md); the text is the
    fallback and what the CLI shows."""
    return {"signal": signal, "code": code, "params": {k: str(v) for k, v in params.items()}, "reason": text}


# a last label no top-level domain has, which resolvers take for part of an address
NUMERIC_LABEL = re.compile(r"[0-9]+|0x[0-9a-f]*")


def is_address(host):
    """Whether a resolver takes host for an IP address: one ipaddress reads, an IPv4 address
    in any form inet_aton takes (16909060, 0x01020304, 1.2.3), or a name whose last label is
    all digits or 0x and hex digits."""
    try:
        ipaddress.ip_address(host)
        return True
    except ValueError:
        pass
    try:
        socket.inet_aton(host)
        return True
    except (OSError, ValueError):
        pass
    return bool(NUMERIC_LABEL.fullmatch(host.rsplit(".", 1)[-1]))


def explain(host):
    """Every Signal with why it applies, as a list of _reason(), regardless of the
    Harmless marks."""
    host = normalise(host)
    found = []
    if host in METADATA:
        found.append(_reason("metadata", "metadata", "address of a cloud metadata service"))
    if is_address(host):
        found.append(_reason("raw-ip", "raw-ip", "IP address instead of a domain"))
        return found

    for entry, (category, source), regex in hand_watchlist().hits(host):
        more = {"source": source} if source else {}
        if regex:
            found.append(_reason(category, "watchlist-regex", f"Watchlist: pattern {entry}"
                                 + (f" ({source})" if source else ""), pattern=entry, **more))
        else:
            found.append(_reason(category, "watchlist", f"Watchlist: {entry}" + (f" ({source})" if source else ""),
                                 domain=entry, **more))
    # Known legitimate: no patterns, HaGeZi list hits do not count (for the domain
    # and below; an entry above it still counts for its neighbours). Exception: the
    # subdomains of a user-content domain (USER_CONTENT): their hits in the HaGeZi lists
    # always count, whichever Legitimate entry matches (also one of the Host, also
    # a more specific one); their pattern Signals do not. A regex Legitimate domain lifts only
    # the weak ones.
    if _user_content(host):
        found += _feed_signals(host)
    elif legitimate(host):
        pass
    elif legitimate_pattern(host):
        found += [r for r in _name_signals(host) if r["signal"] in STRONG]
    else:
        found += _name_signals(host)
    # except the blockchain pattern: no Legitimate domain lifts it, and nothing else does (ADR 0021)
    if BLOCKCHAIN.search(host):
        found.append(_reason("blockchain", "blockchain-pattern", "pattern of a blockchain RPC service"))
    return found


def _feed_signals(host):
    """The HaGeZi list hits for host, as a list of _reason(): the part of the
    name Signals that also counts under a user-content domain (USER_CONTENT), whichever
    Legitimate entry matches."""
    found = []
    hit = _feeds["threat-intelligence"].match(host)
    if hit:
        found.append(_reason("threat", "threat-feed", f"HaGeZi Threat Intelligence Feeds: {hit}", domain=hit))
    hit = _feeds["newly-registered"].match(host)
    if hit:
        found.append(_reason("young", "young-feed", f"newly registered (HaGeZi NRD): {hit}", domain=hit))
    return found


def _name_signals(host):
    """Signals from the HaGeZi lists and from patterns in the name, which Legitimate
    domains do not get, as a list of _reason(); the blockchain pattern is not one of them."""
    found = _feed_signals(host)
    reg = registrable(host)
    name = reg.split(".")[0]
    tld = reg.rsplit(".", 1)[-1]
    # Registry/vendor name in a foreign domain (npm-cache.com, pypi-get.com, npmjs.help)
    brand = next((b for b in BRANDS if b in re.split(r"[-_]", name) or name.startswith(b) or name.endswith(b)), None)
    if brand:
        found.append(_reason("lookalike", "brand", f"brand name {brand} in the foreign domain {reg}",
                             brand=brand, domain=reg))
    # Typo domains (npnjs.com), only for names of MIN_TYPO characters or more
    elif len(name) >= MIN_TYPO:
        for target in TYPO_TARGETS:
            if abs(len(target) - len(name)) <= 2:
                d = levenshtein(name, target, 2)
                if d <= 2:
                    found.append(_reason("lookalike", "typo", f"typo of {target} (distance {d})",
                                         target=target, distance=d))
                    break
    if tld in ODD_TLDS:
        found.append(_reason("tld", "tld", f"unusual TLD .{tld}", tld=tld))
    # Random-looking or very long labels (DNS exfil, generated domains)
    for label in host.split(".")[:-1]:
        if len(label) > 40 or (len(label) >= 20 and entropy(label) > 3.5) or re.fullmatch(r"[0-9a-f]{16,}", label):
            found.append(_reason("random-label", "random-label", f"random-looking or very long label {label[:63]}",
                                 label=label[:63]))
            break
    if len(host.split(".")) > 6:
        found.append(_reason("many-labels", "many-labels", "more than six labels"))
    return found


def classify(host):
    """Returns a sorted list of Signals; empty = nothing suspicious."""
    return sorted({r["signal"] for r in explain(host)})


def alerting(host, tags):
    """The Signals that raise an Alert: for harmless domains only those that
    do not depend on the name. Blocking still follows every Signal."""
    return sorted(set(tags) & STRUCTURAL) if harmless(normalise(host)) else list(tags)


def is_strong(tags):
    return bool(STRONG & set(tags))


def report(host):
    """For agentbox check-domain: every Signal with why it applies (its English text, and
    the code and parameters the Control Room words it from)."""
    host = normalise(host)
    quiet = harmless_hit(host)
    signals = [{"signal": r["signal"], "strong": r["signal"] in STRONG, "reason": r["reason"], "code": r["code"],
                "params": r["params"], "suppressed": bool(quiet) and r["signal"] not in STRUCTURAL}
               for r in explain(host)]
    legit = legitimate(host)
    legit_pattern = None if legit else legitimate_pattern(host)
    # harmless and legitimate: the entry that covers it, a domain or (*_regex) a pattern
    return {"domain": host, "signals": signals,
            "alert": any(not s["suppressed"] for s in signals),
            "strong": is_strong(s["signal"] for s in signals),
            "harmless": quiet[0] if quiet else None, "harmless_regex": bool(quiet and quiet[1]),
            "legitimate": legit or legit_pattern, "legitimate_regex": bool(legit_pattern), "feeds": feed_status()}


def lifts(domain):
    """For agentbox legitimate-add: what making domain (with its subdomains) legitimate would
    lift. The strong Signals from patterns and HaGeZi lists that domain itself has (also
    an entry above it; not the blockchain pattern, which stays), and entries of the
    Threat Intelligence list that are domain or a subdomain, also below a
    Legitimate domain of the Host (that one can go again, this would stay): the list is
    unfiltered. Nothing below a built-in one, which stays (also below a user-content
    domain: their hits keep counting, nothing lifts them). feed_present: whether the
    Threat Intelligence list exists (otherwise what is below cannot be checked)."""
    domain = normalise(domain)
    feed = _feeds["threat-intelligence"]
    if _within(domain, GENUINE):
        return {"domain": domain, "signals": [], "feed_entries": [], "feed_present": True}
    return {"domain": domain,
            "signals": sorted({r["signal"] for r in _name_signals(domain) if r["signal"] in STRONG}),
            "feed_entries": feed.below(domain, LIFTS_SHOWN),
            "feed_present": feed.current() is not None}


def constants():
    """For agentbox: the Watchlist categories ({category: strong}) and the
    built-in Legitimate domains."""
    return {"categories": {c: c in STRONG for c in CATEGORIES}, "genuine": sorted(GENUINE)}


def watchlist():
    """For agentbox watchlist: the Watchlist (each entry with category,
    whether it is strong, and source) and the state of the HaGeZi lists."""
    entries = hand_watchlist()
    return {"entries": [{"domain": d, "regex": None, "category": c, "strong": c in STRONG, "source": src}
                        for d, (c, src) in sorted(entries.domains.items())]
                       + [{"domain": None, "regex": p, "category": c, "strong": c in STRONG, "source": src}
                          for p, _, (c, src) in sorted(entries.patterns, key=lambda x: x[0])],
            "feeds": feed_status()}


def signals(hosts):
    """For agentbox (the preview of a regex Allowlist entry): each host's Signals and whether
    one is strong, and why the Watchlist cannot be read (then nothing a pattern matches gets
    through)."""
    out = {}
    for host in hosts:
        tags = classify(host)
        out[normalise(host)] = {"signals": tags, "strong": is_strong(tags)}
    return {"hosts": out, "watchlist_unreadable": watchlist_unreadable()}


