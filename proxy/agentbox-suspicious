FEED_STATUS = os.path.join(FEEDS_DIR, "status.json")

# --lifts names at most this many entries of the Threat Intelligence list
LIFTS_SHOWN = 5
# Do not depend on the name: they also apply to Legitimate domains and also raise Alerts
