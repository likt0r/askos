# The Control Room may only call agentbox. agentbox, called through sudo by agentbox-web, runs
# only the commands the Control Room uses and never --force (agentbox/cli.py,
# CONTROL_ROOM_COMMANDS); sudoers cannot pin them, as it joins the arguments, and the
# Control Room's --actor, which holds spaces, comes before the command.
agentbox-web ALL=(root) NOPASSWD: /usr/bin/agentbox
