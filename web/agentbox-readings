"""Host readings for the Control Room backend.

Loaded by agentbox-web (next to it in libexec, agentbox/paths.py), not a program of its own.
Everything is read without privileges, as the user agentbox-web:

  CPU load          /proc/stat (busy share between two samples), /proc/loadavg
  CPU temperature   hwmon k10temp, zenpower or coretemp (Tdie, Tctl or Package id 0)
  CPU power         powercap package zones (intel-rapl, also on AMD); current kernels
                    let only root read the energy counter, then it is unavailable
  Memory, swap      /proc/meminfo (used = MemTotal - MemAvailable)
  GPU               nvidia-smi: temperature, utilisation, memory, power draw
  NVMe temperature  hwmon nvme, the Composite sensor of each drive
  Memory per VM     resident memory of the VM's QEMU process (/proc/<pid>/status),
                    the number `virsh dommemstat` reports as rss

A reading that cannot be read has the value None and a reason in "unavailable"
(no-sensor, no-permission, not-supported, pending, failed); nothing is estimated.
"""
import collections
import csv
import math
import os
import re
import subprocess
import threading
import time

# Defaults until Settings make them configurable; a reading is over its threshold
# when it reaches it. None: no threshold.
THRESHOLDS = {
    "cpu_load": 90,     # %
    "cpu_temp": 85,     # °C, Ryzen 9 3900X: Tjmax 95
    "cpu_power": None,  # W
    "memory": 90,       # % used
    "swap": 50,         # % used
    "swap_activity": 10,  # MiB/s of pages swapped in and out
    "gpu_temp": 87,     # °C, TITAN RTX: target 84, max operating 89
    "gpu_load": 90,     # %
    "gpu_memory": 90,   # % used
    "gpu_power": None,  # W, the card's power limit comes with the reading
    "nvme_temp": 70,    # °C
}
UNITS = {"cpu_load": "%", "cpu_temp": "°C", "cpu_power": "W", "memory": "%", "swap": "%",
         "swap_activity": "MiB/s",
         "gpu_temp": "°C", "gpu_load": "%", "gpu_memory": "%", "gpu_power": "W", "nvme_temp": "°C"}

NVIDIA_QUERY = "index,name,temperature.gpu,utilization.gpu,memory.used,memory.total,power.draw,power.limit"
NVIDIA_TIMEOUT = 10
CPU_SENSORS = ("k10temp", "zenpower", "coretemp")  # hwmon names, first found wins
CPU_LABELS = ("Tdie", "Tctl", "Package id 0")      # preferred sensor within it
DOMAIN_PREFIX = "agentbox-"                        # libvirt domain of a VM (agentbox/registry.py)
VM_NAME = re.compile(r"[a-z][a-z0-9-]{1,15}")
KIB, MIB = 1024, 1024 * 1024


def _reason(err):
    if isinstance(err, PermissionError):
        return "no-permission"
    if isinstance(err, FileNotFoundError):
        return "no-sensor"
    return "failed"


def _read(path):
    with open(path) as f:
        return f.read().strip()


def _clean(text, limit=64):
    """Device names come from firmware and drivers: printable characters only."""
    return "".join(c for c in text if c.isprintable())[:limit].strip() or None


def reading(rid, kind, source, value=None, device=None, unavailable=None, **extra):
    r = {"id": rid, "kind": kind, "device": device, "source": source, "unit": UNITS[kind], "value": value}
    if value is None:
        r["unavailable"] = unavailable or "failed"
    r.update(extra)
    return r


def _gpu(index, what, device, value, **extra):
    """One GPU reading; value is a number or the reason it is unavailable."""
    rid, kind = f"gpu{index}.{what}", f"gpu_{what}"
    if isinstance(value, str):
        return reading(rid, kind, "nvidia-smi", device=device, unavailable=value, **extra)
    return reading(rid, kind, "nvidia-smi", round(value, 1), device=device, **extra)


def _domain(argv):
    """libvirt domain name from a QEMU command line (-name guest=<name>,...)."""
    try:
        value = argv[argv.index("-name") + 1]
    except (ValueError, IndexError):
        return None
    for part in value.split(","):
        if part.startswith("guest="):
            return part[len("guest="):]
    first = value.split(",")[0]
    return None if "=" in first else first


class Collector:
    """Reads one sample of all readings. Keeps the counters of the previous sample,
    because CPU load and power are differences between two samples."""

    def __init__(self, proc="/proc", sys="/sys", nvidia_smi="nvidia-smi"):
        self.proc, self.sys, self.nvidia_smi = proc, sys, nvidia_smi
        self.cpu_model = self._cpu_model()
        self._cpu = self._cpu_times()
        self._cpu_load = None
        self._energy = self._energy_now()
        self._cpu_power = None
        self._swap = None        # counters of the previous sample; the first sample has none
        self._page_size = os.sysconf("SC_PAGE_SIZE")
        self._gpus = []          # GPU indices nvidia-smi reported last time

    def sample(self):
        readings = [*self.cpu(), *self.memory(), *self.swap_activity(), *self.gpus(), *self.nvme()]
        for r in readings:
            limit = THRESHOLDS[r["kind"]]
            r["threshold"] = limit
            r["over"] = r["value"] is not None and limit is not None and r["value"] >= limit
        return {"time": round(time.time(), 3), "readings": readings, "vms": self.vms()}

    # --- CPU ---------------------------------------------------------------

    def _cpu_model(self):
        try:
            with open(f"{self.proc}/cpuinfo") as f:
                for line in f:
                    key, _, value = line.partition(":")
                    if key.strip() == "model name":
                        return _clean(value)
        except OSError:
            pass
        return None

    def _cpu_times(self):
        """(busy, total, number of CPUs) from /proc/stat, or the reason it cannot be read."""
        try:
            with open(f"{self.proc}/stat") as f:
                lines = f.read().splitlines()
            fields = lines[0].split()
            if fields[0] != "cpu":
                return "failed"
            # user nice system idle iowait irq softirq steal (guest is part of user)
            ticks = [int(x) for x in fields[1:9]]
        except OSError as e:
            return _reason(e)
        except (ValueError, IndexError):
            return "failed"
        cpus = sum(1 for line in lines if re.match(r"cpu\d", line))
        total = sum(ticks)
        return total - ticks[3] - (ticks[4] if len(ticks) > 4 else 0), total, cpus

    def cpu(self):
        model = self.cpu_model
        now, prev = self._cpu_times(), self._cpu
        if isinstance(now, str):
            load = reading("cpu.load", "cpu_load", "/proc/stat", device=model, unavailable=now)
        else:
            self._cpu = now
            if not isinstance(prev, str) and now[1] > prev[1]:
                busy = 100 * (now[0] - prev[0]) / (now[1] - prev[1])
                self._cpu_load = round(min(100.0, max(0.0, busy)), 1)
            # no ticks since the last sample: the last value stands
            load = reading("cpu.load", "cpu_load", "/proc/stat", self._cpu_load, device=model,
                           unavailable="pending", cpus=now[2], loadavg=self._loadavg())
        return [load, self._cpu_temp(), self._cpu_power_reading()]

    def _loadavg(self):
        try:
            return [float(x) for x in _read(f"{self.proc}/loadavg").split()[:3]]
        except (OSError, ValueError):
            return None

    def _hwmon(self):
        """[(directory, name)] of all hwmon devices, in kernel order."""
        base = f"{self.sys}/class/hwmon"
        try:
            names = os.listdir(base)
        except OSError:
            return []
        out = []
        for n in sorted(names, key=lambda n: (len(n), n)):
            d = os.path.join(base, n)
            try:
                out.append((d, _read(f"{d}/name")))
            except OSError:
                continue
        return out

    @staticmethod
    def _temp_labels(d):
        """{label: sensor number} of a hwmon device."""
        labels = {}
        try:
            files = os.listdir(d)
        except OSError:
            return labels
        for f in files:
            m = re.fullmatch(r"temp(\d+)_label", f)
            if m:
                try:
                    labels.setdefault(_read(os.path.join(d, f)), m.group(1))
                except OSError:
                    continue
        return labels

    @staticmethod
    def _temp(d, n):
        """Temperature of sensor n in °C, or the reason it cannot be read."""
        try:
            return round(int(_read(f"{d}/temp{n}_input")) / 1000, 1)
        except OSError as e:
            return _reason(e)
        except ValueError:
            return "failed"

    def _cpu_temp(self):
        hwmon = self._hwmon()
        for want in CPU_SENSORS:
            for d, name in hwmon:
                if name != want:
                    continue
                labels = self._temp_labels(d)
                label = next((label for label in CPU_LABELS if label in labels), None)
                value = self._temp(d, labels[label] if label else "1")
                source = f"{name}/{label or 'temp1'}"
                if isinstance(value, str):
                    return reading("cpu.temp", "cpu_temp", source, device=self.cpu_model, unavailable=value)
                return reading("cpu.temp", "cpu_temp", source, value, device=self.cpu_model)
        return reading("cpu.temp", "cpu_temp", "hwmon", device=self.cpu_model, unavailable="no-sensor")

    def _energy_now(self):
        """(monotonic time, [(µJ, wrap range µJ)] per package zone), or the reason it cannot be read."""
        base = f"{self.sys}/class/powercap"
        try:
            zones = sorted(z for z in os.listdir(base) if re.fullmatch(r"intel-rapl:\d+", z))
        except OSError:
            zones = []
        if not zones:
            return "no-sensor"
        counters = []
        for z in zones:
            try:
                uj = int(_read(f"{base}/{z}/energy_uj"))
            except OSError as e:
                return _reason(e)
            except ValueError:
                return "failed"
            try:
                wrap = int(_read(f"{base}/{z}/max_energy_range_uj"))
            except (OSError, ValueError):
                wrap = 0
            counters.append((uj, wrap))
        return time.monotonic(), counters

    def _cpu_power_reading(self):
        now, prev = self._energy_now(), self._energy
        source = "powercap/intel-rapl"
        if isinstance(now, str):
            self._energy = now
            return reading("cpu.power", "cpu_power", source, device=self.cpu_model, unavailable=now)
        self._energy = now
        if not isinstance(prev, str) and len(prev[1]) == len(now[1]) and now[0] > prev[0]:
            # the counter wraps at max_energy_range_uj
            uj = sum((u - p) % w if w else max(0, u - p) for (u, w), (p, _) in zip(now[1], prev[1]))
            self._cpu_power = round(uj / 1e6 / (now[0] - prev[0]), 1)
        else:
            self._cpu_power = None
        return reading("cpu.power", "cpu_power", source, self._cpu_power, device=self.cpu_model,
                       unavailable="pending")

    # --- Memory ------------------------------------------------------------

    def memory(self):
        source = "/proc/meminfo"
        try:
            info = {}
            with open(f"{self.proc}/meminfo") as f:
                for line in f:
                    key, _, rest = line.partition(":")
                    fields = rest.split()
                    if fields and fields[0].isdigit():
                        info[key] = int(fields[0]) * KIB
        except OSError as e:
            return [reading("memory", "memory", source, unavailable=_reason(e))]
        out = []
        total, available = info.get("MemTotal"), info.get("MemAvailable")
        if total and available is not None:
            used = total - available
            out.append(reading("memory", "memory", source, round(100 * used / total, 1),
                               used_bytes=used, total_bytes=total))
        else:
            out.append(reading("memory", "memory", source, unavailable="failed"))
        swap, free = info.get("SwapTotal"), info.get("SwapFree")
        if swap and free is not None:
            used = swap - free
            out.append(reading("swap", "swap", source, round(100 * used / swap, 1),
                               used_bytes=used, total_bytes=swap))
        return out

    def _swap_counts(self):
        """(pages in, pages out, time) from /proc/vmstat, or the reason it cannot be read."""
        try:
            counts = {}
            with open(f"{self.proc}/vmstat") as f:
                for line in f:
                    key, _, value = line.partition(" ")
                    if key in ("pswpin", "pswpout"):
                        counts[key] = int(value)
            return counts["pswpin"], counts["pswpout"], time.monotonic()
        except OSError as e:
            return _reason(e)
        except (KeyError, ValueError):
            return "failed"

    def swap_activity(self):
        """How fast pages move in and out of swap: the difference between two samples of the
        `pswpin` and `pswpout` counters. High swap use alone does not slow VMs down; a steady
        flow of pages does."""
        source = "/proc/vmstat"
        now, prev = self._swap_counts(), self._swap
        self._swap = now
        if isinstance(now, str):
            return [reading("swap_activity", "swap_activity", source, unavailable=now)]
        if prev is None or isinstance(prev, str) or now[2] <= prev[2] or now[0] < prev[0] or now[1] < prev[1]:
            # first sample, or the counters restarted
            return [reading("swap_activity", "swap_activity", source, unavailable="pending")]
        seconds = now[2] - prev[2]
        rate_in = (now[0] - prev[0]) * self._page_size / seconds
        rate_out = (now[1] - prev[1]) * self._page_size / seconds
        return [reading("swap_activity", "swap_activity", source, round((rate_in + rate_out) / MIB, 2),
                        in_bytes_per_second=round(rate_in), out_bytes_per_second=round(rate_out))]

    # --- GPU ---------------------------------------------------------------

    def gpus(self):
        try:
            r = subprocess.run([self.nvidia_smi, f"--query-gpu={NVIDIA_QUERY}", "--format=csv,noheader,nounits"],
                               stdin=subprocess.DEVNULL, capture_output=True, text=True, errors="replace",
                               timeout=NVIDIA_TIMEOUT)
            rows = self._nvidia_rows(r.stdout) if r.returncode == 0 else None
        except FileNotFoundError:
            return []            # no NVIDIA driver: no GPU readings
        except (OSError, subprocess.TimeoutExpired):
            rows = None
        if rows is None:
            return [reading(f"gpu{i}.{what}", f"gpu_{what}", "nvidia-smi", unavailable="failed")
                    for i in self._gpus or [0] for what in ("temp", "load", "memory", "power")]
        self._gpus = [row[0] for row in rows]
        out = []
        for i, name, temp, load, mem_used, mem_total, power, limit in rows:
            device = _clean(name)
            if isinstance(mem_used, str) or isinstance(mem_total, str) or not mem_total:
                memory = _gpu(i, "memory", device, mem_used if isinstance(mem_used, str) else "not-supported")
            else:
                memory = _gpu(i, "memory", device, 100 * mem_used / mem_total,
                              used_bytes=int(mem_used * MIB), total_bytes=int(mem_total * MIB))
            out += [_gpu(i, "temp", device, temp), _gpu(i, "load", device, load), memory,
                    _gpu(i, "power", device, power,
                         limit_watts=None if isinstance(limit, str) else round(limit, 1))]
        return out

    @staticmethod
    def _nvidia_rows(text):
        """[(index, name, values...)] from nvidia-smi's CSV; a value nvidia-smi cannot
        report (N/A, [Not Supported]) becomes "not-supported". None if malformed."""
        rows = []
        for fields in csv.reader(text.splitlines(), skipinitialspace=True):
            if not fields:
                continue
            if len(fields) != 8 or not fields[0].strip().isdigit():
                return None
            values = []
            for v in fields[2:]:
                v = v.strip()
                if v.startswith("[") or v in ("N/A", ""):
                    values.append("not-supported")
                    continue
                try:
                    number = float(v)
                except ValueError:
                    return None
                values.append(number if math.isfinite(number) else "failed")
            rows.append((int(fields[0]), fields[1], *values))
        return rows

    # --- NVMe --------------------------------------------------------------

    def nvme(self):
        out = []
        for d, name in self._hwmon():
            if name != "nvme":
                continue
            drive = os.path.basename(os.path.realpath(f"{d}/device"))
            if not re.fullmatch(r"nvme\d+", drive):
                drive = os.path.basename(d)
            try:
                model = _clean(_read(f"{d}/device/model"))
            except OSError:
                model = None
            labels = self._temp_labels(d)
            label = "Composite" if "Composite" in labels else "temp1"
            value = self._temp(d, labels.get("Composite", "1"))
            source = f"{drive}/{label}"
            if isinstance(value, str):
                out.append(reading(f"{drive}.temp", "nvme_temp", source, device=model or drive,
                                   unavailable=value))
            else:
                out.append(reading(f"{drive}.temp", "nvme_temp", source, value, device=model or drive))
        return out

    # --- Memory per VM -----------------------------------------------------

    def vms(self):
        """{vm: {"memory_bytes": n}} for every running VM (paused VMs have no QEMU process)."""
        out = {}
        try:
            pids = [p for p in os.listdir(self.proc) if p.isdigit()]
        except OSError:
            return out
        for pid in pids:
            d = f"{self.proc}/{pid}"
            try:
                if not _read(f"{d}/comm").startswith("qemu"):
                    continue
                with open(f"{d}/cmdline", "rb") as f:
                    argv = f.read().decode(errors="replace").split("\0")
                name = _domain(argv) or ""
                vm = name[len(DOMAIN_PREFIX):] if name.startswith(DOMAIN_PREFIX) else ""
                if not VM_NAME.fullmatch(vm):
                    continue
                with open(f"{d}/status") as f:
                    rss = next(int(line.split()[1]) for line in f if line.startswith("VmRSS:"))
            except (OSError, ValueError, IndexError, StopIteration):
                continue     # process ended meanwhile, or a kernel thread
            out[vm] = {"memory_bytes": rss * KIB}
        return dict(sorted(out.items()))


class Sampler:
    """Takes a sample every `interval` seconds in a background thread, keeps `window`
    seconds of them as history and hands each new sample to `publish`."""

    def __init__(self, collector, interval, window, publish, log):
        self.collector, self.interval, self.window = collector, interval, window
        self._publish, self._log = publish, log
        self._lock = threading.Lock()
        self._latest = None
        self._history = collections.deque(maxlen=math.ceil(window / interval) + 1)

    def start(self):
        threading.Thread(target=self._run, name="host-readings", daemon=True).start()

    def _run(self):
        due = time.monotonic() + min(self.interval, 1)
        failing = False
        while True:
            time.sleep(max(0.0, due - time.monotonic()))
            due = max(due + self.interval, time.monotonic())   # no burst after a slow sample
            try:
                sample = self.collector.sample()
            except Exception as e:   # a bug in one source must not end the readings for good
                if not failing:
                    self._log(f"host readings failed: {e!r}")
                failing = True
                continue
            failing = False
            entry = {"time": sample["time"], "values": {r["id"]: r["value"] for r in sample["readings"]},
                     "vms": {vm: v["memory_bytes"] for vm, v in sample["vms"].items()}}
            with self._lock:
                self._latest = sample
                self._history.append(entry)
                while self._history and self._history[0]["time"] < sample["time"] - self.window:
                    self._history.popleft()
            self._publish(sample)

    def snapshot(self):
        """Current readings, thresholds and history, as GET /api/host returns them."""
        with self._lock:
            latest, history = self._latest, list(self._history)
        return {"interval": self.interval, "history_seconds": self.window, "thresholds": dict(THRESHOLDS),
                "time": latest["time"] if latest else None,
                "readings": latest["readings"] if latest else [],
                "vms": latest["vms"] if latest else {},
                "history": history}
