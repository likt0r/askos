# Filter der Aktivitaet (Query-Parameter) -> Option von `agentbox activity`;
# wie bei logs immer als --option=wert, agentbox prueft die Werte
ACTIVITY_FILTERS = {"kind": "--kind", "vm": "--vm", "since": "--since", "until": "--until",
                    "search": "--search", "lines": "--lines"}


def query_options(query, filters):
    """Query-Parameter -> Optionen (--option=wert) nach `filters`; andere Parameter
    zaehlen nicht. ValueError, wenn einer doppelt kommt."""
    try:
        params = parse_qs(query, max_num_fields=len(filters) * 2)
    except ValueError:
        raise ValueError("too many parameters")
    args = []
    for key, opt in filters.items():
        values = params.get(key, [])
        if len(values) > 1:
            raise ValueError(f"give {key} only once")
        if not values or not values[0].strip():       # leer = kein Filter
            continue
        # Suchtext unveraendert (Leerzeichen koennen gemeint sein), sonst getrimmt
        args.append(f"{opt}={values[0] if key == 'search' else values[0].strip()}")
    return args


def activity(query):
    """GET /api/activity?kind=..&vm=..&since=..&until=..&search=..&lines=..: Zeitleiste."""
    try:
        args = query_options(query, ACTIVITY_FILTERS)
    except ValueError as e:
        return False, str(e)
    return agentbox("activity", *args, "--json", timeout=120)


