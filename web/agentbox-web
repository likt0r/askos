# Chrome und Safari, Android auch Linux)
BROWSERS = (("Edg/", "Edge"), ("OPR/", "Opera"), ("FxiOS/", "Firefox"), ("Firefox/", "Firefox"),
            ("CriOS/", "Chrome"), ("Chrome/", "Chrome"), ("Safari/", "Safari"), ("curl/", "curl"))
SYSTEMS = (("Android", "Android"), ("iPhone", "iPhone"), ("iPad", "iPad"), ("Windows", "Windows"),
           ("Macintosh", "macOS"), ("CrOS", "ChromeOS"), ("Linux", "Linux"))


def device(user_agent):
    """Kurzbeschreibung des Geraets aus dem User-Agent, z. B. Firefox/Linux. Nur
    feste Namen, nie Text aus der Anfrage."""
    browser = next((name for key, name in BROWSERS if key in user_agent), None)
    system = next((name for key, name in SYSTEMS if key in user_agent), None)
    return "/".join(n for n in (browser, system) if n) or "unknown device"


# Sign-ins and sign-outs in Activity, as agentbox records its entries (agentbox/activity.py):
# the action is the entry's code (AGENTBOX_CODE), from which the UI words it; the English
# description is the fallback. No parameters: address and device are fields of their own.
SIGN_INS = {"signin": ("ok", "Signed in"), "signin.failed": ("failed", "Sign-in with a wrong password"),
            "signin.locked": ("failed", "Sign-in refused: too many failed attempts"),
            "signout": ("ok", "Signed out")}


def signin_activity(handler, action):
    """A sign-in or sign-out in Activity (SIGN_INS): outcome, address and device, never the
    password."""
    outcome, description = SIGN_INS[action]
    actor, ip = handler.actor(), handler.ip()
    entry = journal.encode({
        "MESSAGE": f"- {action} {outcome} ({actor}): {description}",
        "PRIORITY": "5" if outcome == "ok" else "4", "SYSLOG_IDENTIFIER": "agentbox-activity",
        "AGENTBOX_KIND": "signin", "AGENTBOX_ACTION": action, "AGENTBOX_CODE": action,
        "AGENTBOX_OUTCOME": outcome, "AGENTBOX_ACTOR": actor, "AGENTBOX_DESCRIPTION": description,
        "AGENTBOX_ADDRESS": ip, "AGENTBOX_DEVICE": device(handler.headers.get("User-Agent", ""))})
    # without a journal only a note in this service's log; also when the first (the namespace of
    # Activity) does not let this service write, and then nowhere else: sign-ins belong there
    sent = journal.send(entry, JOURNAL)
    if sent == journal.REFUSED:
        log("Activity not recorded in the journal: no permission to write "
            "(group agentbox-journal; run agentbox setup again)")
    elif sent != journal.SENT:
        log("Activity not recorded in the journal")


# --- Passwort ---------------------------------------------------------------

def scrypt(password, salt, n=2**15, r=8, p=1):
    return hashlib.scrypt(password.encode(), salt=salt, n=n, r=r, p=p, maxmem=64 * 1024 * 1024)


def make_hash(password):
    salt = secrets.token_bytes(16)
    return f"scrypt$32768$8$1${salt.hex()}${scrypt(password, salt).hex()}"


def setting(key):
    """A value of the Settings as agentbox reads them (settings.load(); the file is world-readable),
    read anew each time: session_hours at every sign-in, default_language for GET and POST /session,
    which the UI needs after signing in without GET /settings (a call of agentbox with sudo); a
    missing file is the defaults. A file agentbox refuses is never replaced by the defaults (they
    can be wider than what the owner set, such as longer sessions): the request is answered 503
    settings_unreadable, the reason goes into the log, and the service ends once that answer is
    sent (Server.process_request_thread), with CONFIG_REFUSED as at the start."""
    try:
        return settings.load()[key]
    except Fail as f:
        log(f"Settings {f.message}; the Control Room stops")
        request.settings_refused = True
        raise ApiError(503, "settings_unreadable", "The Settings on the Host cannot be read; the Control Room "
                                                   "stopped until they are fixed there", detail=f.message,
                       headers=[("Connection", "close")])


def check_password(password):
    try:
        with open(f"{CONF}/password") as f:
            _, n, r, p, salt, digest = f.read().strip().split("$")
    except (OSError, ValueError):
        return False
    got = scrypt(password, bytes.fromhex(salt), int(n), int(r), int(p))
    return hmac.compare_digest(got.hex(), digest)


