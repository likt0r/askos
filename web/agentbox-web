# Token und Schluessel gehen nur ueber stdin an agentbox, nie als Argument, und
# kommen in keiner Antwort, keinem Log und keiner Fehlermeldung vor.

TOKEN_FILTERS = {"since": "--since", "until": "--until", "lines": "--lines"}
APP_ID = re.compile(r"[1-9][0-9]{0,11}")
# Aktion -> Felder des Bodys, die ein Geheimnis tragen
SECRET_FIELDS = {"claude-token": ("token",), "github-app": ("private_key",)}


def scrub(text, action, body):
    """Text ohne das, was die Aktion als Geheimnis bekam: als Ganzes, ohne
    Leerraum (so speichert agentbox ein Token) und Zeile fuer Zeile (PEM).
    agentbox gibt es nie aus; das hier haelt es auch dann aus Antwort und Log."""
    for name in SECRET_FIELDS.get(action, ()):
        v = body.get(name)
        if not isinstance(v, str):
            continue
        parts = {v.strip(), "".join(v.split()), *(line.strip() for line in v.splitlines())}
        for part in sorted((p for p in parts if len(p) >= 16), key=len, reverse=True):
            text = text.replace(part, "[hidden]")
    return text


def github_tokens(ctx, query):
    """GET /api/<vm>/github-tokens?since=..&until=..&lines=..: Repos mit Tokens, Ablehnungen."""
    try:
        args = query_options(query, TOKEN_FILTERS)
    except ValueError as e:
        return False, str(e)
    return agentbox("github-tokens", ctx, *args, "--json", timeout=120)


def claude_token(ctx, body):
    """Claude-Token setzen; agentbox prueft es bei Anthropic, bevor es das alte ersetzt."""
    token = body.get("token")
    if not isinstance(token, str) or not token.strip():
        raise ValueError("token is missing or not text")
    return agentbox("set-claude-token", ctx, "--no-prompt", stdin=token, timeout=120)


def set_owners(ctx, body):
    owners = body.get("owners")
    if not isinstance(owners, list) or not all(isinstance(o, str) for o in owners):
        raise ValueError("owners must be a list of names")
    names = [o.strip() for o in owners if o.strip()]
    # GitHub-Namen beginnen nie mit "-": so wird keiner zur Option
    if any(n.startswith("-") for n in names):
        raise ValueError("invalid GitHub name")
    return agentbox("set-owners", ctx, *names)


def set_github_app(body):
    """POST /api/github-app {"app_id": .., "private_key": ".pem"}: App-ID und Schluessel
    ersetzen; agentbox prueft beides vorher bei GitHub."""
    app_id = body.get("app_id")
    if isinstance(app_id, bool) or not isinstance(app_id, (str, int)) or not APP_ID.fullmatch(str(app_id).strip()):
        raise ValueError("app_id must be a number")
    key = body.get("private_key")
    if not isinstance(key, str) or not key.strip():
        raise ValueError("private_key is missing or not text")
    return agentbox("set-github-app", str(app_id).strip(), "--no-prompt", "--json", stdin=key, timeout=120)


def domain(body):
    """Domain aus dem Body; agentbox prueft sie. Nie etwas, das wie eine Option aussieht."""
    d = body.get("domain")
    if not isinstance(d, str) or not d.strip() or d.strip().startswith("-"):
        raise ValueError("domain is missing or invalid")
    return d.strip().lower()


def mark_seen(ctx, body):
    """Alle Alerts der VM, oder mit domain die zu einem Ziel, als gesehen markieren."""
    if body.get("domain") in (None, ""):
        return agentbox("mark-seen", ctx)
    return agentbox("mark-seen", ctx, domain(body))


# Allowlist. ctx ist eine VM oder "all" (alle VMs); agentbox prueft beides.
# Dauer ("duration") einer Freigabe -> Option von agentbox allow/extend: ohne
# Dauer (null oder "permanent") dauerhaft, "default" die voreingestellte Dauer
# voruebergehender Freigaben. --force gibt der Leitstand nie mit: stark
# verdaechtige Ziele gibt nur die Kommandozeile frei.
DURATIONS = ("15min", "1h", "8h", "7d")


def duration(body, temporary_only=False):
    d = body.get("duration")
    if d in DURATIONS:
        return [f"--for={d}"]
    if not temporary_only and d in (None, "permanent"):
        return []
    if not temporary_only and d == "default":
        return ["--temporary"]
    raise ValueError("duration must be " + ("" if temporary_only else "permanent, default, ") + "15min, 1h, 8h or 7d")


def note(body, required=False):
    """Notiz als --note=wert (wird so nie zur eigenen Option); agentbox prueft sie."""
    n = body.get("note")
    if n is None and not required:
        return []
    if not isinstance(n, str):
        raise ValueError("note must be text")
    return [f"--note={n}"]


def allow(ctx, body):
    """Freigabe fuer eine VM oder alle, dauerhaft oder auf Zeit, mit Notiz; auch aus
    der Liste der blockierten Ziele einer VM."""
    return agentbox("allow", ctx, domain(body), *duration(body), *note(body))


def allowlist_entries(query):
    """GET /api/allowlist?vm=..: alle Freigaben oder die, die fuer eine VM gelten
    (vm=all: die fuer alle VMs), mit Restzeit und Nutzung der letzten 24 Stunden."""
    try:
        params = parse_qs(query, max_num_fields=2)
    except ValueError:
        return False, "too many parameters"
    values = params.get("vm", [])
    if len(values) > 1:
        return False, "give vm only once"
    vm = values[0].strip() if values else ""
    if vm and not VM_NAME.fullmatch(vm):
        return False, f"No such VM: {vm[:40]}"
    return agentbox("allowlist", *([vm] if vm else []), "--json", timeout=120)


