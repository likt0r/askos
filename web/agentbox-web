def setting_text(key, value):
    """Ein Wert als Text fuer agentbox set-settings: Text oder Zahl, bei BOOL_SETTINGS auch true
    oder false; None fuer alles andere."""
    if isinstance(value, bool):
        return ("true" if value else "false") if key in BOOL_SETTINGS else None
    return str(value) if isinstance(value, (str, int)) else None


def set_settings(body):
    """POST /api/settings {schluessel: wert, ...}: nur bekannte Schluessel, Werte Text oder Zahl
    (auto_update auch true/false; "default" fuer den Standard); agentbox prueft sie und speichert
    alles oder nichts."""
    if not body:
        raise ValueError("no setting given")
    args = []
    for key, value in body.items():
        if key not in SETTING_KEYS:
            raise ValueError(f"unknown setting: {str(key)[:40]}")
        if setting_text(key, value) is None:
            raise ValueError(f"{key}: text or a number expected")
        args.append(f"{key}={setting_text(key, value)}")
    return agentbox("set-settings", *args, "--json", timeout=120)


# --- Images und Builds ----------------------------------------------------------
# Live-Fortschritt eines Builds: die Oberflaeche fragt GET /api/images/<image>/log mit
# after_cursor alle paar Sekunden nach neuen Zeilen, solange GET /api/images ihn als
# laufend zeigt. Ein build-Ereignis im SSE-Strom braeuchte einen Dienst, der als root das
# Journal verfolgt (agentbox watch, geplant); dieser Dienst darf es nicht lesen.

IMAGE_NAME = re.compile(r"[a-z0-9][a-z0-9-]{0,31}")          # wie agentbox/settings.py
BUILD_ID = re.compile(r"[0-9]{8}(-[0-9]{4}([0-9]{2})?)?")    # wie agentbox/images.py
BUILD_LOG_FILTERS = {"after_cursor": "--after-cursor", "lines": "--lines"}


def build_log(image, query):
    """GET /api/images/<image>/log?build=..&after_cursor=..&lines=..: Protokoll eines Builds
    (ohne build: der laufende, sonst der neueste); agentbox prueft die Werte."""
    try:
        builds = parse_qs(query, max_num_fields=6).get("build", [])
        args = query_options(query, BUILD_LOG_FILTERS)
    except ValueError as e:
        return False, str(e)
    if len(builds) > 1:
        return False, "give build only once"
    build = builds[0].strip() if builds else ""
    if build and not BUILD_ID.fullmatch(build):
        return False, f"invalid Build: {build[:40]}"
    return agentbox("build-log", image, *([build] if build else []), *args, "--json", timeout=60)


def start_build(body):
    """POST /api/build {"image": "<image>"|"all"}: Build aus dem installierten Release starten (Unit)."""
    image = body.get("image")
    if image == "all":
        return agentbox("build", "--all", "--json", timeout=60)
    if not isinstance(image, str) or not IMAGE_NAME.fullmatch(image):
        raise ValueError("image must be the name of an Image or all")
    return agentbox("build", image, "--json", timeout=60)


def set_image(ctx, body):
    """POST /api/<vm>/set-image {"image": .., "build": null|"<build>"}: Image der VM und
    optional ein frueherer Build; gilt ab dem naechsten Reset."""
    image, build = body.get("image"), body.get("build")
    if not isinstance(image, str) or not IMAGE_NAME.fullmatch(image):
        raise ValueError("image is missing or invalid")
    if build is not None and (not isinstance(build, str) or not BUILD_ID.fullmatch(build)):
        raise ValueError("build must be null or a Build")
    return agentbox("set-image", ctx, image, *([f"--build={build}"] if build else []), "--json")


