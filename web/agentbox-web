# Reihenfolge der Zustands-Ereignisse fuer eine neue Verbindung (nach hello)
LATEST_ORDER = ("host", "version", "watch", "state", "host-reboot", "services")
RETRY_MS = 3000         # Wartezeit des Browsers vor dem Neuverbinden
