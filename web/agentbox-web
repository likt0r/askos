def cli_error(stderr):
    """The failure agentbox reported with --json, as (code, message, params), else None:
    the last line of stderr that is such a JSON object. Programs agentbox ran may have
    written lines before it."""
    for line in reversed(stderr.splitlines()):
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            said = json.loads(line)
        except ValueError:
            continue
        if isinstance(said, dict) and isinstance(said.get("error"), str) and isinstance(said.get("message"), str):
            params = said.get("params")
            return said["error"], said["message"], params if isinstance(params, dict) else {}
    return None


def agentbox_failure(exit_code, stderr, stdout="", secrets_in=()):
    """ApiError for a failed call of agentbox: the code from its --json failure on stderr
    (one the table does not know is action_failed); without one, sudo's own refusal, else by
    exit code. detail is agentbox's message without the request's secrets; field comes from
    the parameters."""
    said = cli_error(stderr)
    if said:
        error, text, params = said
        if error not in AGENTBOX_ERRORS:
            error = "action_failed"
    else:
        text, params = (stderr.strip() or stdout.strip()).removeprefix("agentbox: "), {}
        error = "sudo_failed" if text.startswith("sudo: ") else AGENTBOX_EXITS.get(exit_code, "action_failed")
    detail = hide(text, secrets_in).strip()[:500] or None
    return refused(error, detail, field=error_field(error, params), params=error_params(error, params))


def refused(code, detail=None, field=None, params=None):
    """ApiError of one of agentbox's codes, with its status and message from AGENTBOX_ERRORS: a
    refusal of agentbox, or one of its checks made here before any call."""
    status, message = AGENTBOX_ERRORS[code]
    return ApiError(status, code, message, detail, field=field, params=params)


# The parameters of agentbox's refusals that the UI words them with (docs/control-room-api.md),
# each passed on only in the form agentbox gives it: which rule a Regex entry's pattern breaks,
# the host of the breadth check's sample it matches
ERROR_PARAMS = {"invalid_pattern": {"reason": re.compile(r"[a-z][a-z-]{0,39}").fullmatch},
                "pattern_too_broad": {"host": re.compile(r"[a-z0-9][a-z0-9.-]{0,252}").fullmatch},
                # the VM variable refused, as agentbox names it
                "env_name_reserved": {"name": vmenv.is_name},
                "invalid_env_value": {"name": vmenv.is_name},
                "env_too_large": {"name": vmenv.is_name}}


def error_params(error, params):
    wanted = ERROR_PARAMS.get(error, {})
    return {k: v for k, v in params.items() if k in wanted and isinstance(v, str) and wanted[k](v)} or None


def error_field(error, params):
    """The request field a refusal is about: the setting an invalid_setting names (only a
    known key), memory_mib for invalid_memory, days for invalid_cleanup_days, env for a refused
    VM variable."""
    if error == "invalid_setting":
        key = params.get("setting")
        return key if isinstance(key, str) and key in SETTING_KEYS else None
    if error == "invalid_memory":
        return "memory_mib"
    if error == "invalid_cleanup_days":
        return "days"
    if error in ("invalid_env_name", "env_name_reserved", "invalid_env_value", "env_too_large"):
        return "env"
    return None


def run(command, *args, stdin=None, timeout=120, secrets_in=()):
    """agentbox <command> with --actor right after it (the sudoers rule pins the first
    argument to the Control Room's commands); its output (stdout) or ApiError. Every call
    passes --json, so a failure names its code. secrets_in: values that never go back in an
    error."""
    actor = getattr(request, "actor", None)
    argv = [*AGENTBOX, command, *([f"--actor={actor}"] if actor else []), *args]
    try:
        r = subprocess.run(argv, input=stdin, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        raise ApiError(504, "timeout", "The action did not finish in time")
    if r.returncode != 0:
        raise agentbox_failure(r.returncode, r.stderr, r.stdout, secrets_in)
    return r.stdout


def run_json(*args, **kw):
    out = run(*args, **kw)
    try:
        return json.loads(out or "null")
    except ValueError:
        raise ApiError(502, "bad_agentbox_answer", "Unreadable answer from agentbox")


def hide(text, values):
    """The text without these secrets: each whole, without whitespace (as agentbox stores a
    token) and line by line (a PEM key), so an echo in any of these forms is hidden."""
    for v in values:
        if not isinstance(v, str):
            continue
        parts = {v.strip(), "".join(v.split()), *(line.strip() for line in v.splitlines())}
        for part in sorted((p for p in parts if len(p) >= 16), key=len, reverse=True):
            text = text.replace(part, "[hidden]")
    return text


# --- Werte aus Anfragen ---

def value(body, key, required=False):
    """Text oder ganze Zahl als getrimmter Text; None, wenn er fehlt (oder leer ist)."""
    v = body.get(key)
    if v is None or v == "":
        if required:
            raise invalid(key, f"{key} is missing")
        return None
    if isinstance(v, bool) or not isinstance(v, (str, int)):
        raise invalid(key, f"{key} must be text or a whole number")
    v = str(v).strip()
    if not v and required:
        raise invalid(key, f"{key} is missing")
    return v or None


def word(body, key, required=True):
    """Ein Wert, der als Argument steht (Domain, Geraet, ...): nie etwas wie eine Option."""
    v = value(body, key, required)
    if v is not None and v.startswith("-"):
        raise invalid(key, f"invalid {key}")
    return v


def names(body, key):
    v = body.get(key)
    if v is None:
        return []
    if not isinstance(v, list) or not all(isinstance(o, str) for o in v):
        raise invalid(key, f"{key} must be a list of names")
    out = [o.strip() for o in v if o.strip()]
    if any(o.startswith("-") for o in out):
        raise invalid(key, f"invalid name in {key}")
    return out


def confirm(body, wanted, code="confirmation_required", message=None):
    """That the body confirms with confirm: wanted (the VM's name, or true), else 400 with code
    and its message from AGENTBOX_ERRORS unless another is given."""
    given = body.get("confirm")
    if type(given) is not type(wanted) or given != wanted:
        raise ApiError(400, code, message or AGENTBOX_ERRORS[code][1], field="confirm")


def path_word(v, what):
    v = unquote(v)
    if not v or v.startswith("-") or not v.isprintable() or "/" in v:
        raise ApiError(400, "invalid_field", f"Invalid {what}", field=what)
    return v


ONCE = "Each query parameter may appear once"


def query(url, limit, too_many=ONCE):
    """The query's parameters ({name: [values]}); invalid_query with too_many as its message when
    there are more than limit."""
    try:
        return parse_qs(url.query, max_num_fields=limit)
    except ValueError:
        raise ApiError(400, "invalid_query", too_many)


def once(params, key, field=None):
    """The one value of a query parameter, None without it; invalid_query when it comes twice."""
    values = params.get(key, [])
    if len(values) > 1:
        raise ApiError(400, "invalid_query", ONCE, field=field)
    return values[0] if values else None


def query_value(url, key):
    return once(query(url, 8, "Too many query parameters"), key, field=key)


def options(url, filters):
    """Query parameters -> --option=value after `filters`; other parameters do not count."""
    params = query(url, len(filters) * 2)
    args = []
    for key, opt in filters.items():
        v = once(params, key)
        if v is None or not v.strip():       # empty: no filter
            continue
        # the search text as given (spaces may be meant), everything else trimmed
        args.append(f"{opt}={v if key == 'search' else v.strip()}")
    return args


DURATIONS = settings.ENTRY_DURATIONS


def duration_args(body, temporary_only=False):
    d = body.get("duration")
    if d in DURATIONS:
        return [f"--for={d}"]
    if not temporary_only and d in (None, "permanent"):
        return []
    if not temporary_only and d == "default":
        return ["--temporary"]
    raise invalid("duration", "duration must be " + ("" if temporary_only else "permanent, default, ")
                  + ", ".join(DURATIONS[:-1]) + " or " + DURATIONS[-1])


def text_args(body, key, required=False):
    """--key=value of a text field (a note, the source of a Watchlist entry), [] without one
    unless it is required."""
    v = body.get(key)
    if v is None and not required:
        return []
    if not isinstance(v, str):
        raise invalid(key, f"{key} must be text")
    return [f"--{key}={v}"]


# --- Endpunkte ---
# Jeder bekommt (handler, Pfad-Teile, url, body) und gibt (Status, Objekt) zurueck.

ROUTES = []


def route(method, pattern, secret=(), public=False):
    """secret: Felder des Bodys, die Geheimnisse tragen (nie in Antwort, Fehler oder Log);
    public: ohne Anmeldung erreichbar."""
    def add(fn):
        ROUTES.append((method, re.compile("/api/v1" + pattern), fn, secret, public))
        return fn
    return add


