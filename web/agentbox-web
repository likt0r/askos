@route("PATCH", "/settings")
def patch_settings(h, m, url, body):
    if not body:
        raise ApiError(400, "invalid_field", "No setting given")
    args = []
    for key, v in body.items():
        if key not in SETTING_KEYS:
            raise ApiError(400, "unknown_setting", "Unknown setting", field=str(key)[:40])
        if setting_text(key, v) is None:
            raise invalid(key, f"{key} must be " + ("true or false" if key in BOOL_SETTINGS
                                                     else "text or a whole number"))
        args.append(f"{key}={setting_text(key, v)}")
    return 200, run_json("set-settings", *args, "--json", timeout=120)


def v1(handler, method, url):
    """Eine Anfrage an /api/v1/...: CSRF, Route, Anmeldung, Endpunkt, Fehlerformat."""
    path = url.path
    status, result, extra, code = 500, None, [], None
    name, vm, secret, body, read = "-", None, (), {}, method == "GET"
    try:
        # Schutz gegen Cross-Site-Requests wie in der alten API: nur das eigene JS setzt
        # diesen Header; ohne ihn wird der Body nicht gelesen
        if method != "GET" and handler.headers.get("X-Agentbox") != "1":
            raise ApiError(403, "csrf_header_missing", "Requests that change something need the header "
                                                       "X-Agentbox: 1")
        found, allowed = None, []
        for r_method, pattern, fn, secret_fields, public in ROUTES:
            match = pattern.fullmatch(path)
            if match:
                allowed.append(r_method)
                if r_method == method:
                    found = (match, fn, secret_fields, public)
        if not found and not handler.session() and not (path == "/api/v1/session"):
            raise ApiError(401, "unauthenticated", "Not signed in")
        if not found and allowed:
            raise ApiError(405, "method_not_allowed", "Method not allowed", headers=[("Allow", ", ".join(allowed))])
        if not found:
            raise ApiError(404, "not_found", "Not found")
        match, fn, secret, public = found
        name, vm = fn.__name__, match.groupdict().get("vm")
        if not public and not handler.session():
            raise ApiError(401, "unauthenticated", "Not signed in")
        if method != "GET":
            try:
                too_big = int(handler.headers.get("Content-Length") or 0) > MAX_BODY
            except ValueError:
                too_big = True
            if too_big:
                raise ApiError(413, "body_too_large", "The body must be a JSON object of at most 8 KiB")
            read = True
            try:
                body = handler.body()
            except (ValueError, json.JSONDecodeError):
                raise ApiError(400, "invalid_body", "The body must be a JSON object of at most 8 KiB")
        answer = fn(handler, match, url, body)
        if answer is None:              # der Endpunkt hat selbst geantwortet (events)
            return
        status, result, *rest = answer
        extra = rest[0] if rest else []
    except ApiError as e:
        status, code, extra = e.status, e.code, list(e.headers)
        detail = hide(e.detail, [body.get(f) for f in secret]) if e.detail and secret else e.detail
        result = api_error(e.code, e.message, detail, e.field, e.params)
    except Exception as e:              # ein Fehler hier darf keine Antwort ohne Format geben
        log(f"{handler.ip()}: v1 {method} {name}: internal error {type(e).__name__}")
        status, code, result = 500, "internal_error", api_error("internal_error", "Internal error")
    if not read and status != 403:
        # eine fruehe Antwort (401, 404, ...): den Body trotzdem abnehmen, sonst sieht der
        # Browser statt der Antwort einen Verbindungsabbruch
        handler.drain()
    # eigenes Log wie bisher: Aenderungen und Fehler, nie Inhalte (Codes, Tokens, Schluessel)
    if method != "GET" or status >= 500:
        log(f"{handler.ip()}: {vm or '-'} v1 {method} {name} -> {'ok' if status < 400 else 'FAILED'}"
            + (f" {code}" if code else ""))
    return handler.send_json(status, result, extra=extra)


def main():
    if sys.argv[1:] == ["--hash-password"]:
        pw = sys.stdin.readline().rstrip("\n")
        if len(pw) < 16:
            sys.exit("the password needs at least 16 characters")
        print(make_hash(pw))
        return
    bind, port = bind_port()
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    ctx.minimum_version = ssl.TLSVersion.TLSv1_2
    ctx.load_cert_chain(f"{CONF}/cert.pem", f"{CONF}/key.pem")
    httpd = Server((bind, port), Handler, ctx)
    start_readings()
    ui.start()
    watcher.start()
    # der gebundene Port: mit AGENTBOX_WEB_PORT=0 waehlt ihn der Kernel (Tests lesen ihn hier)
    log(f"Control Room running on https://{bind}:{httpd.server_address[1]}")
    httpd.serve_forever()


if __name__ == "__main__":
    main()
