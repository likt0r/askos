def host_setup():
    """(bind, port) aus dem Host setup. Dasselbe liest agentbox/hostsetup.py und prueft
    es vollstaendig (`agentbox regenerate`); dieser Dienst laeuft ohne das Paket und
    prueft nur, was er braucht. Eine kaputte Datei beendet den Dienst, statt zu raten:
    eine falsche Adresse koennte mehr freigeben, als der Owner gewaehlt hat."""
    try:
        with open(HOST_SETUP) as f:
            raw = json.load(f)
    except FileNotFoundError:
        raw = {}
    except (OSError, ValueError) as e:
        sys.exit(f"Host setup {HOST_SETUP} unreadable: {e}")
    if not isinstance(raw, dict):
        sys.exit(f"Host setup {HOST_SETUP}: must be a JSON object")
    mode, bind, port = raw.get("mode", "local"), raw.get("bind", "127.0.0.1"), raw.get("web_port", 8800)
    try:
        address = ipaddress.IPv4Address(bind)
    except ValueError:
        sys.exit(f"Host setup {HOST_SETUP}: bind is not an IPv4 address: {bind!r}")
    if mode not in ("local", "network") or isinstance(port, bool) or not isinstance(port, int) or not 1 <= port <= 65535:
        sys.exit(f"Host setup {HOST_SETUP}: invalid mode or web_port")
    if mode == "local" and not address.is_loopback:
        sys.exit(f"Host setup {HOST_SETUP}: in mode local, bind must be a loopback address")
    return bind, port


