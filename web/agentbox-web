# --- HTTP -------------------------------------------------------------------

class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "agentbox-web"
    sys_version = ""
    timeout = 30

    def log_message(self, fmt, *args):
        pass  # eigenes Logging: nur Anmeldungen und Aktionen

    def ip(self):
        return self.client_address[0]

    def actor(self):
        """Wer die Anfrage stellt, fuer die Aktivitaet: Geraet (Adresse)."""
        return f"{device(self.headers.get('User-Agent', ''))} ({self.ip()})"

    def send(self, code, body, ctype="application/json", extra=(), cache="no-store", csp=None):
        data = body if isinstance(body, bytes) else body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", cache)
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("Strict-Transport-Security", "max-age=31536000")
        self.send_header("Content-Security-Policy", csp or CSP)
        for k, v in extra:
            self.send_header(k, v)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(data)

    def send_json(self, code, obj, extra=()):
        self.send(code, json.dumps(obj), extra=extra)

    def session(self):
        for part in self.headers.get("Cookie", "").split(";"):
            name, _, value = part.strip().partition("=")
            if name == "agentbox":
                with lock:
                    exp = sessions.get(value)
                    if exp and exp > time.time():
                        return value
                    sessions.pop(value, None)
        return None

    def drain(self):
        """Den Body einer Anfrage ungelesen verwerfen (hoechstens MAX_BODY), sonst die
        Verbindung danach schliessen."""
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            length = MAX_BODY + 1
        if 0 < length <= DRAIN_BODY:
            while length > 0:
                chunk = self.rfile.read(min(length, 65536))
                if not chunk:
                    break
                length -= len(chunk)
        elif length:
            self.close_connection = True

    def body(self):
        length = int(self.headers.get("Content-Length") or 0)
        if length > MAX_BODY:
            raise ValueError("too large")
        raw = self.rfile.read(length) if length else b"{}"
        obj = json.loads(raw or b"{}")
        if not isinstance(obj, dict):
            raise ValueError("JSON object expected")
        return obj

    # GET: Seite und Lese-APIs
    def do_GET(self):
        request.actor = self.actor()
        url = urlparse(self.path)
        path = url.path
        if path.startswith("/api/v1/") or path == "/api/v1":
            return v1(self, "GET", url)
        if not path.startswith("/api/"):
            return serve_page(self, path)
        if not self.session():
            return self.send_json(401, {"error": "not signed in"})
        parts = path.split("/")[2:]
        if parts == ["host"]:
            return serve_host(self)
        if parts == ["events"]:
            return serve_events(self)
        try:
            if parts == ["status"]:
                return self.send_json(200, agentbox_json("status", "--json"))
            if parts == ["activity"]:
                ok, out = activity(url.query)
                if not ok:
                    return self.send_json(400, {"error": out[:300]})
                return self.send_json(200, json.loads(out))
            if parts == ["settings"]:
                return self.send_json(200, agentbox_json("settings", "--json"))
            if parts == ["harmless"]:
                return self.send_json(200, agentbox_json("harmless", "--json"))
            if parts == ["github-app"]:
                # fragt GitHub: scheitert das, ist es kein Fehler dieses Dienstes
                ok, out = agentbox("github-app", "--json", timeout=120)
                if not ok:
                    return self.send_json(502, {"error": out[:300]})
                return self.send_json(200, json.loads(out))
            if parts == ["allowlist"]:
                ok, out = allowlist_entries(url.query)
                if not ok:
                    return self.send_json(400, {"error": out[:300]})
                return self.send_json(200, json.loads(out))
            if parts == ["images"]:
                return self.send_json(200, agentbox_json("images", "--json"))
            if len(parts) == 3 and parts[0] == "images" and IMAGE_NAME.fullmatch(parts[1]) and parts[2] == "log":
                ok, out = build_log(parts[1], url.query)
                if not ok:
                    return self.send_json(400, {"error": out[:300]})
                return self.send_json(200, json.loads(out))
            if len(parts) == 2 and VM_NAME.fullmatch(parts[0]):
                ctx, what = parts
                if what == "github-tokens":
                    ok, out = github_tokens(ctx, url.query)
                    if not ok:
                        return self.send_json(400, {"error": out[:300]})
                    return self.send_json(200, json.loads(out))
                if what == "blocked":
                    return self.send_json(200, agentbox_json("blocked", ctx, "--json"))
                if what == "alerts":
                    return self.send_json(200, agentbox_json("alerts", ctx, "--json"))
                if what == "allowlist":
                    # die eigenen Freigaben der VM als Domains (die bisherige Oberflaeche);
                    # alles mit Geltungsbereich und Ablauf: GET /api/allowlist?vm=<vm>
                    entries = agentbox_json("allowlist", ctx, "--json")
                    return self.send_json(200, [e["domain"] for e in entries
                                                if e.get("scope") == ctx and e.get("domain")])
                if what == "owners":
                    ok, out = agentbox("owners", ctx, timeout=30)
                    return self.send_json(200, [l for l in out.splitlines() if l.strip()] if ok else [])
        except Exception as e:
            return self.send_json(500, {"error": str(e)[:300]})
        return self.send_json(404, {"error": "not found"})

    # POST: Anmeldung und Aktionen
    def do_HEAD(self):
        path = urlparse(self.path).path
        if path.startswith("/api/"):
            return self.send_error(501)
        return serve_page(self, path)

    def do_PUT(self):
        self.other("PUT")

    def do_PATCH(self):
        self.other("PATCH")

    def do_DELETE(self):
        self.other("DELETE")

    def other(self, method):
        """PUT, PATCH, DELETE: nur die API v1 kennt sie."""
        request.actor = self.actor()
        url = urlparse(self.path)
        if url.path.startswith("/api/v1/"):
            return v1(self, method, url)
        return self.send_error(501)

    def do_POST(self):
        request.actor = self.actor()
        url = urlparse(self.path)
        path = url.path
        if path.startswith("/api/v1/"):
            return v1(self, "POST", url)
        # Schutz gegen Cross-Site-Requests: nur das eigene JS setzt diesen Header
        if self.headers.get("X-Agentbox") != "1":
            return self.send_json(403, {"error": "forbidden"})
        try:
            body = self.body()
        except (ValueError, json.JSONDecodeError) as e:
            return self.send_json(400, {"error": str(e)})

        if path == "/api/login":
            return self.login(body)
        if path == "/api/logout":
            token = self.session()
            with lock:
                sessions.pop(token, None)
            if token:
                signin_activity(self, "signout")
            return self.send_json(200, {"ok": True}, extra=[("Set-Cookie", "agentbox=; Max-Age=0; Path=/; Secure; HttpOnly; SameSite=Strict")])

        if not self.session():
            return self.send_json(401, {"error": "not signed in"})
        parts = path.split("/")[2:]
        if len(parts) == 1 and parts[0] in GLOBAL_ACTIONS:
            ctx, action = None, parts[0]
        elif len(parts) != 2 or not VM_NAME.fullmatch(parts[0]) or parts[1] not in ACTIONS:
            return self.send_json(404, {"error": "unknown action"})
        else:
            ctx, action = parts
        try:
            ok, out = GLOBAL_ACTIONS[action](body) if ctx is None else ACTIONS[action](ctx, body)
        except subprocess.TimeoutExpired:
            ok, out = False, "timed out"
        except (ValueError, TypeError) as e:
            ok, out = False, f"invalid input: {e}"
        # was an Token oder Schluessel kam, geht nie zurueck, auch nicht im Log
        out = scrub(out, action, body)
        result = None
        if ok and action in JSON_ACTIONS:
            try:
                result = json.loads(out)
            except ValueError:
                ok, out = False, "unreadable answer from agentbox"
        # Antworten vertraulicher Aktionen nie ins Journal; bei logs auch keine
        # Fehlertexte (Inhalte aus der VM), bei pair/claude-token schon (Diagnose)
        shown = "(confidential)" if ok and action in SECRET_ACTIONS or action == "logs" else out[:200]
        log(f"{self.ip()}: {ctx or '-'} {action} -> {'ok' if ok else 'FAILED'}: {shown}")
        if result is not None:
            return self.send_json(200, result)
        return self.send_json(200 if ok else 400, {"ok": ok, "message": out})

    def login(self, body):
        result, value = self.attempt_login(body.get("password", ""))
        if result == "locked":
            return self.send_json(429, {"error": "too many failed attempts, try again later"})
        if result == "wrong":
            return self.send_json(401, {"error": "wrong password"})
        return self.send_json(200, {"ok": True}, extra=[("Set-Cookie", value)])

    def attempt_login(self, password):
        """Anmeldung mit Bremse (alte und neue API): ("ok", Cookie), ("locked", Sekunden bis
        zum naechsten Versuch) oder ("wrong", None)."""
        ip = self.ip()
        now = time.time()
        with lock:
            count, first = fails.get(ip, (0, now))
            locked = count >= MAX_FAILS and now - first < LOCK_SECONDS
        if locked:
            log(f"{ip}: sign-in locked")
            signin_activity(self, "signin.locked")
            return "locked", max(1, int(first + LOCK_SECONDS - now))
        if not check_password(str(password)):
            with lock:
                count, first = fails.get(ip, (0, now))
                if now - first >= LOCK_SECONDS:
                    count, first = 0, now
                fails[ip] = (count + 1, first)
            log(f"{ip}: sign-in FAILED")
            signin_activity(self, "signin.failed")
            time.sleep(1)
            return "wrong", None
        token = secrets.token_urlsafe(32)
        seconds = session_seconds()
        with lock:
            fails.pop(ip, None)
            sessions[token] = now + seconds
        log(f"{ip}: signed in")
        signin_activity(self, "signin")
        return "ok", f"agentbox={token}; Max-Age={seconds}; Path=/; Secure; HttpOnly; SameSite=Strict"


class Server(http.server.ThreadingHTTPServer):
    daemon_threads = True

    def __init__(self, addr, handler, tls):
        super().__init__(addr, handler)
        self.tls = tls

    # TLS-Handshake im Thread der Verbindung, nicht beim Annehmen
    def finish_request(self, request, client_address):
        request.settimeout(30)
        try:
            request = self.tls.wrap_socket(request, server_side=True)
        except (ssl.SSLError, OSError):
            return
        super().finish_request(request, client_address)


