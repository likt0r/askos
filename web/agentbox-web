# --- Oberflaeche ----------------------------------------------------------------
# Die Oberflaeche ist ein statischer Nuxt-Build (ssr: false): index.html, die
# gehashten Dateien unter /_nuxt/ (und /_fonts/), sonst ein paar feste Dateien. Jeder
# Pfad, der keine API und keine Datei ist, bekommt index.html (die Oberflaeche waehlt
# die Seite selbst). Die CSP bleibt bei 'self'; erlaubt sind zusaetzlich genau die
# Inline-Skripte (und -Styles) dieser index.html, ueber ihre sha256-Hashes, die beim
# Laden der Datei berechnet werden. Ohne installierten Build antwortet jede Seite 503,
# die API bleibt erreichbar.

UI_CHECK_SECONDS = max(0.05, float(os.environ.get("AGENTBOX_WEB_UI_CHECK_SECONDS", "2")))
IMMUTABLE = ("/_nuxt/", "/_fonts/")     # Dateinamen mit Inhalts-Hash
TYPES = {".html": "text/html; charset=utf-8", ".js": "text/javascript; charset=utf-8",
         ".mjs": "text/javascript; charset=utf-8", ".css": "text/css; charset=utf-8",
         ".json": "application/json", ".map": "application/json", ".svg": "image/svg+xml",
         ".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".webp": "image/webp",
         ".gif": "image/gif", ".ico": "image/x-icon", ".woff2": "font/woff2", ".woff": "font/woff",
         ".ttf": "font/ttf", ".otf": "font/otf", ".txt": "text/plain; charset=utf-8",
         ".webmanifest": "application/manifest+json", ".xml": "application/xml", ".wasm": "application/wasm"}
INLINE = re.compile(r"<(script|style)\b([^>]*)>(.*?)</\1\s*>", re.S | re.I)
SRC = re.compile(r"""\ssrc\s*=""", re.I)
TYPE = re.compile(r"""\stype\s*=\s*["']?([^"'\s>]+)""", re.I)
# Skript-Typen, die der Browser ausfuehrt (Daten wie application/json nicht)
SCRIPT_TYPES = {"", "text/javascript", "application/javascript", "module", "importmap"}


def inline_hashes(html):
    """('sha256-...' der Inline-Skripte, ... der Inline-Styles) einer HTML-Seite, ueber
    genau den Text zwischen den Tags, wie ihn der Browser hasht."""
    scripts, styles = [], []
    for tag, attrs, body in INLINE.findall(html):
        if tag.lower() == "script":
            if SRC.search(attrs):
                continue
            m = TYPE.search(attrs)
            if (m.group(1).lower() if m else "") not in SCRIPT_TYPES:
                continue
        digest = "'sha256-" + base64.b64encode(hashlib.sha256(body.encode()).digest()).decode() + "'"
        (scripts if tag.lower() == "script" else styles).append(digest)
    return sorted(set(scripts)), sorted(set(styles))


def page_csp(scripts, styles):
    return ("default-src 'self'; " + " ".join(["style-src 'self'", *styles]) + "; "
            + " ".join(["script-src 'self'", *scripts]) + "; "
            "img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; "
            "form-action 'none'")


class UiBuild:
    """Die installierte Oberflaeche: ihre Version (Hash der index.html) und die CSP ihrer
    Seite, None ohne Build. Wird alle UI_CHECK_SECONDS neu geprueft; eine neue Version geht
    als version-Ereignis an alle offenen Seiten."""

    def __init__(self):
        self.lock = threading.Lock()
        self.key = None
        self.info = None            # {"root", "index", "version", "installed", "csp", "etag"}

    @staticmethod
    def _key():
        try:
            st = os.stat(os.path.join(UI, "index.html"))
        except OSError:
            return None
        return os.path.realpath(UI), st.st_mtime_ns, st.st_size, st.st_ino

    def refresh(self):
        """True, wenn sich die installierte Oberflaeche geaendert hat (auch: kam oder ging)."""
        key = self._key()
        with self.lock:
            if key == self.key:
                return False
        info = self._load() if key else None
        with self.lock:
            changed = (self.info or {}).get("version") != (info or {}).get("version")
            self.key, self.info = key, info
        return changed

    @staticmethod
    def _load():
        root = os.path.realpath(UI)
        with open(os.path.join(root, "index.html"), "rb") as f:
            index = f.read()
        scripts, styles = inline_hashes(index.decode("utf-8", "replace"))
        digest = hashlib.sha256(index).hexdigest()
        installed = os.stat(os.path.join(root, "index.html")).st_mtime
        return {"root": root, "index": index, "version": digest[:16], "csp": page_csp(scripts, styles),
                "etag": f'"{digest[:32]}"', "installed": installed}

    def current(self):
        with self.lock:
            info = self.info
        if info is None:
            self.refresh()
            with self.lock:
                info = self.info
        return info

    def public(self):
        info = self.current()
        if info is None:
            return {"version": None, "ui": None, "installed": None}
        return {"version": info["version"], "ui": "nuxt", "installed": iso(info["installed"])}

    def announce(self):
        version = self.public()["version"]
        log(f"UI: version {version}" if version else f"UI: no build installed in {UI}")

    def loop(self):
        while True:
            try:
                if self.refresh():
                    events.publish("version", self.public(), state=True)
                    self.announce()
            except Exception as e:      # eine halb kopierte Oberflaeche: beim naechsten Mal
                log(f"UI unreadable: {type(e).__name__}")
            time.sleep(UI_CHECK_SECONDS)

    def start(self):
        try:
            self.refresh()
        except Exception as e:
            log(f"UI unreadable: {type(e).__name__}")
        if self.info:
            events.publish("version", self.public(), state=True)
        self.announce()
        threading.Thread(target=self.loop, name="ui-version", daemon=True).start()


ui = UiBuild()
NO_UI = "The Control Room UI is not installed on this Host.\n"


def serve_page(handler, path):
    """GET (und HEAD) ausserhalb von /api/: die Oberflaeche."""
    info = ui.current()
    if info is None:
        return handler.send(503, NO_UI, "text/plain; charset=utf-8")
    rel = unquote(path)
    parts = rel.split("/")
    if "\x00" in rel or "\\" in rel or any(p in (".", "..") for p in parts):
        return handler.send_json(404, api_error("not_found", "Not found"))
    if rel not in ("/", "/index.html"):
        full = os.path.realpath(os.path.join(info["root"], rel.lstrip("/")))
        if full.startswith(info["root"] + os.sep) and os.path.isfile(full):
            return serve_file(handler, rel, full, info["csp"])
        # fehlende Dateien bleiben 404, statt HTML zu bekommen
        if rel.startswith(IMMUTABLE) or os.path.splitext(parts[-1])[1].lower() in TYPES:
            return handler.send_json(404, api_error("not_found", "Not found"))
    if handler.headers.get("If-None-Match") == info["etag"]:
        return handler.send(304, b"", "text/html; charset=utf-8", cache="no-cache", csp=info["csp"],
                            extra=[("ETag", info["etag"])])
    return handler.send(200, info["index"], "text/html; charset=utf-8", cache="no-cache", csp=info["csp"],
                        extra=[("ETag", info["etag"])])


def serve_file(handler, rel, full, csp):
    ext = os.path.splitext(full)[1].lower()
    st = os.stat(full)
    etag = f'"{st.st_mtime_ns:x}-{st.st_size:x}"'
    cache = "public, max-age=31536000, immutable" if rel.startswith(IMMUTABLE) else "no-cache"
    extra = [("ETag", etag), ("Last-Modified", email.utils.formatdate(st.st_mtime, usegmt=True))]
    ctype = TYPES.get(ext, "application/octet-stream")
    if handler.headers.get("If-None-Match") == etag:
        return handler.send(304, b"", ctype, cache=cache, csp=csp, extra=extra)
    with open(full, "rb") as f:
        return handler.send(200, f.read(), ctype, cache=cache, csp=csp, extra=extra)


# --- API v1 ---------------------------------------------------------------------
# The UI's API (docs/control-room-api.md); v1() answers every path under /api/.
# Errors are {"error": {"code": <stable>, "message": <English>, "detail": <optional>}}; the
# UI translates the code. agentbox names the code itself (its --json failure on stderr); its
# English message goes only into detail. Each request is at most one call of agentbox, with
# fixed arguments and values as --option=value, so none becomes an option; agentbox checks
# everything again.

class ApiError(Exception):
    """detail: what agentbox said about it (English); field: the request's field that is wrong;
    params: the parameters the UI words this refusal with (ERROR_PARAMS)."""

    def __init__(self, status, code, message, detail=None, headers=(), field=None, params=None):
        super().__init__(code)
        self.status, self.code, self.message, self.detail, self.headers = status, code, message, detail, headers
        self.field, self.params = field, params


def api_error(code, message, detail=None, field=None, params=None):
    error = {"code": code, "message": message}
    if field:
        error["field"] = field
    if params:
        error["params"] = params
    if detail:
        error["detail"] = detail
    return {"error": error}


def invalid(field, message):
    return ApiError(400, "invalid_field", message[:1].upper() + message[1:], field=field)


