@route("POST", "/builds")
def post_builds(h, m, url, body):
    """Ein Build; mit reset ein Update: wenn der Build gelingt, setzt seine Unit diese VMs darauf zurueck."""
    image, reset = body.get("image"), body.get("reset", [])
    if not isinstance(reset, list) or len(reset) > 64 or \
            not all(isinstance(v, str) and VM_NAME.fullmatch(v) for v in reset):
        raise invalid("reset", "reset must be a list of VM names")
    if image == "all":
        if reset:
            raise invalid("reset", "reset needs one Image, not all")
        return 202, run_json("build", "--all", "--json", timeout=60)
    if not isinstance(image, str) or not IMAGE_NAME.fullmatch(image):
        raise invalid("image", "image must be the name of an Image or all")
    return 202, run_json("build", image, *[f"--reset={v}" for v in reset], "--json", timeout=60)


@route("POST", "/updates")
def post_updates(h, m, url, body):
    """Update jetzt (#114): Versionen pruefen, jedes Image mit Update bauen, danach (wenn alle
    Builds gelingen) die VMs aus reset zuruecksetzen; laeuft als Unit, antwortet sofort."""
    reset = body.get("reset", [])
    if not isinstance(reset, list) or len(reset) > 64 or \
            not all(isinstance(v, str) and VM_NAME.fullmatch(v) for v in reset):
        raise invalid("reset", "reset must be a list of VM names")
    return 202, run_json("update-now", *[f"--reset={v}" for v in reset], "--json", timeout=60)


