def _load_readings():
    """agentbox-readings, liegt neben agentbox-web (im Checkout und installiert)."""
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "agentbox-readings")
    if not os.path.exists(path):
        return None
    loader = importlib.machinery.SourceFileLoader("agentbox_readings", path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


