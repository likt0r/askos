def release():
    """Die Version dieses Releases (Datei VERSION, dieselbe wie `agentbox version`: paths.VERSION,
    neben dem Paket); None, wenn es keine gueltige gibt."""
    try:
        with open(os.environ.get("AGENTBOX_WEB_RELEASE_FILE", paths.VERSION), encoding="utf-8") as f:
            text = f.read().strip()
    except OSError:
        return None
    return text if SEMVER.fullmatch(text) else None


