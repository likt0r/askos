    if not isinstance(v, str) or v != "all" and not VM_NAME.fullmatch(v):
        raise invalid("scope", "scope must be all or a VM")
    return v


# what a pattern may consist of, as agentbox's rules say (printable ASCII without spaces); the
# rest of the rules agentbox checks
PATTERN_CHARS = re.compile(r"[\x21-\x7e]+")


# what is dropped around a pattern: ASCII spaces, tabs, CR and LF, nothing else (str.strip()
# would also drop other control and Unicode whitespace, which is refused instead)
PATTERN_AROUND = " \t\r\n"


def pattern_arg(v):
    """--regex=<pattern> of a Regex entry, taken as given but for leading and trailing spaces,
    tabs, CR and LF (not lowercased: \\D is not \\d); as the value of the option it is never
    one itself. Anything else but printable ASCII without spaces (a NUL byte included, which
    no process argument can carry) is refused here; agentbox checks the rest."""
    pattern = v.strip(PATTERN_AROUND) if isinstance(v, str) else None
    if pattern is None or not PATTERN_CHARS.fullmatch(pattern):
        raise invalid("regex", "regex must be a pattern of printable ASCII characters without spaces")
    return f"--regex={pattern}"


def target_args(body):
    """The entry a body names: its domain, or --regex=<pattern> for a Regex entry."""
    if body.get("regex") is not None:
        if body.get("domain") is not None:
            raise invalid("regex", "domain or regex, not both")
        return [pattern_arg(body["regex"])]
    return [word(body, "domain").lower()]


def regex_query(url):
    """--regex=<pattern> of the Regex entry a path under /regex names in ?regex=."""
    return pattern_arg(query_value(url, "regex"))


