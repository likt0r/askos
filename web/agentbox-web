def utf8(text):
    """Whether text has a UTF-8 form (no lone surrogate)."""
    try:
        text.encode("utf-8")
    except UnicodeEncodeError:
        return False
    return True


@route("PUT", VM + "/env")
def put_env(h, m, url, body):
    """The VM's whole list of VM variables (set-env --replace): names agentbox can take as
    NAME=VALUE (a name with "=" or a leading "--" would read differently), values without NUL
    and in UTF-8 (no argument can carry a NUL, and JSON can carry a lone UTF-16 surrogate,
    "\\ud800", that no argument can be encoded with); agentbox checks everything else."""
    env = body.get("env")
    if not isinstance(env, dict) or not all(isinstance(v, str) for v in env.values()):
        raise invalid("env", "env must be an object of names and text values")
    for name, value in env.items():
        if not vmenv.is_name(name):
            raise refused("invalid_env_name", field="env")
        if "\0" in value or not utf8(value):
            raise refused("invalid_env_value", field="env", params={"name": name})
    return 200, run_json("set-env", m["vm"], "--replace", *(f"{k}={v}" for k, v in env.items()), "--json")


