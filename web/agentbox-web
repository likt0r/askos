# Teilstueck im User-Agent -> Name; die erste Fundstelle gilt (Edge nennt auch
# Chrome und Safari, Android auch Linux)
BROWSERS = (("Edg/", "Edge"), ("OPR/", "Opera"), ("FxiOS/", "Firefox"), ("Firefox/", "Firefox"),
            ("CriOS/", "Chrome"), ("Chrome/", "Chrome"), ("Safari/", "Safari"), ("curl/", "curl"))
SYSTEMS = (("Android", "Android"), ("iPhone", "iPhone"), ("iPad", "iPad"), ("Windows", "Windows"),
           ("Macintosh", "macOS"), ("CrOS", "ChromeOS"), ("Linux", "Linux"))


def device(user_agent):
    """Kurzbeschreibung des Geraets aus dem User-Agent, z. B. Firefox/Linux. Nur
    feste Namen, nie Text aus der Anfrage."""
    browser = next((name for key, name in BROWSERS if key in user_agent), None)
    system = next((name for key, name in SYSTEMS if key in user_agent), None)
    return "/".join(n for n in (browser, system) if n) or "unknown device"


def journal(fields):
    """Ein Eintrag im Journal (natives Protokoll, journal-native(7)). Ohne
    erreichbares Journal nur ein Hinweis im eigenen Log; ebenso, wenn das erste
    (der Namensraum der Aktivitaet) den Dienst nicht schreiben laesst: dann auch
    nirgends sonst, die Anmeldung gehoert in die Aktivitaet."""
    data = b""
    for key, value in fields.items():
        v = value.encode("utf-8", "replace")
        data += key.encode() + (b"\n" + struct.pack("<Q", len(v)) + v if b"\n" in v else b"=" + v) + b"\n"
    for i, path in enumerate(JOURNAL):
        if not path or not os.path.exists(path):
            continue
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as s:
                s.sendto(data, path)
            return
        except PermissionError:
            if i == 0:
                log("Activity not recorded in the journal: no permission to write "
                    "(group agentbox-journal; run agentbox setup again)")
                return
        except OSError:
            continue
    log("Activity not recorded in the journal")


# Sign-ins and sign-outs in Activity, as agentbox records its entries (agentbox/activity.py):
# the action is the entry's code (AGENTBOX_CODE), from which the UI words it; the English
# description is the fallback. No parameters: address and device are fields of their own.
SIGN_INS = {"signin": ("ok", "Signed in"), "signin.failed": ("failed", "Sign-in with a wrong password"),
            "signin.locked": ("failed", "Sign-in refused: too many failed attempts"),
            "signout": ("ok", "Signed out")}


def signin_activity(handler, action):
    """A sign-in or sign-out in Activity (SIGN_INS): outcome, address and device, never the
    password."""
    outcome, description = SIGN_INS[action]
    actor, ip = handler.actor(), handler.ip()
    journal({"MESSAGE": f"- {action} {outcome} ({actor}): {description}",
             "PRIORITY": "5" if outcome == "ok" else "4", "SYSLOG_IDENTIFIER": "agentbox-activity",
             "AGENTBOX_KIND": "signin", "AGENTBOX_ACTION": action, "AGENTBOX_CODE": action,
             "AGENTBOX_OUTCOME": outcome, "AGENTBOX_ACTOR": actor, "AGENTBOX_DESCRIPTION": description,
             "AGENTBOX_ADDRESS": ip, "AGENTBOX_DEVICE": device(handler.headers.get("User-Agent", ""))})


# --- Passwort ---------------------------------------------------------------

def scrypt(password, salt, n=2**15, r=8, p=1):
    return hashlib.scrypt(password.encode(), salt=salt, n=n, r=r, p=p, maxmem=64 * 1024 * 1024)


def make_hash(password):
    salt = secrets.token_bytes(16)
    return f"scrypt$32768$8$1${salt.hex()}${scrypt(password, salt).hex()}"


def session_seconds():
    """Laenge einer Sitzung: session_hours der Einstellungen (agentbox schreibt sie, der
    Leitstand liest die Datei), bei jeder Anmeldung neu; ohne gueltigen Wert der Standard."""
    try:
        with open(SETTINGS, encoding="utf-8") as f:
            hours = json.load(f).get("session_hours", SESSION_HOURS)
    except (OSError, ValueError, AttributeError):
        hours = SESSION_HOURS
    if isinstance(hours, bool) or not isinstance(hours, int) or not 1 <= hours <= 168:
        hours = SESSION_HOURS
    return hours * 3600


def default_language():
    """default_language der Einstellungen fuer GET und POST /session: die Oberflaeche braucht
    ihn nach der Anmeldung, ohne GET /settings (ein Aufruf von agentbox mit sudo); bei jeder
    Anfrage neu aus der Datei, ohne gueltigen Wert der Standard."""
    try:
        with open(SETTINGS, encoding="utf-8") as f:
            value = json.load(f).get("default_language", LANGUAGES[0])
    except (OSError, ValueError, AttributeError):
        value = LANGUAGES[0]
    return value if isinstance(value, str) and value in LANGUAGES else LANGUAGES[0]


def check_password(password):
    try:
        with open(f"{CONF}/password") as f:
            _, n, r, p, salt, digest = f.read().strip().split("$")
    except (OSError, ValueError):
        return False
    got = scrypt(password, bytes.fromhex(salt), int(n), int(r), int(p))
    return hmac.compare_digest(got.hex(), digest)


# --- agentbox ---------------------------------------------------------------

def agentbox(*args, stdin=None, timeout=300):
    # --actor steht vor dem Befehl (globale Option von agentbox)
    actor = getattr(request, "actor", None)
    argv = [*AGENTBOX, *([f"--actor={actor}"] if actor else []), *args]
    r = subprocess.run(argv, input=stdin, capture_output=True, text=True, timeout=timeout)
    # a failure with --json is a JSON object on stderr (cli_error); the old UI shows its message
    said = cli_error(r.stderr) if r.returncode != 0 else None
    out = (r.stdout.strip() or (said[1] if said else r.stderr.strip())).removeprefix("agentbox: ")
    return r.returncode == 0, out


def agentbox_json(*args):
    ok, out = agentbox(*args, timeout=60)
    if not ok:
        raise RuntimeError(out)
    return json.loads(out or "null")


# Filter fuer das Journal einer VM -> Option von `agentbox logs`. Werte gehen
# immer als --option=wert hinaus, damit keiner zur eigenen Option wird;
# agentbox prueft sie.
LOG_FILTERS = {"unit": "--unit", "priority": "--priority", "since": "--since", "until": "--until",
               "boot": "--boot", "grep": "--grep", "lines": "--lines", "after_cursor": "--after-cursor"}


def logs(ctx, body):
    args = []
    for key, opt in LOG_FILTERS.items():
        v = body.get(key)
        if v is None:                    # null = kein Filter
            continue
        # nur Text und ganze Zahlen; true/false, Listen, Kommazahlen sind Fehler,
        # nicht etwas, das zu Text umgewandelt wird
        if isinstance(v, bool) or not isinstance(v, (str, int)):
            return False, f"invalid value for {key}"
        v = str(v)
        if not v.strip():                # leer = kein Filter
            continue
        # Suchtext unveraendert (Leerzeichen koennen gemeint sein), sonst getrimmt
        args.append(f"{opt}={v if key == 'grep' else v.strip()}")
    return agentbox("logs", ctx, *args, "--json", timeout=60)


# Neue VM: Feld -> Option von `agentbox create`. Werte gehen als --option=wert
