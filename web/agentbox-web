CONFIG_REFUSED = 78


def refused_config(message):
    """Ends this service at a file agentbox refuses: one line with the reason, no traceback,
    exit status CONFIG_REFUSED."""
    print(f"agentbox-web: {message}", file=sys.stderr, flush=True)
    sys.exit(CONFIG_REFUSED)


def bind_port():
    """(address, port) from the Host setup (host.json, changed only on the Host; ADR 0009),
    Local-only without the file; the environment wins (tests, development). The record is read
    and checked by the CLI's own reader: one it refuses stops this service with its message
    instead of a guess, as a wrong address could expose more than the owner chose."""
    if "AGENTBOX_WEB_BIND" in os.environ or "AGENTBOX_WEB_PORT" in os.environ:
        return os.environ.get("AGENTBOX_WEB_BIND", "127.0.0.1"), int(os.environ.get("AGENTBOX_WEB_PORT", "8800"))
    try:
        setup = hostsetup.load()
    except Fail as f:
        refused_config(f.message)
    return setup["bind"], setup["web_port"]


