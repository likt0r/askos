def create(ctx, body):
    args = []
    for key, opt in CREATE_FIELDS.items():
        v = body.get(key)
        if v is None or v == "":         # null/leer = Vorgabe
            continue
        if isinstance(v, bool) or not isinstance(v, (str, int)):
