# --- HTTP -------------------------------------------------------------------

class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "agentbox-web"
    sys_version = ""
    timeout = 30

    def log_message(self, fmt, *args):
        pass  # eigenes Logging: nur Anmeldungen und Aktionen

    def ip(self):
        return self.client_address[0]

    def actor(self):
        """Wer die Anfrage stellt, fuer die Aktivitaet: Geraet (Adresse)."""
        return f"{device(self.headers.get('User-Agent', ''))} ({self.ip()})"

    def send(self, code, body, ctype="application/json", extra=(), cache="no-store", csp=None):
        data = body if isinstance(body, bytes) else body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", cache)
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("Strict-Transport-Security", "max-age=31536000")
        self.send_header("Content-Security-Policy", csp or CSP)
        for k, v in extra:
            self.send_header(k, v)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(data)

    def send_json(self, code, obj, extra=()):
        self.send(code, json.dumps(obj), extra=extra)

    def session(self):
        for part in self.headers.get("Cookie", "").split(";"):
            name, _, value = part.strip().partition("=")
            if name == "agentbox":
                with lock:
                    exp = sessions.get(value)
                    if exp and exp > time.time():
                        return value
                    sessions.pop(value, None)
        return None

    def drain(self):
        """Den Body einer Anfrage ungelesen verwerfen (hoechstens MAX_BODY), sonst die
        Verbindung danach schliessen."""
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            length = MAX_BODY + 1
        if 0 < length <= DRAIN_BODY:
            while length > 0:
                chunk = self.rfile.read(min(length, 65536))
                if not chunk:
                    break
                length -= len(chunk)
        elif length:
            self.close_connection = True

    def body(self):
        length = int(self.headers.get("Content-Length") or 0)
        if length > MAX_BODY:
            raise ValueError("too large")
        raw = self.rfile.read(length) if length else b"{}"
        obj = json.loads(raw or b"{}")
        if not isinstance(obj, dict):
            raise ValueError("JSON object expected")
        return obj

    # Unter /api/ nur die API (v1), sonst die Oberflaeche
    def do_GET(self):
        request.actor = self.actor()
        url = urlparse(self.path)
        if url.path.startswith("/api/"):
            return v1(self, "GET", url)
        return serve_page(self, url.path)

    def do_HEAD(self):
        path = urlparse(self.path).path
        if path.startswith("/api/"):
            return self.send_error(501)
        return serve_page(self, path)

    def do_POST(self):
        self.other("POST")

    def do_PUT(self):
        self.other("PUT")

    def do_PATCH(self):
        self.other("PATCH")

    def do_DELETE(self):
        self.other("DELETE")

    def other(self, method):
        """POST, PUT, PATCH, DELETE: nur die API kennt sie."""
        request.actor = self.actor()
        url = urlparse(self.path)
        if url.path.startswith("/api/"):
            return v1(self, method, url)
        return self.send_error(501)

    def attempt_login(self, password):
        """Anmeldung mit Bremse: ("ok", Cookie), ("locked", Sekunden bis zum naechsten
        Versuch) oder ("wrong", None)."""
        ip = self.ip()
        now = time.time()
        with lock:
            count, first = fails.get(ip, (0, now))
            locked = count >= MAX_FAILS and now - first < LOCK_SECONDS
        if locked:
            log(f"{ip}: sign-in locked")
            signin_activity(self, "signin.locked")
            return "locked", max(1, int(first + LOCK_SECONDS - now))
        if not check_password(str(password)):
            with lock:
                count, first = fails.get(ip, (0, now))
                if now - first >= LOCK_SECONDS:
                    count, first = 0, now
                fails[ip] = (count + 1, first)
            log(f"{ip}: sign-in FAILED")
            signin_activity(self, "signin.failed")
            time.sleep(1)
            return "wrong", None
        token = secrets.token_urlsafe(32)
        seconds = setting("session_hours") * 3600
        with lock:
            fails.pop(ip, None)
            sessions[token] = now + seconds
        log(f"{ip}: signed in")
        signin_activity(self, "signin")
        return "ok", f"agentbox={token}; Max-Age={seconds}; Path=/; Secure; HttpOnly; SameSite=Strict"


class Server(http.server.ThreadingHTTPServer):
    daemon_threads = True

    def __init__(self, addr, handler, tls):
        super().__init__(addr, handler)
        self.tls = tls
        self.settings_refused = False

    def process_request_thread(self, conn, address):
        """A connection to its end; when one of its requests found the Settings refused
        (setting()), its answer is sent and the connection closed, and then the server stops
        (serve_forever returns, main ends the service)."""
        request.settings_refused = False
        super().process_request_thread(conn, address)
        if request.settings_refused:
            self.settings_refused = True
            self.shutdown()

    # TLS-Handshake im Thread der Verbindung, nicht beim Annehmen
    def finish_request(self, request, client_address):
        request.settimeout(30)
        try:
            request = self.tls.wrap_socket(request, server_side=True)
        except (ssl.SSLError, OSError):
            return
        super().finish_request(request, client_address)


