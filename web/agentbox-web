def _package_dir():
    """Where the package agentbox is: next to web/ in a checkout, installed in lib/agentbox under
    the prefix whose libexec/ holds this program. This service imports only the package's leaf
    modules, which read agentbox's files (paths, Host setup, Settings, the Release) and name its
    patterns, never one that pulls in the rest of the CLI (activity, images, github); a test
    checks that (tests/test_control_room_v1.py)."""
    here = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    checkout = os.path.isfile(os.path.join(here, "agentbox", "__init__.py"))
    return here if checkout else os.path.join(here, "lib", "agentbox")


