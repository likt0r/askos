class Events:
    """Ein Ereignisstrom fuer alle Live-Verbindungen (GET /api/events).

    Jedes Ereignis bekommt eine fortlaufende ID `<STREAM_ID>-<n>` und wird einmal
    als SSE-Text gebaut. Die letzten REPLAY_EVENTS liegen in einem Ringpuffer, aus
    dem jede Verbindung ab ihrer Position liest; wer zu weit zurueckfaellt, wird
    getrennt und verbindet sich neu. Zustands-Ereignisse (state=True, z.B. host)
    bekommt eine neue Verbindung sofort mit ihrem letzten Stand.
    """

    def __init__(self):
        self.cond = threading.Condition()
        self.seq = 0
        self.recent = collections.deque(maxlen=REPLAY_EVENTS)   # (n, Text)
        self.latest = {}                                        # Name -> Text
        self.streams = 0

    def publish(self, name, data, state=False, latest=None):
        """Ein Ereignis an alle. state: neue Verbindungen bekommen es als letzten Stand;
        latest=(Name, Daten): ein Stand, der mit diesem Ereignis neu gilt, ohne eigenes
        Ereignis (der VM-Stand `state` mit jedem `vm`-Ereignis)."""
        with self.cond:
            self.seq += 1
            text = self._text(name, data)
            self.recent.append((self.seq, text))
            if state:
                self.latest[name] = text
            if latest:
                self.latest[latest[0]] = self._text(*latest)
            self.cond.notify_all()

    def _text(self, name, data):
        return f"id: {STREAM_ID}-{self.seq}\nevent: {name}\ndata: {json.dumps(data)}\n\n"

    def resume(self, last_id):
        """(Position, nachgereicht?, erste Texte) fuer eine neue Verbindung."""
        stream, _, n = last_id.strip().partition("-")
        with self.cond:
            oldest = self.recent[0][0] if self.recent else self.seq + 1
            if stream == STREAM_ID and n.isdigit() and oldest - 1 <= int(n) <= self.seq:
                return int(n), True, []
            order = sorted(self.latest, key=lambda k: (LATEST_ORDER.index(k) if k in LATEST_ORDER else 99, k))
            return self.seq, False, [self.latest[k] for k in order]

    def wait(self, pos, timeout):
        """(Texte nach pos, neue Position); Texte None, wenn sie nicht mehr im Puffer sind."""
        with self.cond:
            if self.seq == pos:
                self.cond.wait(timeout)
            if self.recent and self.recent[0][0] > pos + 1:
                return None, pos
            return [t for n, t in self.recent if n > pos], self.seq


events = Events()


def start_readings():
    global sampler
    if readings is None:
        log("Host readings not available: agentbox-readings is missing")
        return
    sampler = readings.Sampler(readings.Collector(PROC, SYS), SAMPLE_SECONDS, HISTORY_SECONDS,
                               publish=publish_sample, log=log)
    sampler.start()


TEMPERATURES = {"cpu_temp": "CPU", "gpu_temp": "GPU", "nvme_temp": "NVMe"}
hot = set()             # Temperaturen ueber ihrer Schwelle (id)


def publish_sample(sample):
    """Messwerte an alle; eine Temperatur, die ihre Schwelle erreicht, als Benachrichtigung
    (einmal, bis sie wieder darunter liegt)."""
    events.publish("host", sample, state=True)
    for r in sample.get("readings", []):
        if r.get("kind") not in TEMPERATURES:
            continue
        if not r.get("over"):
            hot.discard(r["id"])
        elif r["id"] not in hot:
            hot.add(r["id"])
            notify("temperature", "warning", f"{TEMPERATURES[r['kind']]} temperature is {r['value']:g} °C "
                   f"(threshold {r['threshold']:g} °C)", reading=r["id"], device=r.get("device"),
                   value=r["value"], threshold=r["threshold"])


def serve_host(handler):
    """GET /api/host: aktuelle Messwerte, Schwellen und Verlauf."""
    if sampler is None:
        return handler.send_json(503, {"error": "host readings not available"})
    return handler.send_json(200, sampler.snapshot())


def session_alive(token):
    with lock:
        exp = sessions.get(token)
        return bool(exp and exp > time.time())


def serve_events(handler, v1=False):
    """GET /api/events (und /api/v1/events): Server-Sent Events, bis der Browser geht oder
    die Sitzung endet."""
    token = handler.session()
    with events.cond:
        full = events.streams >= MAX_STREAMS
        if not full:
            events.streams += 1
    if full:
        error = api_error("too_many_streams", "Too many live connections, try again later") if v1 else \
            {"error": "too many live connections"}
        return handler.send_json(503, error, extra=[("Retry-After", "10")])
    handler.close_connection = True
    try:
        pos, resumed, first = events.resume(handler.headers.get("Last-Event-ID", ""))
        handler.send_response(200)
        handler.send_header("Content-Type", "text/event-stream; charset=utf-8")
        handler.send_header("Cache-Control", "no-store")
        handler.send_header("X-Content-Type-Options", "nosniff")
        handler.end_headers()
        hello = json.dumps({"stream": STREAM_ID, "resumed": resumed})
        out = [f"retry: {RETRY_MS}\nevent: hello\ndata: {hello}\n\n", *first]
        while True:
            # Nur schreiben, nie lesen: das timeout des Handlers greift dann nur,
            # wenn ein Browser 30 s lang nichts abnimmt, und trennt ihn.
            handler.wfile.write("".join(out).encode() if out else b": ping\n\n")
            out, pos = events.wait(pos, HEARTBEAT_SECONDS)
            if out is None or not session_alive(token):
                return
    except OSError:
        return          # Browser weg (Reset, TLS-Fehler, Zeitueberschreitung)
    finally:
        with events.cond:
            events.streams -= 1


