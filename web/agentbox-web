                                    "text": text, **ref})


# --- agentbox watch -------------------------------------------------------------
# Ein einziger root-Helfer fuer alle Verbindungen: `sudo -n agentbox watch` schreibt
# Ereignisse als JSON-Zeilen; endet er, startet dieser Dienst ihn neu (mit wachsender
# Pause, 1 s bis 60 s). Seine stdin bleibt offen, solange dieser Dienst laeuft: endet
# der Dienst, endet auch watch.
WATCH_RETRY_SECONDS = max(0.05, float(os.environ.get("AGENTBOX_WEB_WATCH_RETRY_SECONDS", "1")))
WATCH_RETRY_MAX = 60
WATCH_STABLE = 60       # so lange gelaufen: die Pause beginnt wieder von vorn
# Ereignisse von watch, die unveraendert weitergehen (als Zustand: neue Verbindungen
# bekommen den letzten)
WATCH_FORWARD = {"activity": False, "alert": False, "github-token": False, "build": False, "build-log": False,
                 "services": True, "host-reboot": True}


class Watch:
    def __init__(self):
        self.lock = threading.Lock()
        self.vms = {}               # Name -> VM (Reihenfolge der Registry)
        self.problems = []
        self.known = False          # ein vms-Ereignis kam schon
        self.status = {"running": False, "since": None, "restarts": 0, "last_exit": None}
        self.reboot = None
        self.services = None

    def start(self):
        self.set_status(running=False)
        threading.Thread(target=self.run, name="watch", daemon=True).start()

    def set_status(self, **changes):
        with self.lock:
            self.status.update(changes)
            status = dict(self.status)
        events.publish("watch", status, state=True)

    def snapshot(self):
        with self.lock:
            return {"vms": list(self.vms.values()), "problems": list(self.problems), "known": self.known}

    def run(self):
        delay = WATCH_RETRY_SECONDS
        while True:
            started = time.monotonic()
            try:
                p = subprocess.Popen([*AGENTBOX, "watch"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                     stderr=subprocess.PIPE)
            except OSError as e:
                log(f"agentbox watch does not start: {e.strerror or e}")
                p = None
            if p:
                self.set_status(running=True, since=now_iso())
                threading.Thread(target=self.errors, args=(p.stderr,), name="watch-stderr", daemon=True).start()
                for line in p.stdout:
                    try:
                        self.handle(line)
                    except Exception as e:      # eine seltsame Zeile beendet nichts
                        log(f"agentbox watch: line skipped ({type(e).__name__})")
                code = p.wait()
                with self.lock:
                    restarts = self.status["restarts"] + 1
                self.set_status(running=False, last_exit=code, restarts=restarts)
                log(f"agentbox watch ended (exit {code})")
            if time.monotonic() - started > WATCH_STABLE:
                delay = WATCH_RETRY_SECONDS
            time.sleep(delay)
            delay = min(delay * 2, WATCH_RETRY_MAX)

    @staticmethod
    def errors(stream):
        # watch schreibt nur eigene Meldungen nach stderr, nie Inhalte aus dem Journal
        for line in stream:
            log("agentbox watch: " + line.decode("utf-8", "replace").strip()[:300])

    def handle(self, line):
        msg = json.loads(line)
        name, data = msg.get("event"), msg.get("data")
        if not isinstance(name, str) or not isinstance(data, dict):
            return
        if name == "vms":
            vms = [v for v in data.get("vms") or [] if isinstance(v, dict) and isinstance(v.get("name"), str)]
            with self.lock:
                self.vms = {v["name"]: v for v in vms}
                self.problems = [p for p in data.get("problems") or [] if isinstance(p, dict)]
                self.known = True
            events.publish("state", self.public_state(), state=True)
        elif name == "vm" and isinstance(data.get("name"), str):
            with self.lock:
                self.vms[data["name"]] = data
            events.publish("vm", data, latest=("state", self.public_state()))
        elif name in WATCH_FORWARD:
            events.publish(name, data, state=WATCH_FORWARD[name])
            self.notice(name, data)

    def public_state(self):
        snap = self.snapshot()
        return {"vms": snap["vms"], "problems": snap["problems"]}

    def notice(self, name, data):
        """Zustand fuer GET /api/v1/system merken, Benachrichtigungen ausloesen."""
        vm = data.get("vm") if isinstance(data.get("vm"), str) else None
        if name == "host-reboot":
            with self.lock:
                before, self.reboot = self.reboot, data
            if data.get("needed") is True and (before or {}).get("needed") is not True:
                notify("host-reboot", "warning", "Updates need a Host reboot (the disk passphrase must be "
                       "entered at boot)", packages=data.get("packages") or [])
        elif name == "services":
            with self.lock:
                self.services = data.get("units")
        elif name == "alert":
            signals = ", ".join(str(s) for s in data.get("signals") or [])
            notify("alert", "critical", f"{vm} tried to reach {data.get('domain')}"
                   + (f" ({signals})" if signals else ""), vm=vm, domain=data.get("domain"),
                   signals=data.get("signals") or [])
        elif name == "github-token" and data.get("action") == "refused":
            notify("github-refused", "warning", f"{vm}: GitHub token refused for {data.get('request') or '?'}",
                   vm=vm, request=data.get("request"), detail=data.get("reason"))
        elif name == "build" and data.get("status") in ("failed", "rejected"):
            what = f"Build {data.get('image')}-{data.get('build')}"
            text = f"{what} rejected: a safeguard is missing or weakened" if data["status"] == "rejected" \
                else f"{what} failed; the previous Build stays in use"
            notify(f"build-{data['status']}", "critical" if data["status"] == "rejected" else "warning", text,
                   image=data.get("image"), build=data.get("build"), detail=data.get("error"))


