def query_value(url, key):
    try:
        values = parse_qs(url.query, max_num_fields=8).get(key, [])
    except ValueError:
        raise ApiError(400, "invalid_query", "Too many query parameters")
    if len(values) > 1:
        raise ApiError(400, "invalid_query", "Each query parameter may appear once", field=key)
    return values[0] if values else None


