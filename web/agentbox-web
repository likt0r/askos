    token = h.session()
    with lock:
        expires = sessions.get(token)
    return 200, {"authenticated": True, "expires": iso(expires) if expires else None,
                 "default_language": setting("default_language")}


@route("POST", "/session", secret=("password",), public=True)
def post_session(h, m, url, body):
    password = body.get("password")
    if not isinstance(password, str):
        raise invalid("password", "password is missing")
    result, v = h.attempt_login(password)
    if result == "locked":
        raise ApiError(429, "too_many_attempts", "Too many failed sign-ins, try again later",
                       headers=[("Retry-After", str(v))])
    if result == "wrong":
        raise ApiError(401, "wrong_password", "Wrong password")
    token = v.split(";")[0].partition("=")[2]
    with lock:
        expires = sessions.get(token)
    return 200, {"authenticated": True, "expires": iso(expires) if expires else None,
                 "default_language": setting("default_language")}, [("Set-Cookie", v)]


